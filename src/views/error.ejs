<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Prompt Maestro</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-50 min-h-screen flex flex-col items-center justify-center p-4">
    <div class="max-w-md w-full bg-white p-8 rounded-lg shadow-md border border-gray-200 text-center">
        <h1 class="text-6xl font-bold text-red-500"><%= statusCode %></h1>
        <h2 class="text-2xl font-bold mt-4 text-gray-800"><%= title %></h2>
        <p class="text-gray-600 mt-2"><%= message %></p>
        <div class="mt-6">
            <a href="/" class="inline-block bg-blue-600 text-white px-6 py-2 rounded-md font-semibold hover:bg-blue-700">Ir al Inicio</a>
        </div>
    </div>
</body>
</html>
