<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - AviPeru</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Space+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <style>
        html, body {
            background-color: #080E1E !important;
            color: #F8FAFC !important;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
        }
    </style>
</head>
<body class="bg-[#080E1E] min-h-screen flex flex-col items-center justify-center p-4 relative overflow-hidden" style="background-color: #080E1E !important;">
    <div class="absolute w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full bg-[#0C152E]/95 p-8 sm:p-10 rounded-3xl shadow-2xl border border-cyan-500/30 text-center relative z-10 glow-cyan space-y-4">
        <h1 class="text-6xl font-black text-cyan-400 font-display tracking-tight"><%= statusCode %></h1>
        <h2 class="text-xl font-bold text-white font-display"><%= title %></h2>
        <p class="text-sm text-slate-400 leading-relaxed"><%= message %></p>
        <div class="pt-4">
            <a href="/" class="inline-block bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 text-slate-950 px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-500/20 transition transform hover:scale-105">
                Ir al Inicio
            </a>
        </div>
    </div>
</body>
</html>
