<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-x-8 lg:items-start">
        
        <!-- Galería de Fotos (Máx 2) -->
        <div class="flex flex-col">
            <div class="w-full aspect-w-1 aspect-h-1 bg-gray-100 rounded-lg overflow-hidden border">
                <% if (ave.imagenes && ave.imagenes.length > 0) { %>
                    <img src="<%= ave.imagenes[0].url %>" id="principalImg" alt="Foto Principal" class="w-full h-96 object-center object-cover">
                <% } else { %>
                    <div class="w-full h-96 flex items-center justify-center text-gray-300 text-7xl bg-gray-50">🦜</div>
                <% } %>
            </div>
            <% if (ave.imagenes && ave.imagenes.length > 1) { %>
                <div class="mt-4 grid grid-cols-4 gap-4">
                    <% ave.imagenes.forEach(img => { %>
                        <button onclick="cambiarFoto('<%= img.url %>')" class="relative h-20 bg-white rounded-md overflow-hidden border hover:opacity-85 focus:outline-none">
                            <img src="<%= img.url %>" class="w-full h-full object-center object-cover">
                        </button>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Ficha técnica pública del ave -->
        <div class="mt-10 px-4 sm:px-0 sm:mt-16 lg:mt-0">
            <div class="flex justify-between items-center border-b pb-4">
                <h1 class="text-3xl font-extrabold tracking-tight text-gray-900"><%= ave.identificador_interno %></h1>
                <% if (ave.estado_comercial === 'EN_VENTA') { %>
                    <span class="text-3xl font-bold text-blue-600">S/. <%= ave.precio_venta %></span>
                <% } %>
            </div>

            <div class="mt-6 space-y-6 text-sm text-gray-700">
                <h3 class="font-bold text-gray-900">Ficha del Exemplar</h3>
                <div class="grid grid-cols-2 gap-4 bg-white p-4 rounded-lg border border-gray-150">
                    <div><strong class="text-gray-500">Número de Anilla:</strong></div>
                    <div class="font-semibold text-gray-900"><%= ave.anilla || 'Sin anilla' %></div>
                    
                    <div><strong class="text-gray-500">Sexo:</strong></div>
                    <div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase <%= ave.sexo === 'M' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800' %>">
                            <%= ave.sexo === 'M' ? 'Macho' : 'Hembra' %>
                        </span>
                    </div>

                    <div><strong class="text-gray-500">Especie:</strong></div>
                    <div class="font-semibold text-gray-900"><%= ave.especie_nombre %></div>

                    <div><strong class="text-gray-500">Fecha de Nacimiento:</strong></div>
                    <div class="font-semibold text-gray-900"><%= new Date(ave.fecha_nacimiento).toLocaleDateString('es') %></div>
                </div>

                <!-- Genética / Mutaciones -->
                <div>
                    <h4 class="font-bold text-gray-900 mb-2">Composición Genética</h4>
                    <% if (ave.mutaciones && ave.mutaciones.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                            <% ave.mutaciones.forEach(m => { %>
                                <span class="px-3 py-1 rounded bg-gray-100 text-xs font-semibold text-gray-700 uppercase" title="Tipo: <%= m.tipo %>">
                                    <%= m.nombre %> (<%= m.tipo %>)
                                </span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-gray-400 italic">No se han registrado mutaciones fenotípicas/genotípicas.</p>
                    <% } %>
                </div>

                <!-- Descripción comercial pública -->
                <% if (ave.observaciones_comerciales) { %>
                    <div class="mt-4 pt-4 border-t">
                        <h4 class="font-bold text-gray-900 mb-2">Notas del Criador</h4>
                        <p class="text-gray-600 leading-relaxed italic">"<%= ave.observaciones_comerciales %>"</p>
                    </div>
                <% } %>

                <!-- Botón de compra / Carrito -->
                <div class="mt-10 pt-6 border-t">
                    <% if (ave.estado_comercial === 'EN_VENTA') { %>
                        <% if (user) { %>
                            <button onclick="agregarAlCarrito(<%= ave.id %>)" class="w-full bg-blue-600 text-white py-3 px-8 rounded-md font-bold text-base hover:bg-blue-700 focus:outline-none">
                                Reservar y Añadir al Carrito
                            </button>
                        <% } else { %>
                            <a href="/login" class="w-full flex items-center justify-center bg-gray-200 text-gray-700 py-3 px-8 rounded-md font-bold text-base hover:bg-gray-300">
                                Inicie sesión para comprar
                            </a>
                        <% } %>
                    <% } else if (ave.estado_comercial === 'RESERVADA') { %>
                        <button disabled class="w-full bg-gray-300 text-gray-500 py-3 px-8 rounded-md font-bold text-base cursor-not-allowed">
                            Ejemplar Reservado Temporalmente
                        </button>
                    <% } else { %>
                        <button disabled class="w-full bg-gray-150 text-gray-400 py-3 px-8 rounded-md font-bold text-base cursor-not-allowed">
                            Este ejemplar no se encuentra disponible para venta
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function cambiarFoto(url) {
        document.getElementById('principalImg').src = url;
    }

    async function agregarAlCarrito(id) {
        try {
            const response = await fetch('/carrito/agregar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ aveId: id })
            });
            const res = await response.json();
            if (res.success) {
                alert(res.message);
                window.location.href = '/checkout';
            } else {
                alert('No se pudo agregar: ' + res.error);
            }
        } catch(e) {
            alert('Error en conexión al carrito.');
        }
    }
</script>
<%- include('../partials/footer') %>
