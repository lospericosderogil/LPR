<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">
        
        <!-- Galería de Fotos (Máx 2) -->
        <div class="flex flex-col space-y-4">
            <div class="w-full aspect-w-1 aspect-h-1 bg-[#070D1E] rounded-3xl overflow-hidden border border-cyan-500/30 shadow-2xl relative group">
                <% if (ave.imagenes && ave.imagenes.length > 0) { %>
                    <img src="<%= ave.imagenes[0].url %>" id="principalImg" alt="Foto Principal" class="w-full h-96 sm:h-[480px] object-center object-cover">
                <% } else { %>
                    <div class="w-full h-96 sm:h-[480px] flex flex-col items-center justify-center text-slate-600 text-7xl bg-[#070D1E] space-y-3">
                        <span>🦜</span>
                        <span class="text-xs text-slate-500 font-bold uppercase tracking-widest">Fotografía Oficial en Proceso</span>
                    </div>
                <% } %>
                <!-- Badge Especie Flotante -->
                <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-[#080E1E]/90 text-cyan-300 border border-cyan-500/30 backdrop-blur-md">
                        <%= ave.especie_nombre %>
                    </span>
                </div>
            </div>
            <% if (ave.imagenes && ave.imagenes.length > 1) { %>
                <div class="grid grid-cols-4 gap-4">
                    <% ave.imagenes.forEach(img => { %>
                        <button onclick="cambiarFoto('<%= img.url %>')" class="relative h-20 bg-[#070D1E] rounded-2xl overflow-hidden border border-slate-800 hover:border-cyan-400 focus:border-cyan-400 transition focus:outline-none">
                            <img src="<%= img.url %>" class="w-full h-full object-center object-cover">
                        </button>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Ficha técnica pública del ave -->
        <div class="mt-10 px-4 sm:px-0 sm:mt-16 lg:mt-0 space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-800 pb-6 gap-4">
                <div>
                    <span class="text-xs font-bold text-cyan-400 tracking-widest uppercase block mb-1">Ficha Biológica Oficial</span>
                    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-display"><%= ave.anilla || ('Ejemplar #' + ave.id) %></h1>
                </div>
                <div>
                    <% if (ave.estado_biologico === 'EN_VENTA' && ave.estado_comercial !== 'RESERVADA') { %>
                        <div class="text-right">
                            <span class="text-[10px] text-slate-400 uppercase block font-semibold">Inversión</span>
                            <span class="text-3xl font-black text-cyan-300 font-display glow-cyan-sm">S/. <%= parseFloat(ave.precio_venta || 0).toFixed(2) %></span>
                        </div>
                    <% } else if (ave.estado_biologico === 'VENDIDO') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-purple-950/80 text-purple-300 border border-purple-500/30">
                            ✓ Ejemplar Vendido
                        </span>
                    <% } else if (ave.estado_biologico === 'INTERCAMBIADO') { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-950/80 text-amber-300 border border-amber-500/30">
                            Ejemplar Intercambiado
                        </span>
                    <% } else { %>
                        <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-bold bg-blue-950/80 text-blue-300 border border-blue-500/30">
                            Solo Exhibición
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- Ficha Técnica Bento Card -->
            <div class="bg-[#0C152E]/90 rounded-3xl p-6 sm:p-7 border border-cyan-500/25 shadow-xl space-y-6">
                <h3 class="text-base font-bold text-white font-display flex items-center gap-2">
                    <span class="text-cyan-400">📋</span>
                    <span>Especificaciones del Ejemplar</span>
                </h3>

                <div class="grid grid-cols-2 gap-4 text-xs">
                    <div class="bg-[#070D1E] p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold text-cyan-400 uppercase block mb-1">Número de Anilla</span>
                        <span class="font-mono text-sm font-bold text-white"><%= ave.anilla || 'Sin anilla registrada' %></span>
                    </div>

                    <div class="bg-[#070D1E] p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold text-cyan-400 uppercase block mb-1">Sexo Biológico</span>
                        <span class="text-sm font-bold text-white flex items-center gap-1.5">
                            <%= ave.sexo === 'M' ? '♂ Macho' : (ave.sexo === 'F' ? '♀ Hembra' : 'Indeterminado') %>
                        </span>
                    </div>

                    <div class="bg-[#070D1E] p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold text-cyan-400 uppercase block mb-1">Especie</span>
                        <span class="text-sm font-bold text-white"><%= ave.especie_nombre %></span>
                    </div>

                    <div class="bg-[#070D1E] p-3.5 rounded-2xl border border-slate-800">
                        <span class="text-[10px] font-bold text-cyan-400 uppercase block mb-1">Nacimiento</span>
                        <span class="text-sm font-bold text-white"><%= ave.fecha_nacimiento ? new Date(ave.fecha_nacimiento).toLocaleDateString('es') : 'Registro verificado' %></span>
                    </div>
                </div>

                <!-- Genética / Mutaciones -->
                <div>
                    <span class="text-[10px] font-bold text-cyan-400 uppercase tracking-wider block mb-2">Composición Genética</span>
                    <% if (ave.mutaciones && ave.mutaciones.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                            <% ave.mutaciones.forEach(m => { %>
                                <span class="px-3 py-1 rounded-xl bg-cyan-950/80 text-xs font-bold text-cyan-300 border border-cyan-500/30" title="Tipo: <%= m.tipo %>">
                                    <%= m.nombre %> (<%= m.tipo %>)
                                </span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-xs text-slate-500 italic">Línea Clásica / Ancestral.</p>
                    <% } %>
                </div>

                <!-- Notas del Criador -->
                <% if (ave.observaciones_comerciales) { %>
                    <div class="pt-4 border-t border-slate-800/80">
                        <span class="text-[10px] font-bold text-cyan-400 uppercase tracking-wider block mb-1.5">Notas del Criador</span>
                        <p class="text-xs text-slate-300 leading-relaxed italic bg-[#070D1E] p-3.5 rounded-2xl border border-slate-800">
                            "<%= ave.observaciones_comerciales %>"
                        </p>
                    </div>
                <% } %>
            </div>

            <!-- Botón de compra / Carrito -->
            <div class="pt-4">
                <% if (ave.estado_biologico === 'EN_VENTA' && ave.estado_comercial !== 'RESERVADA') { %>
                    <% if (user) { %>
                        <button onclick="agregarAlCarrito(<%= ave.id %>)" class="w-full py-4 px-8 rounded-2xl bg-gradient-to-r from-cyan-400 via-teal-400 to-cyan-500 hover:from-cyan-300 hover:to-teal-300 text-slate-950 font-extrabold text-base uppercase tracking-wider shadow-lg shadow-cyan-500/30 transition transform hover:scale-[1.02] flex items-center justify-center gap-3">
                            <span>⏱️</span>
                            <span>Reservar y Añadir al Carrito (10 min)</span>
                        </button>
                    <% } else { %>
                        <a href="/login" class="w-full flex items-center justify-center py-4 px-8 rounded-2xl bg-[#0C152E] text-cyan-300 border border-cyan-500/40 font-bold text-base hover:bg-slate-900 transition">
                            Inicia sesión para reservar este ejemplar
                        </a>
                    <% } %>
                <% } else if (ave.estado_comercial === 'RESERVADA') { %>
                    <button disabled class="w-full bg-slate-800 text-slate-500 py-4 px-8 rounded-2xl font-bold text-base cursor-not-allowed border border-slate-700">
                        ⏰ Ejemplar Reservado Temporalmente
                    </button>
                <% } else if (ave.estado_biologico === 'VENDIDO') { %>
                    <div class="text-center p-4 bg-purple-950/60 rounded-2xl border border-purple-500/30 text-purple-300">
                        <p class="text-sm font-bold">✓ Este ejemplar fue transferido/vendido</p>
                        <p class="text-xs text-purple-400 mt-1">Permanece visible en el catálogo de exhibición durante 10 días.</p>
                    </div>
                <% } else { %>
                    <div class="text-center p-4 bg-[#0C152E] rounded-2xl border border-slate-800 text-slate-400">
                        <p class="text-sm font-semibold text-white">Ejemplar en Exhibición del Criadero</p>
                        <p class="text-xs text-slate-500 mt-1">Forma parte del plantel genético de reproductores y no está a la venta.</p>
                    </div>
                <% } %>
            </div>

        </div>

    </div>
</div>

<script>
    function cambiarFoto(url) {
        document.getElementById('principalImg').src = url;
    }

    async function agregarAlCarrito(id) {
        try {
            const response = await fetch('/carrito/agregar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ aveId: id })
            });
            const res = await response.json();
            if (res.success) {
                alert(res.message);
                window.location.href = '/checkout';
            } else {
                alert('No se pudo agregar: ' + res.error);
            }
        } catch(e) {
            alert('Error en conexión al carrito.');
        }
    }
</script>
<%- include('../partials/footer') %>
