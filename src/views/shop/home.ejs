<%- include('../partials/header') %>

<div class="space-y-12 pb-20 overflow-hidden">

    <!-- 1. HERO SECTION & SMART MATCHMAKER (PORTADA PRINCIPAL FOCALIZADA) -->
    <section class="relative pt-12 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <!-- Resplandor ambiental de fondo en Turquesa & Zafiro -->
        <div class="absolute -top-24 left-1/2 transform -translate-x-1/2 w-full max-w-5xl h-96 bg-gradient-to-tr from-cyan-500/15 via-blue-600/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>

        <div class="relative z-10 text-center max-w-4xl mx-auto space-y-6">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-cyan-950/80 text-cyan-300 border border-cyan-500/30 uppercase tracking-widest glow-cyan-sm">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                <span>Plataforma Bio-Tech de Crianza & Trazabilidad Aviar 2026 - 2027</span>
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-tight font-display">
                Cuna de Ejemplares con <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-blue-400">
                    Genética Certificada & Pedigrí
                </span>
            </h1>

            <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
                Especialistas en la selección y crianza responsable de <strong class="text-white">Pericos Australianos</strong> e <strong class="text-white">Ingleses</strong> de postura. Garantía de pureza de mutaciones, 0% consanguinidad y trazabilidad genealógica digital inmutable.
            </p>

            <!-- SMART MATCHMAKER WIZARD BAR -->
            <div class="mt-10 p-2 sm:p-3 rounded-3xl bg-[#0E1838]/90 border border-cyan-500/30 shadow-2xl backdrop-filter backdrop-blur-xl max-w-4xl mx-auto">
                <form action="/catalogo" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 items-center">
                    <!-- Filtro Especie -->
                    <div class="bg-[#080E1E]/80 px-3.5 py-2.5 rounded-2xl border border-slate-800 focus-within:border-cyan-400 transition text-left">
                        <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-wider">Especie</label>
                        <select name="especie_id" class="w-full bg-transparent text-sm font-semibold text-white focus:outline-none cursor-pointer">
                            <option value="" class="bg-[#080E1E] text-white">Todas las especies</option>
                            <% if (locals.especies && especies.length > 0) { %>
                                <% especies.forEach(e => { %>
                                    <option value="<%= e.id %>" class="bg-[#080E1E] text-white"><%= e.nombre %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="1" class="bg-[#080E1E] text-white">Perico Australiano</option>
                                <option value="2" class="bg-[#080E1E] text-white">Perico Inglés</option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Filtro Sexo -->
                    <div class="bg-[#080E1E]/80 px-3.5 py-2.5 rounded-2xl border border-slate-800 focus-within:border-cyan-400 transition text-left">
                        <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-wider">Sexo</label>
                        <select name="sexo" class="w-full bg-transparent text-sm font-semibold text-white focus:outline-none cursor-pointer">
                            <option value="" class="bg-[#080E1E] text-white">Cualquier sexo</option>
                            <option value="M" class="bg-[#080E1E] text-white">♂ Macho</option>
                            <option value="F" class="bg-[#080E1E] text-white">♀ Hembra</option>
                        </select>
                    </div>

                    <!-- Filtro Mutación -->
                    <div class="bg-[#080E1E]/80 px-3.5 py-2.5 rounded-2xl border border-slate-800 focus-within:border-cyan-400 transition text-left">
                        <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-wider">Mutación</label>
                        <select name="search" class="w-full bg-transparent text-sm font-semibold text-white focus:outline-none cursor-pointer">
                            <option value="" class="bg-[#080E1E] text-white">Cualquier mutación</option>
                            <% if (locals.mutaciones && mutaciones.length > 0) { %>
                                <% mutaciones.forEach(m => { %>
                                    <option value="<%= m.nombre %>" class="bg-[#080E1E] text-white"><%= m.nombre %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Arcoíris" class="bg-[#080E1E] text-white">Arcoíris</option>
                                <option value="Flavo" class="bg-[#080E1E] text-white">Flavo</option>
                                <option value="Lutino" class="bg-[#080E1E] text-white">Lutino</option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Filtro Propósito -->
                    <div class="bg-[#080E1E]/80 px-3.5 py-2.5 rounded-2xl border border-slate-800 focus-within:border-cyan-400 transition text-left">
                        <label class="block text-[10px] font-bold text-cyan-400 uppercase tracking-wider">Propósito</label>
                        <select class="w-full bg-transparent text-sm font-semibold text-white focus:outline-none cursor-pointer">
                            <option value="all" class="bg-[#080E1E] text-white">Mascota de Compañía</option>
                            <option value="cria" class="bg-[#080E1E] text-white">Pie de Cría / Genética</option>
                            <option value="show" class="bg-[#080E1E] text-white">Exhibición & Concurso</option>
                        </select>
                    </div>

                    <!-- Botón Buscar en Turquesa Neón -->
                    <button type="submit" class="w-full h-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-cyan-400 via-teal-400 to-cyan-500 hover:from-cyan-300 hover:to-teal-300 text-slate-950 font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-cyan-500/30 transition duration-200 transform hover:scale-[1.02] flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <span>Buscar</span>
                    </button>
                </form>
            </div>

            <!-- Badges de Garantía en Vivo -->
            <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 pt-4 text-xs font-semibold text-slate-400">
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-cyan-400"></span> 100% Pedigrí Digitalizado</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-cyan-400"></span> Reserva Blindada de 10 min</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-cyan-400"></span> Envíos Sanitarios Seguros</span>
            </div>
        </div>
    </section>

</div>

<%- include('../partials/footer') %>
