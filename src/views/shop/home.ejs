<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16">
    
    <!-- 1. HERO SECTION -->
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-blue-900 via-indigo-900 to-blue-800 text-white shadow-2xl">
        <!-- Decoración de Fondo (SVG Abstracto) -->
        <div class="absolute inset-0 opacity-10 pointer-events-none">
            <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" fill="none" viewBox="0 0 800 400">
                <defs>
                    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1"/>
                    </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#grid)" />
            </svg>
        </div>
        
        <div class="relative z-10 px-6 py-12 sm:px-12 sm:py-20 md:py-24 max-w-4xl">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-500 bg-opacity-20 text-blue-300 border border-blue-400 border-opacity-30 mb-6 uppercase tracking-widest">
                🔬 Genética & Crianza Selectiva
            </span>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-tight">
                Cuna de Ejemplares con <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-teal-300">
                    Genética Certificada
                </span>
            </h1>
            <p class="mt-6 text-base sm:text-lg text-gray-200 max-w-2xl leading-relaxed">
                Especialistas en la crianza selectiva de Pericos Australianos e Ingleses. Garantizamos la trazabilidad genealógica y pureza de mutaciones exclusivas en cada uno de nuestros ejemplares.
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
                <a href="/catalogo" class="px-6 py-3 border border-transparent text-base font-semibold rounded-xl text-blue-900 bg-teal-400 hover:bg-teal-300 shadow-md hover:shadow-lg transition duration-200 transform hover:-translate-y-0.5">
                    Ver Catálogo Comercial
                </a>
                <% if (!user) { %>
                    <a href="/register" class="px-6 py-3 border border-gray-400 border-opacity-40 text-base font-semibold rounded-xl text-white bg-white bg-opacity-10 hover:bg-opacity-20 transition duration-200">
                        Registrarse gratis
                    </a>
                <% } else { %>
                    <a href="/checkout" class="px-6 py-3 border border-gray-400 border-opacity-40 text-base font-semibold rounded-xl text-white bg-white bg-opacity-10 hover:bg-opacity-20 transition duration-200 flex items-center gap-2">
                        <span>🛒 Ver mi Carrito</span>
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- 2. PILARES DE EXCELENCIA -->
    <div class="space-y-8">
        <div class="text-center max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-gray-900 tracking-tight sm:text-4xl">Nuestro Compromiso Profesional</h2>
            <p class="mt-3 text-lg text-gray-500">
                Diseñamos una plataforma integral enfocada en la excelencia biológica y la transparencia comercial.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            <!-- Pilar 1: Garantía Genética -->
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Genética Garantizada</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Control exhaustivo de mutaciones fenotípicas y genotípicas. Sabrás exactamente qué genes porta cada ejemplar.
                    </p>
                </div>
            </div>

            <!-- Pilar 2: Trazabilidad -->
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Pedigrí y Linaje</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Consulta de manera digital el árbol genealógico completo de cada ave para planificar cruces óptimos y evitar consanguinidad.
                    </p>
                </div>
            </div>

            <!-- Pilar 3: Bienestar -->
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center text-green-600 mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Sanidad Controlada</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Ejemplares criados bajo un estricto protocolo de bioseguridad, alimentación de alta gama y supervisión veterinaria periódica.
                    </p>
                </div>
            </div>

            <!-- Pilar 4: Reservas en Línea -->
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
                <div>
                    <div class="w-12 h-12 rounded-xl bg-yellow-50 flex items-center justify-center text-yellow-600 mb-5">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Reserva Segura</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">
                        Nuestro carrito te reserva de forma exclusiva el ave elegida por 10 minutos para que concretes tu pago con total tranquilidad.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. LÍNEAS DE CRIANZA (ESPECIES) -->
    <div class="space-y-8">
        <div class="border-l-4 border-blue-600 pl-4">
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight sm:text-3xl">Nuestras Líneas de Crianza</h2>
            <p class="text-sm text-gray-500 mt-1">Especies principales y estándares criados en nuestras instalaciones.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Especie 1: Pericos Ingleses -->
            <div class="group relative rounded-2xl border border-gray-200 overflow-hidden bg-white shadow-sm hover:shadow-md transition duration-200 flex flex-col sm:flex-row">
                <div class="sm:w-1/3 h-48 sm:h-auto bg-blue-50 flex items-center justify-center text-5xl">
                    🇬🇧🦜
                </div>
                <div class="p-6 sm:w-2/3 flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Perico Inglés (Standard)</h3>
                        <p class="text-sm text-gray-500 leading-relaxed mb-4">
                            Ejemplares seleccionados por su excelente postura, gran porte, frente pronunciada y características físicas aptas para exhibición y concursos.
                        </p>
                    </div>
                    <div>
                        <a href="/catalogo?especie_id=2" class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800">
                            Ver ejemplares ingleses &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <!-- Especie 2: Pericos Australianos -->
            <div class="group relative rounded-2xl border border-gray-200 overflow-hidden bg-white shadow-sm hover:shadow-md transition duration-200 flex flex-col sm:flex-row">
                <div class="sm:w-1/3 h-48 sm:h-auto bg-green-50 flex items-center justify-center text-5xl">
                    🇦🇺🦜
                </div>
                <div class="p-6 sm:w-2/3 flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Perico Australiano</h3>
                        <p class="text-sm text-gray-500 leading-relaxed mb-4">
                            Líneas enfocadas en la belleza, dinamismo y la consecución de mutaciones complejas (arcos, flavos, albinos y lutinos) con altos estándares genéticos.
                        </p>
                    </div>
                    <div>
                        <a href="/catalogo?especie_id=1" class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800">
                            Ver ejemplares australianos &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. DYNAMIC SHOWCASE (EJEMPLARES DESTACADOS) -->
    <div class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-5">
            <div>
                <h2 class="text-2xl font-bold text-gray-900 tracking-tight sm:text-3xl">Últimos Ejemplares Añadidos</h2>
                <p class="text-sm text-gray-500 mt-1">Aves publicadas recientemente de nuestras mejores parejas.</p>
            </div>
            <div class="mt-4 sm:mt-0">
                <a href="/catalogo" class="text-sm font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1">
                    Ver todos los ejemplares
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Grid de Ejemplares -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            <% if (!locals.aves || aves.length === 0) { %>
                <div class="col-span-full bg-white rounded-2xl p-10 text-center border border-dashed border-gray-300 text-gray-500 space-y-3">
                    <div class="text-4xl text-gray-400">🧬</div>
                    <h3 class="text-lg font-bold text-gray-800">Nuevas Aves en Preparación</h3>
                    <p class="text-sm text-gray-500 max-w-md mx-auto">
                        Actualmente todos nuestros ejemplares destacados están en periodo de anillamiento y cuarentena. ¡Revisa el catálogo general para ver el historial y otros ejemplares!
                    </p>
                    <a href="/catalogo" class="mt-4 inline-block bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700">
                        Explorar Catálogo Histórico
                    </a>
                </div>
            <% } else { %>
                <% aves.forEach(a => { %>
                    <div class="group relative bg-white border border-gray-200 rounded-2xl overflow-hidden flex flex-col justify-between shadow-sm hover:shadow-md transition duration-200">
                        <!-- Contenedor de Imagen -->
                        <div class="relative w-full h-64 bg-gray-50 overflow-hidden flex items-center justify-center border-b border-gray-150">
                            <% if (a.imagenes && a.imagenes.length > 0) { %>
                                <img src="<%= a.imagenes[0].url %>" alt="Ave <%= a.anilla || a.id %>" class="w-full h-full object-cover group-hover:scale-102 transition duration-300">
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center text-gray-300 bg-gray-100 space-y-2">
                                    <span class="text-5xl">🦜</span>
                                    <span class="text-xs text-gray-400 font-semibold uppercase">Sin fotografía</span>
                                </div>
                            <% } %>
                            
                            <!-- Badge Especie en Imagen (Izquierda) -->
                            <div class="absolute top-3 left-3 z-10">
                                <span class="px-2 py-0.5 rounded-full text-3xs font-extrabold capitalize tracking-wide bg-white text-gray-800 shadow-sm border border-gray-150">
                                    <%= a.especie_nombre %>
                                </span>
                            </div>

                            <!-- Ícono del sexo en la esquina superior derecha -->
                            <% if (a.sexo === 'M' || a.sexo === 'F') { %>
                                <div class="absolute top-2.5 right-2.5 z-10 pointer-events-none">
                                    <img src="<%= a.sexo === 'M' ? '/img/sexo-macho.png' : '/img/sexo-hembra.png' %>" 
                                         alt="<%= a.sexo === 'M' ? 'Macho' : 'Hembra' %>" 
                                         title="<%= a.sexo === 'M' ? 'Macho' : 'Hembra' %>" 
                                         class="w-7 h-auto drop-shadow-md">
                                </div>
                            <% } %>
                        </div>

                        <!-- Detalles -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-2">
                                    <h3 class="text-base font-bold text-gray-800 tracking-tight">
                                        <a href="/catalogo/<%= a.id %>">
                                            <span aria-hidden="true" class="absolute inset-0"></span>
                                            <%= a.anilla || ('Ave #' + a.id) %>
                                        </a>
                                    </h3>
                                </div>

                                <!-- Mutaciones -->
                                <% if (a.mutaciones && a.mutaciones.length > 0) { %>
                                    <div class="flex flex-wrap gap-1 mt-3">
                                        <% a.mutaciones.forEach(m => { %>
                                            <span class="px-2 py-0.5 rounded-md bg-gray-100 text-3xs font-semibold text-gray-600 capitalize border border-gray-200"><%= m.nombre %></span>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="mt-3 text-3xs text-gray-400 italic">Mutación: Clásico/Ancestral</div>
                                <% } %>
                            </div>

                            <!-- Estado Comercial -->
                            <div class="mt-6 pt-4 border-t border-gray-150 flex justify-between items-center">
                                <% if (a.estado_biologico === 'EN_VENTA' && a.estado_comercial !== 'RESERVADA') { %>
                                    <div>
                                        <span class="text-xs text-gray-400 block font-medium">Precio</span>
                                        <span class="text-xl font-black text-blue-600">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                    </div>
                                    <span class="text-xs font-bold text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full shadow-3xs">
                                        ● En Venta
                                    </span>
                                <% } else if (a.estado_comercial === 'RESERVADA') { %>
                                    <div>
                                        <span class="text-xs text-gray-400 block font-medium">Precio</span>
                                        <span class="text-xl font-bold text-gray-400">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                    </div>
                                    <span class="text-xs font-bold text-yellow-700 bg-yellow-50 border border-yellow-200 px-2.5 py-1 rounded-full">
                                        ⏰ Reservado
                                    </span>
                                <% } else if (a.estado_biologico === 'VENDIDO') { %>
                                    <div>
                                        <span class="text-xs text-gray-400 block font-medium">Precio</span>
                                        <span class="text-sm font-bold text-gray-400 line-through"><%= a.precio_venta ? 'S/. ' + parseFloat(a.precio_venta).toFixed(2) : 'Vendido' %></span>
                                    </div>
                                    <span class="text-xs font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2.5 py-1 rounded-full">
                                        ✓ Vendido
                                    </span>
                                <% } else if (a.estado_biologico === 'INTERCAMBIADO') { %>
                                    <span class="text-xs text-gray-500 italic">Intercambiado</span>
                                    <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                                        Intercambiado
                                    </span>
                                <% } else { %>
                                    <span class="text-xs text-gray-500 italic">Criadero LPR</span>
                                    <span class="text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-full">
                                        Solo Exhibición
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <!-- 5. MÉTRICAS E INDICADORES DE CONFIANZA -->
    <div class="bg-gray-100 rounded-3xl p-8 sm:p-12 border border-gray-200">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
            <div class="space-y-1">
                <span class="text-4xl sm:text-5xl font-black text-blue-700 block">8+</span>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block">Mutaciones Genéticas</span>
                <span class="text-3xs text-gray-400 block">Lutino, Albino, Flavo, Opalinos, etc.</span>
            </div>
            <div class="space-y-1">
                <span class="text-4xl sm:text-5xl font-black text-blue-700 block">100%</span>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block">Trazabilidad de Linajes</span>
                <span class="text-3xs text-gray-400 block">Pedigríes digitalizados en BD</span>
            </div>
            <div class="space-y-1">
                <span class="text-4xl sm:text-5xl font-black text-blue-700 block">4</span>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block">Generaciones de Registro</span>
                <span class="text-3xs text-gray-400 block">Prevención de consanguinidad</span>
            </div>
            <div class="space-y-1">
                <span class="text-4xl sm:text-5xl font-black text-blue-700 block">Seguro</span>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block">Reserva Garantizada</span>
                <span class="text-3xs text-gray-400 block">Bloqueo temporal de aves</span>
            </div>
        </div>
    </div>

    <!-- 6. LLAMADO A LA ACCIÓN FINAL -->
    <div class="rounded-3xl bg-blue-50 border border-blue-100 p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl text-center md:text-left">
            <h3 class="text-2xl font-bold text-gray-900 tracking-tight sm:text-3xl">¿Quieres planificar tus parejas de cría?</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                Regístrate hoy para acceder a las fichas completas, ver las genealogías interactivas de nuestros campeones y realizar reservas automáticas por 10 minutos.
            </p>
        </div>
        <div class="flex flex-wrap justify-center gap-4">
            <% if (!user) { %>
                <a href="/login" class="px-6 py-3 border border-transparent text-sm font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition">
                    Iniciar Sesión
                </a>
                <a href="/register" class="px-6 py-3 border border-gray-200 text-sm font-semibold rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-3xs transition">
                    Crear Cuenta
                </a>
            <% } else { %>
                <a href="/catalogo" class="px-6 py-3 border border-transparent text-sm font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition">
                    Ver Catálogo Comercial
                </a>
            <% } %>
        </div>
    </div>

</div>

<%- include('../partials/footer') %>
