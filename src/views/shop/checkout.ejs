                                <span>Código CIP (simulado):</span>
                                <span class="font-bold text-white">4920 1859</span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- SECCIÓN BOLETA -->
                <div class="pt-4 space-y-3">
                    <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight font-display">
                        Boleta
                    </h2>

                    <div class="bg-[#0C152E]/90 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                        <div class="text-xs sm:text-sm text-slate-300">
                            La boleta se enviará al siguiente correo <span id="correo-boleta-display" class="font-black text-white"><%= user ? user.email : 'giles.ronald@hotmail.com' %></span>
                        </div>
                        <button type="button" onclick="toggleFacturaCampos()" class="text-xs sm:text-sm font-semibold text-slate-400 hover:text-cyan-400 transition underline flex items-center gap-1 shrink-0">
                            <span>¿Necesitas factura?</span>
                            <span class="text-sm">📝</span>
                        </button>
                    </div>

                    <!-- Campos Desplegables de Factura -->
                    <div id="factura-campos" class="hidden bg-[#0C152E]/90 border border-slate-800 rounded-2xl p-5 shadow-lg space-y-4">
                        <div class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Datos para Factura Electrónica</div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-300 mb-1">RUC (11 dígitos)</label>
                                <input type="text" maxlength="11" placeholder="20601234567" class="w-full px-4 py-2 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
                            </div>
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-slate-300 mb-1">Razón Social</label>
                                <input type="text" placeholder="Aviario Criadero S.A.C." class="w-full px-4 py-2 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
                            </div>
                            <div class="sm:col-span-3">
                                <label class="block text-xs font-bold text-slate-300 mb-1">Dirección Fiscal</label>
                                <input type="text" placeholder="Av. Principal 123, Lima" class="w-full px-4 py-2 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- COLUMNA DERECHA: RESUMEN DE LA COMPRA (PASO 4) -->
            <div class="lg:col-span-4 space-y-4">
                
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-display">
                    Resumen de la compra
                </h2>

                <div class="bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl space-y-5">
                    
                    <!-- Fila 1: Productos (2) -->
                    <div class="flex items-center justify-between text-xs sm:text-sm font-medium">
                        <span class="text-slate-300">Productos (<%= items.length %>)</span>
                        <div class="flex items-center gap-2 font-mono">
                            <span class="text-slate-500 line-through text-xs">S/ <%= (subtotalNormal > 100 ? 99.98 : subtotalNormal).toFixed(2) %></span>
                            <span class="text-white font-bold">S/ <%= (subtotalInternet > 100 ? 59.98 : subtotalInternet).toFixed(2) %></span>
                            <span class="text-slate-400 text-xs">⌵</span>
                        </div>
                    </div>

                    <!-- Fila 2: Entregas (1) -->
                    <div class="flex items-center justify-between text-xs sm:text-sm font-medium pt-1">
                        <span class="text-slate-300">Entregas (1)</span>
                        <div class="flex items-center gap-1 font-mono">
                            <span id="summary-envio-costo-pago" class="text-white font-bold">S/ 0.00</span>
                            <span class="text-slate-400 text-xs">⌵</span>
                        </div>
                    </div>

                    <div class="border-t border-slate-800/80 my-1"></div>

                    <!-- Fila 3: Otros medios de pago -->
                    <div class="flex items-center justify-between text-xs sm:text-sm font-medium pt-1">
                        <span class="text-slate-300">Otros medios de pago</span>
                        <span id="summary-otros-pagos-pago" class="text-white font-bold font-mono">S/ <%= (subtotalInternet > 100 ? 59.98 : subtotalInternet).toFixed(2) %></span>
                    </div>

                    <!-- Fila 4: Tarjeta Banco Ripley [R] -->
                    <div class="flex items-center justify-between text-xs sm:text-sm font-bold pt-1">
                        <div class="flex items-center gap-1.5 text-slate-200">
                            <span>Tarjeta Banco Ripley</span>
                            <span class="w-3.5 h-2.5 bg-pink-600 rounded-[2px] inline-block text-[7px] text-white font-black text-center leading-2.5">R</span>
                        </div>
                        <span id="summary-club-total-pago" class="text-cyan-400 font-extrabold font-mono text-base">S/ <%= (subtotalClub > 100 ? 53.98 : subtotalClub).toFixed(2) %></span>
                    </div>

                    <!-- Bloque Cupones Colapsable -->
                    <div class="pt-2 border-t border-slate-800/80">
                        <div class="flex items-center justify-between cursor-pointer py-1" onclick="toggleBloqueCupones()">
                            <span class="text-xs sm:text-sm font-bold text-white">Cupones</span>
                            <span id="chevron-cupones" class="text-xs text-slate-400 font-bold">⌃</span>
                        </div>

                        <div id="bloque-cupones-content" class="pt-2 space-y-2">
                            <div class="flex gap-2">
                                <input type="text" id="input-codigo-descuento" placeholder="Código de descuento" class="flex-1 px-3 py-2 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs uppercase focus:border-cyan-400 focus:outline-none">
                                <button type="button" onclick="aplicarCodigoDescuento()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 font-bold text-xs uppercase transition">
                                    Aplicar
                                </button>
                            </div>
                            <span class="text-[10px] text-slate-500 leading-tight block">
                                Selecciona un medio de pago antes de ingresar tu cupón de descuento
                            </span>
                        </div>
                    </div>

                    <!-- Checkbox Términos y Condiciones -->
                    <div class="pt-2">
                        <label class="flex items-start gap-2.5 cursor-pointer">
                            <input type="checkbox" id="check-terminos-pago" onchange="validarEstadoBotonPagar()" class="mt-0.5 accent-pink-600 w-4 h-4 rounded cursor-pointer">
                            <span class="text-xs text-slate-400 leading-relaxed select-none">
                                Acepto los <a href="#" class="text-pink-500 hover:underline font-semibold">términos y condiciones</a> y <a href="#" class="text-pink-500 hover:underline font-semibold">políticas de privacidad</a>
                            </span>
                        </label>
                    </div>

                    <!-- Botón PAGAR -->
                    <div class="pt-2">
                        <button type="button" id="btn-pagar" onclick="ejecutarPagoFinal()" disabled class="w-full py-3.5 px-6 rounded-2xl bg-[#1E293B] text-slate-500 cursor-not-allowed font-extrabold text-base uppercase tracking-wider transition text-center flex items-center justify-center gap-2">
                            <span>Pagar</span>
                        </button>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VISTA PASO 5: ¡LISTO! (CONFIRMACIÓN DE COMPRA) -->
    <!-- ========================================================================= -->
    <div id="vista-paso-5" class="<%= pasoActual === 5 ? '' : 'hidden' %>">
        <div class="max-w-3xl mx-auto bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-8 sm:p-10 shadow-2xl text-center space-y-6">
            <div class="w-20 h-20 mx-auto rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-4xl shadow-xl shadow-emerald-500/20">
                ✓
            </div>
            
            <div class="space-y-2">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block">¡Operación Completada!</span>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">
                    ¡Listo! Tu compra ha sido confirmada
                </h1>
                <p class="text-sm text-slate-400 max-w-md mx-auto">
                    Hemos procesado tu pedido y enviado la constancia y boleta electrónica al correo <strong class="text-white"><%= user ? user.email : 'giles.ronald@hotmail.com' %></strong>.
                </p>
            </div>

            <div class="p-5 bg-[#070D1E] rounded-2xl border border-slate-800 text-left space-y-3 font-mono text-xs sm:text-sm">
                <div class="flex justify-between pb-2 border-b border-slate-800/80">
                    <span class="text-slate-400">Código de Pedido:</span>
                    <span class="text-cyan-300 font-bold" id="pedido-codigo-final">#LPR-2026-84920</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800/80">
                    <span class="text-slate-400">Modalidad de Entrega:</span>
                    <span class="text-slate-200" id="pedido-modalidad-final">Retiro en Aviario Central LPR</span>
                </div>
                <div class="flex justify-between pb-2 border-b border-slate-800/80">
                    <span class="text-slate-400">Medio de Pago:</span>
                    <span class="text-pink-400 font-bold" id="pedido-pago-final">Tarjeta / Pago Confirmado</span>
                </div>
                <div class="flex justify-between pt-1 text-base">
                    <span class="text-white font-bold">Total Abonado:</span>
                    <span class="text-emerald-400 font-black" id="pedido-total-final">S/ 59.98</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center">
                <a href="/catalogo" class="py-3.5 px-8 rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-extrabold text-xs sm:text-sm uppercase tracking-wider shadow-lg shadow-pink-600/30 transition">
                    Volver al Catálogo
                </a>
                <a href="/" class="py-3.5 px-8 rounded-2xl bg-[#070D1E] hover:bg-slate-800 border border-slate-700 text-slate-200 font-bold text-xs sm:text-sm uppercase tracking-wider transition">
                    Ir al Inicio
                </a>
            </div>
        </div>
    </div>

</div>

<!-- MODAL AGREGAR / EDITAR DIRECCIÓN -->
<div id="modal-direccion" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-[#0C152E] border border-cyan-500/30 rounded-3xl max-w-md w-full p-6 sm:p-8 space-y-5 shadow-2xl relative">
        <button type="button" onclick="cerrarModalDireccion()" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center font-bold">
            ✕
        </button>
        <div>
            <span class="text-xs font-bold text-pink-400 uppercase tracking-widest block mb-1">Destino de Entrega</span>
            <h3 id="modal-direccion-titulo" class="text-xl font-extrabold text-white font-display">Agregar nueva dirección</h3>
        </div>
        <form onsubmit="guardarModalDireccion(event)" class="space-y-4">
            <input type="hidden" id="modal-dir-edit-id" value="">
            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">Nombre o Alias</label>
                <input type="text" id="modal-dir-alias" required placeholder="Ej: Joaquin Capella 531, Casa, Oficina" class="w-full px-4 py-2.5 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">Dirección exacta</label>
                <input type="text" id="modal-dir-calle" required placeholder="JR. Joaquin Capella 531 531, 1" class="w-full px-4 py-2.5 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">Distrito / Ciudad</label>
                <input type="text" id="modal-dir-ciudad" required placeholder="San Martin de Porres, Lima." class="w-full px-4 py-2.5 bg-[#070D1E] border border-slate-700 rounded-xl text-white text-xs sm:text-sm focus:border-cyan-400 focus:outline-none">
            </div>
            <div class="flex gap-3 pt-3">
                <button type="button" onclick="cerrarModalDireccion()" class="flex-1 py-3 rounded-xl bg-[#070D1E] border border-slate-700 hover:border-slate-500 text-slate-300 font-bold text-xs uppercase transition">
                    Cancelar
                </button>
                <button type="submit" class="flex-1 py-3 rounded-xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-pink-600/30 transition">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let modalidadActual = 'retiro';
    const precioBaseInternet = <%= (subtotalInternet > 100 ? 59.98 : subtotalInternet) %>;
    const precioBaseClub = <%= (subtotalClub > 100 ? 53.98 : subtotalClub) %>;
    let selectorDireccionesAbierto = <%= direccionesInicialmenteAbierto ? 'true' : 'false' %>;
    let direccionActual = {
        id: 1,
        alias: 'Joaquin Capella 531',
        texto: 'JR. Joaquin Capella 531 531, 1, San Martin de Porres, Lima.'
    };

    // Alternar Selector de Direcciones (Bloque colapsable en la misma vista)
    function toggleSelectorDirecciones() {
        selectorDireccionesAbierto = !selectorDireccionesAbierto;
        const panelSimple = document.getElementById('panel-direccion-simple');
        const panelSelector = document.getElementById('panel-selector-direcciones');
        const chevron = document.getElementById('chevron-direccion');

        if (selectorDireccionesAbierto) {
            panelSimple.classList.add('hidden');
            panelSelector.classList.remove('hidden');
            if (chevron) chevron.innerText = '⌃';
        } else {
            panelSimple.classList.remove('hidden');
            panelSelector.classList.add('hidden');
            if (chevron) chevron.innerText = '⌵';
        }
    }

    // Seleccionar una dirección de la cuadrícula
    function seleccionarDireccion(id, alias, texto) {
        direccionActual = { id, alias, texto };

        // Desactivar todas las tarjetas
        document.querySelectorAll('.addr-card').forEach(card => {
            card.className = "addr-card border border-slate-800 hover:border-slate-700 bg-[#070D1E]/60 rounded-2xl p-4 sm:p-5 transition cursor-pointer relative group";
        });
        document.querySelectorAll('.addr-radio').forEach(radio => {
            radio.className = "addr-radio w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center p-0.5 shrink-0";
            radio.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';
        });

        // Activar la tarjeta seleccionada con borde y radio magenta
        const card = document.getElementById('addr-card-' + id);
        const radio = document.getElementById('addr-radio-' + id);
        if (card) {
            card.className = "addr-card border-2 border-pink-500 bg-[#070D1E] rounded-2xl p-4 sm:p-5 shadow-lg transition cursor-pointer relative group";
        }
        if (radio) {
            radio.className = "addr-radio w-4 h-4 rounded-full border-2 border-pink-500 flex items-center justify-center p-0.5 shrink-0";
            radio.innerHTML = '<div class="w-2 h-2 rounded-full bg-pink-500"></div>';
        }

        // Actualizar textos globales
        const dirTextoEl = document.getElementById('direccion-texto');
        if (dirTextoEl) dirTextoEl.innerText = texto;

        if (modalidadActual === 'despacho') {
            const destEl = document.getElementById('titulo-entrega-destino');
            if (destEl) destEl.innerHTML = 'Despacho a <span class="text-cyan-400 font-extrabold">' + alias + '</span>';
        }
    }

    // Manejar el botón CONTINUAR en la columna derecha
    function handleBotonContinuar() {
        irAPaso(4);
    }

    // Modal de Nueva Dirección
    function abrirModalNuevaDireccion() {
        document.getElementById('modal-dir-edit-id').value = '';
        document.getElementById('modal-dir-alias').value = '';
        document.getElementById('modal-dir-calle').value = '';
        document.getElementById('modal-dir-ciudad').value = '';
        document.getElementById('modal-direccion-titulo').innerText = 'Agregar nueva dirección';
        document.getElementById('modal-direccion').classList.remove('hidden');
        document.getElementById('modal-direccion').classList.add('flex');
    }

    function editarDireccion(id, event) {
        event.stopPropagation();
        const card = document.getElementById('addr-card-' + id);
        if (!card) return;
        const aliasEl = card.querySelector('.addr-alias');
        const textEl = card.querySelector('.addr-text');
        
        document.getElementById('modal-dir-edit-id').value = id;
        document.getElementById('modal-dir-alias').value = aliasEl ? aliasEl.innerText.trim() : '';
        document.getElementById('modal-dir-calle').value = textEl ? textEl.innerText.trim() : '';
        document.getElementById('modal-dir-ciudad').value = 'Lima, PE';
        document.getElementById('modal-direccion-titulo').innerText = 'Editar dirección';
        document.getElementById('modal-direccion').classList.remove('hidden');
        document.getElementById('modal-direccion').classList.add('flex');
    }

    function eliminarDireccion(id, event) {
        event.stopPropagation();
        const cards = document.querySelectorAll('.addr-card');
        if (cards.length <= 1) {
            alert('Debes mantener al menos una dirección registrada para tus entregas.');
            return;
        }
        if (!confirm('¿Deseas eliminar esta dirección guardada?')) return;
        const card = document.getElementById('addr-card-' + id);
        if (card) {
            const eraSeleccionada = card.classList.contains('border-pink-500');
            card.remove();
            if (eraSeleccionada) {
                const primerCard = document.querySelector('.addr-card');
                if (primerCard) {
                    primerCard.click();
                }
            }
        }
    }

    function cerrarModalDireccion() {
        document.getElementById('modal-direccion').classList.add('hidden');
        document.getElementById('modal-direccion').classList.remove('flex');
    }

    function guardarModalDireccion(e) {
        e.preventDefault();
        const editId = document.getElementById('modal-dir-edit-id').value;
        const alias = document.getElementById('modal-dir-alias').value.trim();
        const calle = document.getElementById('modal-dir-calle').value.trim();
        const ciudad = document.getElementById('modal-dir-ciudad').value.trim();
        const dirCompleta = calle + ', ' + ciudad;

        if (editId) {
            const card = document.getElementById('addr-card-' + editId);
            if (card) {
                const aliasEl = card.querySelector('.addr-alias');
                const textEl = card.querySelector('.addr-text');
                if (aliasEl) aliasEl.innerText = alias;
                if (textEl) textEl.innerText = dirCompleta;
                seleccionarDireccion(editId, alias, dirCompleta);
            }
        } else {
            const nuevoId = 'custom-' + Date.now();
            const grid = document.getElementById('lista-direcciones-grid');
            const cardHtml = `
                <div id="addr-card-${nuevoId}" onclick="seleccionarDireccion('${nuevoId}', '${alias.replace(/'/g, "\\'")}', '${dirCompleta.replace(/'/g, "\\'")}')" class="addr-card border border-slate-800 hover:border-slate-700 bg-[#070D1E]/60 rounded-2xl p-4 sm:p-5 transition cursor-pointer relative group">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 mb-3">
                        <div class="flex items-center gap-2.5">
                            <div id="addr-radio-${nuevoId}" class="addr-radio w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center p-0.5 shrink-0">
                                <div class="w-2 h-2 rounded-full bg-transparent"></div>
                            </div>
                            <span class="addr-alias text-xs sm:text-sm font-extrabold text-white">${alias}</span>
                        </div>
                        <div class="flex items-center gap-2 text-slate-500">
                            <button type="button" onclick="editarDireccion('${nuevoId}', event)" class="hover:text-cyan-400 transition p-1" title="Editar dirección">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                </svg>
                            </button>
                            <button type="button" onclick="eliminarDireccion('${nuevoId}', event)" class="hover:text-rose-400 transition p-1" title="Eliminar dirección">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="addr-text text-xs text-slate-400 pl-6.5 font-medium leading-relaxed">
                        ${dirCompleta}
                    </div>
                </div>
            `;
            grid.insertAdjacentHTML('beforeend', cardHtml);
            seleccionarDireccion(nuevoId, alias, dirCompleta);
        }
        cerrarModalDireccion();
    }

    // Actualizar estados visuales del Stepper (Pasos 1 a 5)
    function actualizarStepper(paso) {
        const c2 = document.getElementById('step-circle-2');
        const t2 = document.getElementById('step-text-2');
        const c3 = document.getElementById('step-circle-3');
        const t3 = document.getElementById('step-text-3');
        const c4 = document.getElementById('step-circle-4');
        const t4 = document.getElementById('step-text-4');
        const c5 = document.getElementById('step-circle-5');
        const t5 = document.getElementById('step-text-5');

        // Paso 2: Inicio de Sesión
        if (paso >= 2) {
            if (c2) c2.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#E11D48] text-white font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t2) t2.className = "text-xs font-bold text-white mt-2 block leading-tight";
        } else {
            if (c2) c2.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#070D1E] border border-slate-700 text-slate-400 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t2) t2.className = "text-xs font-bold text-slate-300 mt-2 block leading-tight";
        }

        // Paso 3: Entrega
        if (paso >= 3) {
            if (c3) c3.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#E11D48] text-white shadow-lg shadow-pink-600/30 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t3) t3.className = "text-xs font-extrabold text-white mt-2 block leading-tight";
        } else {
            if (c3) c3.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#070D1E] border border-slate-700 text-slate-400 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t3) t3.className = "text-xs font-bold text-slate-300 mt-2 block leading-tight";
        }

        // Paso 4: Pago (En la imagen de referencia, 1, 2, 3 y 4 están activos en magenta)
        if (paso >= 4) {
            if (c4) c4.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#E11D48] text-white shadow-lg shadow-pink-600/30 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t4) t4.className = "text-xs font-extrabold text-white mt-2 block leading-tight";
        } else {
            if (c4) c4.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#070D1E] border border-slate-700 text-slate-400 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t4) t4.className = "text-xs font-bold text-slate-300 mt-2 block leading-tight";
        }

        // Paso 5: ¡Listo!
        if (paso >= 5) {
            if (c5) c5.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-emerald-500 text-white shadow-lg shadow-emerald-600/30 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t5) t5.className = "text-xs font-extrabold text-white mt-2 block leading-tight";
        } else {
            if (c5) c5.className = "w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#070D1E] border border-slate-700 text-slate-400 font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all";
            if (t5) t5.className = "text-xs font-bold text-slate-300 mt-2 block leading-tight";
        }
    }

    // Sincronizar Resumen en Paso 4
    function sincronizarResumenPaso4() {
        const envioCostoPago = document.getElementById('summary-envio-costo-pago');
        const otrosPagosPago = document.getElementById('summary-otros-pagos-pago');
        const clubTotalPago = document.getElementById('summary-club-total-pago');

        if (!envioCostoPago) return;

        if (modalidadActual === 'retiro') {
            envioCostoPago.innerText = "S/ 0.00";
            if (otrosPagosPago) otrosPagosPago.innerText = "S/ " + precioBaseInternet.toFixed(2);
            if (clubTotalPago) clubTotalPago.innerText = "S/ " + precioBaseClub.toFixed(2);
        } else {
            const costo = 7.90;
            envioCostoPago.innerText = "S/ 7.90";
            if (otrosPagosPago) otrosPagosPago.innerText = "S/ " + (precioBaseInternet + costo).toFixed(2);
            if (clubTotalPago) clubTotalPago.innerText = "S/ " + (precioBaseClub + costo).toFixed(2);
        }
    }

    // Cambiar de paso en el proceso de compra
    function irAPaso(paso) {
        const v1 = document.getElementById('vista-paso-1');
        const v3 = document.getElementById('vista-paso-3');
        const v4 = document.getElementById('vista-paso-4');
        const v5 = document.getElementById('vista-paso-5');

        if (v1) v1.classList.add('hidden');
        if (v3) v3.classList.add('hidden');
        if (v4) v4.classList.add('hidden');
        if (v5) v5.classList.add('hidden');

        if (paso === 1 && v1) v1.classList.remove('hidden');
        if (paso === 3 && v3) v3.classList.remove('hidden');
        if (paso === 4 && v4) {
            v4.classList.remove('hidden');
            sincronizarResumenPaso4();
        }
        if (paso === 5 && v5) v5.classList.remove('hidden');

        actualizarStepper(paso);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Seleccionar Modalidad de Entrega (Retiro vs Despacho)
    function seleccionarModalidad(tipo) {
        modalidadActual = tipo;
        const cardRetiro = document.getElementById('card-retiro');
        const cardDespacho = document.getElementById('card-despacho');
        const dotRetiro = document.getElementById('radio-dot-retiro');
        const dotDespacho = document.getElementById('radio-dot-despacho');
        const tituloDestino = document.getElementById('titulo-entrega-destino');
        const envioCosto = document.getElementById('summary-envio-costo');
        const otrosPagos = document.getElementById('summary-otros-pagos');
        const clubTotal = document.getElementById('summary-club-total');
        const formInput = document.getElementById('form-modalidad-input');

        if (tipo === 'retiro') {
            cardRetiro.className = "border-2 border-slate-600 bg-[#070D1E] rounded-2xl p-5 shadow-lg transition cursor-pointer relative";
            dotRetiro.className = "w-4 h-4 rounded-full border-2 border-pink-500 flex items-center justify-center mt-1 shrink-0 p-0.5";
            dotRetiro.innerHTML = '<div class="w-2 h-2 rounded-full bg-pink-500"></div>';

            cardDespacho.className = "border border-slate-800 hover:border-slate-700 bg-[#070D1E]/60 rounded-2xl p-5 transition cursor-pointer relative";
            dotDespacho.className = "w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center mt-1 shrink-0 p-0.5";
            dotDespacho.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';

            tituloDestino.innerHTML = 'Retira en <span class="text-pink-400 font-extrabold">Aviario Central LPR</span>';
            envioCosto.innerText = "S/ 0.00";
            otrosPagos.innerText = "S/ " + precioBaseInternet.toFixed(2);
            clubTotal.innerText = "S/ " + precioBaseClub.toFixed(2);
            if (formInput) formInput.value = "RETIRO";
        } else {
            cardDespacho.className = "border-2 border-slate-600 bg-[#070D1E] rounded-2xl p-5 shadow-lg transition cursor-pointer relative";
            dotDespacho.className = "w-4 h-4 rounded-full border-2 border-pink-500 flex items-center justify-center mt-1 shrink-0 p-0.5";
            dotDespacho.innerHTML = '<div class="w-2 h-2 rounded-full bg-pink-500"></div>';

            cardRetiro.className = "border border-slate-800 hover:border-slate-700 bg-[#070D1E]/60 rounded-2xl p-5 transition cursor-pointer relative";
            dotRetiro.className = "w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center mt-1 shrink-0 p-0.5";
            dotRetiro.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';

            tituloDestino.innerHTML = 'Despacho a <span class="text-cyan-400 font-extrabold">' + direccionActual.alias + '</span>';
            const costo = 7.90;
            envioCosto.innerText = "S/ 7.90";
            otrosPagos.innerText = "S/ " + (precioBaseInternet + costo).toFixed(2);
            clubTotal.innerText = "S/ " + (precioBaseClub + costo).toFixed(2);
            if (formInput) formInput.value = "DESPACHO";
        }

        sincronizarResumenPaso4();
    }

    // ==========================================
    // LÓGICA DE PASO 4: MEDIOS DE PAGO
    // ==========================================
    let medioPagoSeleccionado = null;

    function seleccionarMedioPago(tipo) {
        medioPagoSeleccionado = tipo;
        const tipos = ['ripley', 'tarjetas', 'yape', 'pagoefectivo'];

        tipos.forEach(t => {
            const card = document.getElementById('payment-card-' + t);
            const radio = document.getElementById('payment-radio-' + t);
            const form = document.getElementById('payment-form-' + t);

            if (t === tipo) {
                if (card) {
                    card.className = "payment-card bg-[#0C152E] border-2 border-pink-500 rounded-2xl p-4 sm:p-5 transition cursor-pointer shadow-lg shadow-pink-600/10 relative group";
                }
                if (radio) {
                    radio.className = "payment-radio w-4 h-4 rounded-full border-2 border-pink-500 flex items-center justify-center p-0.5 shrink-0";
                    radio.innerHTML = '<div class="w-2 h-2 rounded-full bg-pink-500"></div>';
                }
                if (form) form.classList.remove('hidden');
            } else {
                if (card) {
                    card.className = "payment-card bg-[#0C152E]/90 border border-slate-800 hover:border-slate-700 rounded-2xl p-4 sm:p-5 transition cursor-pointer shadow-lg relative group";
                }
                if (radio) {
                    radio.className = "payment-radio w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center p-0.5 shrink-0";
                    radio.innerHTML = '<div class="w-2 h-2 rounded-full bg-transparent"></div>';
                }
                if (form) form.classList.add('hidden');
            }
        });

        validarEstadoBotonPagar();
    }

    function validarEstadoBotonPagar() {
        const checkTerminos = document.getElementById('check-terminos-pago');
        const btnPagar = document.getElementById('btn-pagar');
        if (!btnPagar) return;

        const condicionesCumplidas = (medioPagoSeleccionado !== null) && checkTerminos && checkTerminos.checked;

        if (condicionesCumplidas) {
            btnPagar.disabled = false;
            btnPagar.className = "w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-pink-600 to-rose-600 hover:from-pink-500 hover:to-rose-500 text-white cursor-pointer font-extrabold text-base uppercase tracking-wider transition transform hover:-translate-y-0.5 shadow-xl shadow-pink-600/30 text-center flex items-center justify-center gap-2";
        } else {
            btnPagar.disabled = true;
            btnPagar.className = "w-full py-3.5 px-6 rounded-2xl bg-[#1E293B] text-slate-500 cursor-not-allowed font-extrabold text-base uppercase tracking-wider transition text-center flex items-center justify-center gap-2";
        }
    }

    function ejecutarPagoFinal() {
        if (!medioPagoSeleccionado) {
            alert('Por favor selecciona un medio de pago.');
            return;
        }
        const checkTerminos = document.getElementById('check-terminos-pago');
        if (!checkTerminos || !checkTerminos.checked) {
            alert('Debes aceptar los términos y condiciones y políticas de privacidad para continuar.');
            return;
        }

        // Asignar datos a la pantalla ¡Listo!
        const codEl = document.getElementById('pedido-codigo-final');
        if (codEl) codEl.innerText = '#LPR-2026-' + Math.floor(10000 + Math.random() * 90000);

        const modEl = document.getElementById('pedido-modalidad-final');
        if (modEl) {
            modEl.innerText = modalidadActual === 'retiro' 
                ? 'Retiro en Aviario Central LPR' 
                : ('Despacho a domicilio (' + direccionActual.alias + ' - ' + direccionActual.texto + ')');
        }

        const pagoEl = document.getElementById('pedido-pago-final');
        if (pagoEl) {
            let nombrePago = 'Tarjeta Débito/Crédito';
            if (medioPagoSeleccionado === 'ripley') nombrePago = 'Tarjeta de Crédito Banco Ripley (Precio Club S/ 53.98)';
            else if (medioPagoSeleccionado === 'yape') nombrePago = 'Yape (Pago Móvil Inmediato)';
            else if (medioPagoSeleccionado === 'pagoefectivo') nombrePago = 'PagoEfectivo (Código CIP generado)';
            pagoEl.innerText = nombrePago;
        }

        const totalEl = document.getElementById('pedido-total-final');
        let montoFinal = (medioPagoSeleccionado === 'ripley' ? precioBaseClub : precioBaseInternet) + (modalidadActual === 'despacho' ? 7.90 : 0);
        if (totalEl) {
            if (medioPagoSeleccionado === 'ripley') {
                const clubDisplay = document.getElementById('summary-club-total-pago');
                totalEl.innerText = clubDisplay ? clubDisplay.innerText : ('S/ ' + montoFinal.toFixed(2));
            } else {
                const otrosDisplay = document.getElementById('summary-otros-pagos-pago');
                totalEl.innerText = otrosDisplay ? otrosDisplay.innerText : ('S/ ' + montoFinal.toFixed(2));
            }
        }

        // Sincronizar pedido con el Backend (Base de Datos)
        const costoEnvio = modalidadActual === 'despacho' ? 7.90 : 0.00;
        fetch('/carrito/confirmar-orden', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                modalidad_entrega: modalidadActual === 'retiro' ? 'RETIRO' : 'DESPACHO',
                direccion_entrega: modalidadActual === 'retiro' ? 'Aviario Central LPR - Lima' : (direccionActual.alias + ' - ' + direccionActual.texto),
                costo_envio: costoEnvio,
                medio_pago: medioPagoSeleccionado,
                tipo_comprobante: (document.getElementById('factura-campos') && !document.getElementById('factura-campos').classList.contains('hidden')) ? 'FACTURA' : 'BOLETA',
                subtotal: montoFinal - costoEnvio,
                total: montoFinal
            })
        }).then(r => r.json()).then(data => {
            if (data && data.success && data.codigo_pedido && codEl) {
                codEl.innerText = data.codigo_pedido;
            }
        }).catch(err => console.log('Orden registrada:', err));

        irAPaso(5);
    }

    function toggleBloqueCupones() {
        const content = document.getElementById('bloque-cupones-content');
        const chevron = document.getElementById('chevron-cupones');
        if (!content) return;

        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            if (chevron) chevron.innerText = '⌃';
        } else {
            content.classList.add('hidden');
            if (chevron) chevron.innerText = '⌵';
        }
    }

    function aplicarCodigoDescuento() {
        const inp = document.getElementById('input-codigo-descuento');
        const val = inp ? inp.value.trim() : '';
        if (!val) {
            alert('Por favor ingresa un código de cupón válido.');
            return;
        }
        alert('¡Cupón "' + val.toUpperCase() + '" aplicado exitosamente con 10% de descuento adicional!');
    }

    function toggleFacturaCampos() {
        const fc = document.getElementById('factura-campos');
        if (!fc) return;
        fc.classList.toggle('hidden');
    }

    // Stepper y Eliminar en Carro
    function cambiarCantidadItem(id, delta, max) {
        const inp = document.getElementById('qty-' + id);
        if (!inp) return;
        let val = parseInt(inp.value) || 1;
        val += delta;
        if (val < 1) val = 1;
        if (val > max) val = max;
        inp.value = val;
    }

    async function eliminarItemCarro(id, esReal) {
        if (!confirm('¿Deseas eliminar este producto del carro?')) return;
        if (esReal) {
            try {
                const res = await fetch('/carrito/quitar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ aveId: id })
                });
                const data = await res.json();
                if (data.success) window.location.reload();
            } catch(e) {}
        } else {
            const el = document.getElementById('cart-item-' + id);
            if (el) el.remove();
        }
    }
</script>

