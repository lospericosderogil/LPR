<%- include('../partials/header') %>

<% 
    const tieneReservasReales = typeof reservas !== 'undefined' && reservas.length > 0;
    let pasoActual = 1;
    if (typeof paso !== 'undefined') {
        if (paso === 'entrega' || paso === '3' || paso === 'direcciones') pasoActual = 3;
        else if (paso === 'pago' || paso === '4') pasoActual = 4;
        else if (paso === 'listo' || paso === '5') pasoActual = 5;
        else if (paso === 'sesion' || paso === '2') pasoActual = 2;
        else pasoActual = 1;
    }
    const direccionesInicialmenteAbierto = typeof abrirDirecciones !== 'undefined' && Boolean(abrirDirecciones);
    
    // Lista de items: Si hay reservas reales se usan esas, si no, se muestran los items de demostración idénticos a las imágenes
    const items = tieneReservasReales ? reservas.map(r => ({
        id: r.ave_id,
        esReal: true,
        titulo: r.anilla ? ('PERICO AUSTRALIANO - ' + r.anilla) : ('EJEMPLAR #' + r.ave_id),
        marca: 'CRIADERO LPR',
        sku: 'SKU: ' + (r.anilla || ('2025-LPR-' + r.ave_id)),
        tag1: r.sexo === 'M' ? 'MACHO (ADN)' : (r.sexo === 'F' ? 'HEMBRA (ADN)' : 'VERIFICADO'),
        tag2: r.especie_nombre ? r.especie_nombre.toUpperCase() : 'SELECCIÓN ÉLITE',
        precioInternet: parseFloat(r.precio_venta || 190),
        precioNormal: parseFloat(r.precio_venta || 190) * 1.35,
        precioClub: parseFloat(r.precio_venta || 190) * 0.90,
        foto: r.foto || '/img/cuidado_parental/voladera_vuelo.jpg',
        expira_at: r.expira_at,
        maxUnits: 1
    })) : [
        {
            id: 'demo-1',
            esReal: false,
            titulo: 'POLO MANGA CORTA ALGODÓN HOMBRE KENNETH STEVENS',
            marca: 'KENNETH STEVENS',
            sku: 'SKU: 2005369066962',
            tag1: 'DENIM',
            tag2: 'L',
            precioClub: 26.99,
            precioInternet: 29.99,
            precioNormal: 49.99,
            foto: '/uploads/1787869128585-WhatsApp_Image_2026_08_27_at_5.09.21_PM.jpeg',
            maxUnits: 10
        },
        {
            id: 'demo-2',
            esReal: false,
            titulo: 'ZAPATILLAS URBANAS MUJER ADIDAS ORIGINALS SL 72 OG W',
            marca: 'ADIDAS ORIGINALS',
            sku: 'SKU: 2026376708225',
            tag1: 'MARRÓN',
            tag2: '6',
            precioClub: 399.99,
            precioInternet: 399.99,
            precioNormal: 449.99,
            foto: '/img/salud_preventiva/suplementos_preventivos.jpg',
            maxUnits: 10
        }
    ];

    let subtotalNormal = 0;
    let subtotalInternet = 0;
    let subtotalClub = 0;
    items.forEach(it => {
        subtotalNormal += it.precioNormal;
        subtotalInternet += it.precioInternet;
        subtotalClub += it.precioClub;
    });
%>

<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. STEPPER / INDICADOR DE PROCESO DE COMPRA (5 PASOS) -->
    <div class="bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-5 sm:p-7 shadow-xl">
        <div class="grid grid-cols-5 gap-2 relative max-w-4xl mx-auto">
            <!-- Línea conectora horizontal centrada -->
            <div id="stepper-line" class="absolute top-4 sm:top-4.5 left-[10%] right-[10%] h-[2px] bg-slate-700 z-0"></div>
            
            <!-- Paso 1: Carro de compras -->
            <div class="flex flex-col items-center text-center relative z-10 cursor-pointer" onclick="irAPaso(1)">
                <div id="step-circle-1" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#E11D48] text-white font-black text-xs sm:text-sm flex items-center justify-center shadow-lg shadow-pink-600/30 ring-4 ring-[#0C152E] transition-all">
                    1
                </div>
                <span id="step-text-1" class="text-xs font-extrabold text-white mt-2 block leading-tight">Carro de compras</span>
                <span class="text-[10px] text-slate-400 hidden sm:block mt-0.5">Revisa tus productos</span>
            </div>

            <!-- Paso 2: Inicio de sesión -->
            <div class="flex flex-col items-center text-center relative z-10">
                <div id="step-circle-2" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full <%= (pasoActual >= 2 || user) ? 'bg-[#E11D48] text-white' : 'bg-[#070D1E] border border-slate-700 text-slate-400' %> font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all">
                    2
                </div>
                <span id="step-text-2" class="text-xs font-bold <%= (pasoActual >= 2 || user) ? 'text-white' : 'text-slate-300' %> mt-2 block leading-tight">Inicio de sesión</span>
                <span class="text-[10px] text-slate-500 hidden sm:block mt-0.5"><%= user ? user.nombre : 'Ingresa a tu Cuenta Ripley' %></span>
            </div>

            <!-- Paso 3: Entrega -->
            <div class="flex flex-col items-center text-center relative z-10 cursor-pointer" onclick="irAPaso(3)">
                <div id="step-circle-3" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full <%= pasoActual >= 3 ? 'bg-[#E11D48] text-white shadow-lg shadow-pink-600/30' : 'bg-[#070D1E] border border-slate-700 text-slate-400' %> font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all">
                    3
                </div>
                <span id="step-text-3" class="text-xs font-bold <%= pasoActual >= 3 ? 'text-white font-extrabold' : 'text-slate-300' %> mt-2 block leading-tight">Entrega</span>
                <span class="text-[10px] text-slate-400 hidden sm:block mt-0.5">Elige donde recibir tu compra</span>
            </div>

            <!-- Paso 4: Pago -->
            <div class="flex flex-col items-center text-center relative z-10 cursor-pointer" onclick="irAPaso(4)">
                <div id="step-circle-4" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full <%= pasoActual >= 4 ? 'bg-[#E11D48] text-white shadow-lg shadow-pink-600/30' : 'bg-[#070D1E] border border-slate-700 text-slate-400' %> font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all">
                    4
                </div>
                <span id="step-text-4" class="text-xs font-bold <%= pasoActual >= 4 ? 'text-white font-extrabold' : 'text-slate-300' %> mt-2 block leading-tight">Pago</span>
                <span class="text-[10px] text-slate-500 hidden sm:block mt-0.5">Elige como vas a pagar</span>
            </div>

            <!-- Paso 5: ¡Listo! -->
            <div class="flex flex-col items-center text-center relative z-10 cursor-pointer" onclick="irAPaso(5)">
                <div id="step-circle-5" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full <%= pasoActual >= 5 ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-600/30' : 'bg-[#070D1E] border border-slate-700 text-slate-400' %> font-bold text-xs sm:text-sm flex items-center justify-center ring-4 ring-[#0C152E] transition-all">
                    5
                </div>
                <span id="step-text-5" class="text-xs font-bold <%= pasoActual >= 5 ? 'text-white font-extrabold' : 'text-slate-300' %> mt-2 block leading-tight">¡Listo!</span>
                <span class="text-[10px] text-slate-500 hidden sm:block mt-0.5">Revisa el detalle de tu compra</span>
            </div>

        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VISTA PASO 1: CARRO DE COMPRAS (Revisa tus productos) -->
    <!-- ========================================================================= -->
    <div id="vista-paso-1" class="<%= pasoActual === 1 ? '' : 'hidden' %>">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- COLUMNA IZQUIERDA: CARRO DE COMPRAS -->
            <div class="lg:col-span-8 space-y-4">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-display">
                    Carro de compras
                </h1>

                <div class="bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl space-y-6">
                    <!-- Encabezado Proveedor / Aviario -->
                    <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
                        <div class="text-xs sm:text-sm font-bold text-slate-300">
                            Vendido por: <span class="text-pink-400 font-extrabold">Aviario Central LPR</span>
                        </div>
                        <% if (!tieneReservasReales) { %>
                            <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-cyan-950/80 text-cyan-300 border border-cyan-500/30">
                                Vista interactiva
                            </span>
                        <% } %>
                    </div>

                    <!-- Lista de Productos en el Carro -->
                    <div class="divide-y divide-slate-800/80">
                        <% items.forEach((item) => { %>
                            <div class="py-6 first:pt-2 last:pb-2 flex flex-col sm:flex-row items-start justify-between gap-4" id="cart-item-<%= item.id %>">
                                <div class="flex items-start gap-4 flex-1">
                                    <div class="w-20 h-20 sm:w-24 sm:h-24 bg-[#070D1E] rounded-2xl overflow-hidden border border-slate-800 shrink-0 relative group">
                                        <img src="<%= item.foto %>" alt="<%= item.titulo %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
                                    </div>
                                    <div class="space-y-1.5 flex-1 min-w-0">
                                        <h3 class="text-xs sm:text-sm font-extrabold text-white uppercase font-display leading-tight line-clamp-2">
                                            <%= item.titulo %>
                                        </h3>
                                        <span class="text-xs font-black text-slate-400 uppercase tracking-wider block">
                                            <%= item.marca %>
                                        </span>
                                        <span class="text-[11px] text-slate-500 font-mono block">
                                            <%= item.sku %>
                                        </span>
                                        <div class="flex flex-wrap items-center gap-1.5 pt-1">
                                            <span class="px-2.5 py-0.5 rounded bg-[#070D1E] border border-slate-800 text-[10px] font-bold text-slate-300 uppercase">
                                                <%= item.tag1 %>
                                            </span>
                                            <span class="px-2.5 py-0.5 rounded bg-[#070D1E] border border-slate-800 text-[10px] font-bold text-slate-300 uppercase">
                                                <%= item.tag2 %>
                                            </span>
                                            <% if (item.esReal && item.expira_at) { %>
                                                <span class="countdown-badge px-2.5 py-0.5 rounded bg-cyan-950/80 text-[10px] font-bold text-cyan-300 border border-cyan-500/30 flex items-center gap-1" data-expire="<%= new Date(item.expira_at).getTime() %>">
                                                    <span>⏳</span>
                                                    <span class="countdown-timer">10:00</span>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex sm:flex-col items-end justify-between sm:justify-start w-full sm:w-auto pt-2 sm:pt-0 gap-3">
                                    <div class="flex items-start gap-4 text-right">
                                        <div class="space-y-0.5 text-right font-mono">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <span class="text-sm sm:text-base font-black text-white">S/ <%= item.precioClub.toFixed(2) %></span>
                                                <span class="w-3.5 h-2.5 bg-pink-600 rounded-[2px] inline-block text-[7px] text-white font-black text-center leading-2.5">R</span>
                                            </div>
                                            <div class="text-xs font-bold text-slate-300">
                                                S/ <%= item.precioInternet.toFixed(2) %>
                                            </div>
                                            <div class="text-[10px] text-slate-500 line-through">
                                                S/ <%= item.precioNormal.toFixed(2) %>
                                            </div>
                                        </div>

                                        <button type="button" onclick="eliminarItemCarro('<%= item.id %>', <%= item.esReal %>)" class="text-slate-500 hover:text-rose-400 transition p-1" title="Eliminar del carro">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>

                                    <div class="flex flex-col items-end pt-1">
                                        <div class="flex items-center border border-slate-700 rounded-lg overflow-hidden bg-[#070D1E]">
                                            <button type="button" onclick="cambiarCantidadItem('<%= item.id %>', -1, <%= item.maxUnits %>)" class="w-7 h-7 text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center font-bold text-xs">-</button>
                                            <input type="text" id="qty-<%= item.id %>" value="1" readonly class="w-8 text-center bg-transparent text-xs font-bold text-white border-none focus:outline-none">
                                            <button type="button" onclick="cambiarCantidadItem('<%= item.id %>', 1, <%= item.maxUnits %>)" class="w-7 h-7 text-slate-400 hover:text-white hover:bg-slate-800 transition flex items-center justify-center font-bold text-xs">+</button>
                                        </div>
                                        <span class="text-[9px] text-slate-500 mt-1 font-medium">Máx. <%= item.maxUnits %> unidades</span>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: RESUMEN DE LA COMPRA (PASO 1) -->
            <div class="lg:col-span-4 space-y-4">
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-display">
                    Resumen de la compra
                </h2>

                <div class="bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl space-y-5">
                    <div class="flex items-center justify-between text-xs sm:text-sm font-medium">
                        <span class="text-slate-300">Productos (<span id="summary-count-1"><%= items.length %></span>)</span>
                        <div class="flex items-center gap-2 font-mono">
                            <span class="text-slate-500 line-through text-xs">S/ <%= subtotalNormal.toFixed(2) %></span>
                            <span class="text-white font-bold">S/ <%= subtotalInternet.toFixed(2) %></span>
                            <span class="text-slate-400 text-xs">⌵</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-xs sm:text-sm font-medium pt-1">
                        <span class="text-slate-300">Otros medios de pago</span>
                        <span class="text-white font-bold font-mono">S/ <%= subtotalInternet.toFixed(2) %></span>
                    </div>

                    <div class="flex items-center justify-between text-xs sm:text-sm font-bold pt-1">
                        <div class="flex items-center gap-1.5 text-slate-200">
                            <span>Tarjeta / Club LPR</span>
                            <span class="w-3.5 h-2.5 bg-pink-600 rounded-[2px] inline-block text-[7px] text-white font-black text-center leading-2.5">R</span>
                        </div>
                        <span class="text-cyan-400 font-extrabold font-mono text-base">S/ <%= subtotalClub.toFixed(2) %></span>
                    </div>

                    <div class="pt-2">
                        <button type="button" onclick="irAPaso(3)" class="w-full py-3.5 px-6 rounded-2xl bg-[#1E293B] hover:bg-[#334155] border border-slate-600 text-white font-extrabold text-base uppercase tracking-wider transition transform hover:-translate-y-0.5 shadow-xl text-center flex items-center justify-center gap-2">
                            <span>Continuar</span>
                        </button>
                    </div>

                    <div class="p-3 bg-[#0B1A36] border border-blue-500/30 text-cyan-300 rounded-xl text-xs flex items-center gap-2.5">
                        <span class="text-sm">ℹ</span>
                        <span class="text-[11px] font-medium leading-tight">
                            El costo del envío se calculará en el próximo paso
                        </span>
                    </div>

                    <div class="pt-1 text-center">
                        <a href="/catalogo" class="text-xs text-slate-400 hover:text-cyan-300 font-bold transition underline decoration-slate-600 hover:decoration-cyan-400">
                            Seguir comprando
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VISTA PASO 3: ENTREGA (IDÉNTICO A LA IMAGEN ADJUNTA media_1789697711492.png) -->
    <!-- ========================================================================= -->
    <div id="vista-paso-3" class="<%= pasoActual === 3 ? '' : 'hidden' %>">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- COLUMNA IZQUIERDA: MI DIRECCIÓN & OPCIONES DE ENTREGA -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Encabezado "Mi dirección" + Enlace "Elegir otra dirección" -->
                <div class="flex items-center justify-between">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-display">
                        Mi dirección
                    </h1>
                    <button type="button" onclick="toggleSelectorDirecciones()" class="text-xs sm:text-sm font-bold text-slate-300 hover:text-pink-400 transition underline flex items-center gap-1">
                        <span>Elegir otra dirección</span>
                        <span id="chevron-direccion" class="text-xs"><%= direccionesInicialmenteAbierto ? '⌃' : '⌵' %></span>
                    </button>
                </div>

                <!-- Tarjeta de Dirección Actual (Modo colapsado) -->
                <div id="panel-direccion-simple" class="<%= direccionesInicialmenteAbierto ? 'hidden' : '' %> bg-[#0C152E]/90 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-lg flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="text-cyan-400 text-lg">📍</span>
                        <span id="direccion-texto" class="text-sm sm:text-base font-medium text-slate-200">
                            JR. Joaquin Capella 531 531, 1, San Martín de Porres
                        </span>
                    </div>
                    <span class="text-xs text-slate-500 font-mono hidden sm:inline-block">Lima, PE</span>
                </div>

                <!-- Panel Selector de Direcciones (Modo expandido - IDÉNTICO A media_1789698185958.png) -->
                <div id="panel-selector-direcciones" class="<%= direccionesInicialmenteAbierto ? '' : 'hidden' %> bg-[#0C152E]/90 border border-slate-800 rounded-3xl p-6 sm:p-7 shadow-xl space-y-5">
                    <div>
                        <h2 class="text-sm sm:text-base font-extrabold text-white">
                            Elige dónde quieres recibir tu compra
                        </h2>
                        <button type="button" onclick="abrirModalNuevaDireccion()" class="text-xs sm:text-sm text-slate-400 hover:text-pink-400 underline font-semibold mt-1 inline-block transition">
                            Agregar nueva dirección
                        </button>
                    </div>

                    <!-- Cuadrícula de Direcciones Guardadas -->
                    <div id="lista-direcciones-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Card 1: Joaquin Capella 531 (Seleccionada) -->
                        <div id="addr-card-1" onclick="seleccionarDireccion(1, 'Joaquin Capella 531', 'JR. Joaquin Capella 531 531, 1, San Martin de Porres, Lima.')" class="addr-card border-2 border-pink-500 bg-[#070D1E] rounded-2xl p-4 sm:p-5 shadow-lg transition cursor-pointer relative group">
                            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 mb-3">
                                <div class="flex items-center gap-2.5">
                                    <div id="addr-radio-1" class="addr-radio w-4 h-4 rounded-full border-2 border-pink-500 flex items-center justify-center p-0.5 shrink-0">
                                        <div class="w-2 h-2 rounded-full bg-pink-500"></div>
                                    </div>
                                    <span class="addr-alias text-xs sm:text-sm font-extrabold text-white">Joaquin Capella 531</span>
                                </div>
                                <div class="flex items-center gap-2 text-slate-500">
                                    <button type="button" onclick="editarDireccion(1, event)" class="hover:text-cyan-400 transition p-1" title="Editar dirección">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                    </button>
                                    <button type="button" onclick="eliminarDireccion(1, event)" class="hover:text-rose-400 transition p-1" title="Eliminar dirección">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="addr-text text-xs text-slate-400 pl-6.5 font-medium leading-relaxed">
                                JR. Joaquin Capella 531 531, 1, San Martin de Porres, Lima.
                            </div>
                        </div>

                        <!-- Card 2: Santa Luisa de Marillac c18 -->
                        <div id="addr-card-2" onclick="seleccionarDireccion(2, 'Santa Luisa de Marillac c18', 'Urb. Santa Luisa de Marillac C18 18, 1, Pisco, Ica.')" class="addr-card border border-slate-800 hover:border-slate-700 bg-[#070D1E]/60 rounded-2xl p-4 sm:p-5 transition cursor-pointer relative group">
                            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 mb-3">
                                <div class="flex items-center gap-2.5">
                                    <div id="addr-radio-2" class="addr-radio w-4 h-4 rounded-full border-2 border-slate-600 flex items-center justify-center p-0.5 shrink-0">
                                        <div class="w-2 h-2 rounded-full bg-transparent"></div>
                                    </div>
                                    <span class="addr-alias text-xs sm:text-sm font-extrabold text-white">Santa Luisa de Marillac c18</span>
                                </div>
                                <div class="flex items-center gap-2 text-slate-500">
                                    <button type="button" onclick="editarDireccion(2, event)" class="hover:text-cyan-400 transition p-1" title="Editar dirección">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                    </button>
                                    <button type="button" onclick="eliminarDireccion(2, event)" class="hover:text-rose-400 transition p-1" title="Eliminar dirección">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
