<script>
    function filtrarCategoria(cat) {
        // Actualizar pestañas activas
        document.querySelectorAll('.cat-tab').forEach(btn => {
            if (btn.getAttribute('data-tab') === cat) {
                btn.className = 'cat-tab px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-cyan-500/20 text-cyan-300 border border-cyan-400/40';
            } else {
                btn.className = 'cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent';
            }
        });

        // Ocultar / Mostrar caja de filtros específicos de aves
        const filtrosBox = document.getElementById('filtros-aves-box');
        if (cat === 'todos' || cat === 'aves') {
            filtrosBox.classList.remove('hidden');
        } else {
            filtrosBox.classList.add('hidden');
        }

        // Filtrar elementos de la cuadrícula
        let visibles = 0;
        document.querySelectorAll('.catalog-item').forEach(item => {
            const itemCat = item.getAttribute('data-categoria');
            if (cat === 'todos' || itemCat === cat) {
                item.classList.remove('hidden');
                visibles++;
            } else {
                item.classList.add('hidden');
            }
        });

        // Actualizar contador
        const counter = document.getElementById('items-counter');
        if (counter) {
            counter.innerText = visibles;
        }
    }

    // Activar pestaña según parámetro URL al cargar
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const catParam = urlParams.get('categoria');
        if (catParam) {
            filtrarCategoria(catParam);
        }
    });
</script>

