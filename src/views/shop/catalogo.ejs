<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8 space-y-8">
    <div class="border-b border-slate-800 pb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
            <span class="text-xs font-bold text-cyan-400 tracking-widest uppercase block mb-1">Marketplace Aviar & Pie de Cría</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white font-display">Catálogo Comercial Unificado</h2>
            <p class="text-sm text-slate-400 mt-1">Explora ejemplares con genética certificada, kits de iniciación, nutrición y accesorios para criadores</p>
        </div>
        <div class="text-xs text-slate-400 font-medium">
            <span id="items-counter" class="text-cyan-300 font-bold"><%= aves.length + 12 %></span> artículos encontrados
        </div>
    </div>

    <!-- PESTAÑAS DE CATEGORÍA MULTI-RUBRO -->
    <div class="overflow-x-auto pb-2">
        <div class="flex items-center gap-2 p-1.5 bg-[#0C152E]/90 border border-slate-800 rounded-2xl w-max">
            <button type="button" onclick="filtrarCategoria('todos')" data-tab="todos" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-cyan-500/20 text-cyan-300 border border-cyan-400/40">
                <span>🌐 Todos</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-300"><%= aves.length + 12 %></span>
            </button>
            <button type="button" onclick="filtrarCategoria('aves')" data-tab="aves" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent">
                <span>🦜 Aves con Pedigrí</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-400"><%= aves.length %></span>
            </button>
            <button type="button" onclick="filtrarCategoria('kits')" data-tab="kits" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent">
                <span>🎁 Kits de Bienvenida</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-400">3</span>
            </button>
            <button type="button" onclick="filtrarCategoria('alimentos')" data-tab="alimentos" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent">
                <span>🌾 Semillas & Alimentos</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-400">3</span>
            </button>
            <button type="button" onclick="filtrarCategoria('suplementos')" data-tab="suplementos" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent">
                <span>🧪 Vitaminas & Salud</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-400">3</span>
            </button>
            <button type="button" onclick="filtrarCategoria('accesorios')" data-tab="accesorios" class="cat-tab px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition flex items-center gap-2 border border-transparent">
                <span>🪵 Accesorios & Forrajeo</span>
                <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-[#070D1E] text-slate-400">3</span>
            </button>
        </div>
    </div>

    <!-- Filtros Tecnológicos para Aves -->
    <div id="filtros-aves-box" class="bg-[#0C152E]/90 shadow-2xl rounded-3xl border border-cyan-500/25 p-6 backdrop-blur-xl">
        <form method="GET" action="/catalogo" class="grid grid-cols-1 gap-4 sm:grid-cols-4 items-end">
            <div>
                <label for="search" class="block text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-1.5">Buscar por Anilla / Código</label>
                <input type="text" name="search" id="search" value="<%= query.search || '' %>" placeholder="Ej: AVPER-26" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-slate-800 rounded-2xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
            </div>
            <div>
                <label for="sexo" class="block text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-1.5">Sexo</label>
                <select name="sexo" id="sexo" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-slate-800 rounded-2xl text-sm text-white focus:outline-none focus:border-cyan-400 cursor-pointer">
                    <option value="" class="bg-[#080E1E] text-white">Todos los sexos</option>
                    <option value="M" <%= query.sexo === 'M' ? 'selected' : '' %> class="bg-[#080E1E] text-white">♂ Macho</option>
                    <option value="F" <%= query.sexo === 'F' ? 'selected' : '' %> class="bg-[#080E1E] text-white">♀ Hembra</option>
                </select>
            </div>
            <div>
                <label for="especie_id" class="block text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-1.5">Especie</label>
                <select name="especie_id" id="especie_id" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-slate-800 rounded-2xl text-sm text-white focus:outline-none focus:border-cyan-400 cursor-pointer">
                    <option value="" class="bg-[#080E1E] text-white">Todas las especies</option>
                    <% especies.forEach(e => { %>
                        <option value="<%= e.id %>" <%= parseInt(query.especie_id) === e.id ? 'selected' : '' %> class="bg-[#080E1E] text-white"><%= e.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="flex items-center space-x-2">
                <button type="submit" class="w-full bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 text-slate-950 py-2.5 rounded-2xl font-bold text-sm shadow-md shadow-cyan-500/20 transition duration-200">
                    Filtrar Aves
                </button>
                <a href="/catalogo" class="w-full bg-[#080E1E] text-center text-slate-400 hover:text-white border border-slate-800 py-2.5 rounded-2xl font-semibold text-sm transition">
                    Limpiar
                </a>
            </div>
        </form>
    </div>

    <!-- GRID DE PRODUCTOS DEL CATÁLOGO -->
    <div id="catalog-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

        <!-- 1. AVES REGISTRADAS EN BASE DE DATOS -->
        <% if (aves && aves.length > 0) { %>
            <% aves.forEach(a => { %>
                <div class="catalog-item group relative bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/50 rounded-3xl overflow-hidden flex flex-col justify-between shadow-xl transition-all duration-300 transform hover:-translate-y-1" data-categoria="aves">
                    <div class="relative w-full h-56 bg-[#070D1E] overflow-hidden flex items-center justify-center border-b border-slate-800">
                        <% if (a.imagenes && a.imagenes.length > 0) { %>
                            <img src="<%= a.imagenes[0].url %>" alt="Ave <%= a.anilla || a.id %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                        <% } else { %>
                            <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 bg-[#070D1E] space-y-2">
                                <span class="text-5xl">🦜</span>
                                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">Sin fotografía</span>
                            </div>
                        <% } %>

                        <!-- Badge Especie -->
                        <div class="absolute top-3 left-3 z-10">
                            <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#080E1E]/90 text-cyan-300 border border-cyan-500/30 backdrop-blur-md">
                                <%= a.especie_nombre %>
                            </span>
                        </div>

                        <!-- Badge Sexo -->
                        <div class="absolute top-3 right-3 z-10">
                            <span class="w-8 h-8 rounded-full bg-[#080E1E]/90 border border-slate-700 flex items-center justify-center text-sm shadow-md">
                                <%= a.sexo === 'M' ? '♂' : (a.sexo === 'F' ? '♀' : '⚪') %>
                            </span>
                        </div>
                    </div>

                    <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <h3 class="text-base font-bold text-white tracking-tight font-display">
                                    <a href="/catalogo/<%= a.id %>" class="hover:text-cyan-400 transition">
                                        <span aria-hidden="true" class="absolute inset-0"></span>
                                        <%= a.anilla || ('Ejemplar #' + a.id) %>
                                    </a>
                                </h3>
                                <span class="text-[10px] text-slate-400 font-mono">#<%= a.id %></span>
                            </div>

                            <!-- Mutaciones -->
                            <% if (a.mutaciones && a.mutaciones.length > 0) { %>
                                <div class="mt-2.5 flex flex-wrap gap-1.5">
                                    <% a.mutaciones.forEach(m => { %>
                                        <span class="px-2 py-0.5 rounded-md bg-cyan-950/60 text-[10px] font-bold text-cyan-300 border border-cyan-800/40">
                                            <%= m.nombre %>
                                        </span>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <div class="mt-2 text-[11px] text-slate-500 italic">Clásico / Ancestral</div>
                            <% } %>
                        </div>

                        <div class="pt-4 border-t border-slate-800/80 flex justify-between items-center">
                            <% if (a.estado_biologico === 'EN_VENTA' && a.estado_comercial !== 'RESERVADA') { %>
                                <div>
                                    <span class="text-[10px] text-slate-400 block uppercase font-semibold">Precio</span>
                                    <span class="text-lg font-black text-white font-display">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                </div>
                                <span class="text-xs font-bold text-cyan-300 bg-cyan-950/60 border border-cyan-500/40 px-2.5 py-1 rounded-full">
                                    ● En Venta
                                </span>
                            <% } else if (a.estado_comercial === 'RESERVADA') { %>
                                <div>
                                    <span class="text-[10px] text-slate-400 block uppercase font-semibold">Precio</span>
                                    <span class="text-base font-bold text-slate-400">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                </div>
                                <span class="text-xs font-bold text-yellow-300 bg-yellow-950/60 border border-yellow-500/30 px-2.5 py-1 rounded-full">
                                    ⏰ Reservado
                                </span>
                            <% } else if (a.estado_biologico === 'VENDIDO') { %>
                                <div>
                                    <span class="text-[10px] text-slate-400 block uppercase font-semibold">Precio</span>
                                    <span class="text-sm font-bold text-slate-400 line-through"><%= a.precio_venta ? 'S/. ' + parseFloat(a.precio_venta).toFixed(2) : 'Vendido' %></span>
                                </div>
                                <span class="text-xs font-bold text-purple-300 bg-purple-950/60 border border-purple-500/30 px-2.5 py-1 rounded-full">
                                    ✓ Vendido
                                </span>
                            <% } else { %>
                                <span class="text-xs text-slate-500 italic">Aviario LPR</span>
                                <span class="text-xs font-semibold text-blue-300 bg-blue-950/60 border border-blue-500/30 px-2.5 py-1 rounded-full">
                                    Solo Exhibición
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <!-- 2. KITS DE BIENVENIDA (INTEGRADOS DESDE LA HOME) -->
        <!-- Kit 1 -->
        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="kits">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🌾
                </div>
                <span class="text-[10px] font-bold text-teal-300 uppercase tracking-widest block mb-1">Kit Nutrición</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Mezcla Semillas Premium (1 kg)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Mezcla ventilada 0% polvo con alpiste canadiense, mijo blanco, perilla y chía para mantenimiento y brillo del plumaje.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 35.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <!-- Kit 2 -->
        <div class="catalog-item bg-[#0C152E]/90 border border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition glow-cyan-sm" data-categoria="kits">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🧪
                </div>
                <span class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-1">Kit Suplementación</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Pack Vitaminas & Calcio Orgánico</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Complejo multivitamínico con aminoácidos esenciales y bloque mineral de ostra para época de muda y preparación reproductiva.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-cyan-300 font-display">S/. 45.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-400 hover:bg-cyan-300 text-slate-950 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <!-- Kit 3 -->
        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="kits">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🪵
                </div>
                <span class="text-[10px] font-bold text-amber-300 uppercase tracking-widest block mb-1">Kit Enriquecimiento</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Pack Forrajeo & Estimulación</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Perchas ergonómicas de ramas naturales y juguetes de madera sin tintes químicos para ejercitar patas y pico saludablemente.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 40.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <!-- 3. ALIMENTOS & SEMILLAS -->
        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="alimentos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🥣
                </div>
                <span class="text-[10px] font-bold text-teal-400 uppercase tracking-widest block mb-1">Semillas Puras</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Alpiste Canadiense Ventilado (1 kg)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Granos seleccionados con triple aspiración de polvo, base indispensable para la dieta diaria de pericos australianos e ingleses.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 22.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="alimentos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🌽
                </div>
                <span class="text-[10px] font-bold text-teal-400 uppercase tracking-widest block mb-1">Semillas Puras</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Mijo Blanco Extra Seleccionado (1 kg)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Mijo blanco de alta digestibilidad con alto contenido de carbohidratos saludables para pichones en fase de destete y voladera.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 18.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="alimentos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🍯
                </div>
                <span class="text-[10px] font-bold text-teal-400 uppercase tracking-widest block mb-1">Crianza & Muda</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Pasta de Cría con Huevo y Miel (500 g)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Fórmula húmeda hiperproteica con aminoácidos ramificados para el embuche natural de los padres a los pichones en nido.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 28.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <!-- 4. VITAMINAS & SALUD PREVENTIVA -->
        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="suplementos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🍏
                </div>
                <span class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-1">Bioseguridad Hídrica</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Vinagre de Sidra de Manzana Crudo (250 ml)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Con 'la madre' intacta y gotero dosificador para acidificar el agua a pH 4.5-5.0 y prevenir megabacterias gastrointestinales.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 25.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="suplementos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
                    🦠
                </div>
                <span class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest block mb-1">Microbiota Aviar</span>
                <h4 class="text-base font-bold text-white font-display mb-1.5">Probiótico Multicepa en Polvo (100 g)</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">
                    Bacterias beneficiosas específicas de psitácidas para restaurar la flora intestinal post-desparasitación o situaciones de estrés.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <div>
                    <span class="text-[10px] text-slate-400 uppercase block font-semibold">Precio</span>
                    <span class="text-lg font-black text-white font-display">S/. 38.00</span>
                </div>
                <button type="button" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-cyan-950 text-cyan-300 border border-cyan-500/30 hover:bg-cyan-900 transition">
                    + Al Carrito
                </button>
            </div>
        </div>

        <div class="catalog-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/40 rounded-3xl p-6 shadow-xl flex flex-col justify-between transition" data-categoria="suplementos">
            <div>
                <div class="w-full h-44 bg-[#070D1E] rounded-2xl flex items-center justify-center text-6xl mb-4 border border-slate-800">
