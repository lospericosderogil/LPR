<script>
    let categoriaActual = 'todos';
    let filtroRapidoActivo = null;

    function desplazarCarrusel(distancia) {
        document.getElementById('carrusel-categorias').scrollBy({ left: distancia, behavior: 'smooth' });
    }

    function filtrarCategoria(cat) {
        categoriaActual = cat;

        // Actualizar apariencia de burbujas circulares
        document.querySelectorAll('.circle-cat-btn').forEach(btn => {
            const circleDiv = btn.querySelector('div');
            if (btn.getAttribute('data-circle') === cat) {
                circleDiv.classList.add('ring-4', 'ring-cyan-400', 'glow-cyan-sm');
                btn.querySelector('span').classList.add('text-cyan-300');
            } else {
                circleDiv.classList.remove('ring-4', 'ring-cyan-400', 'glow-cyan-sm');
                btn.querySelector('span').classList.remove('text-cyan-300');
            }
        });

        aplicarFiltros();
    }

    function toggleFiltroRapido(tipo) {
        const btn = document.getElementById('badge-' + tipo);
        if (filtroRapidoActivo === tipo) {
            filtroRapidoActivo = null;
            btn.classList.remove('bg-cyan-500/20', 'border-cyan-400');
        } else {
            filtroRapidoActivo = tipo;
            document.querySelectorAll('.quick-badge').forEach(b => b.classList.remove('bg-cyan-500/20', 'border-cyan-400'));
            btn.classList.add('bg-cyan-500/20', 'border-cyan-400');
        }
        aplicarFiltros();
    }

    function filtrarListaMutaciones() {
        const query = document.getElementById('buscar-mutacion').value.toLowerCase();
        document.querySelectorAll('.mutation-item').forEach(item => {
            const text = item.innerText.toLowerCase();
            if (text.includes(query)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function aplicarFiltros() {
        const especiesSeleccionadas = Array.from(document.querySelectorAll('.filter-especie:checked')).map(cb => cb.value.toLowerCase());
        const sexosSeleccionados = Array.from(document.querySelectorAll('.filter-sexo:checked')).map(cb => cb.value);
        const mutacionesSeleccionadas = Array.from(document.querySelectorAll('.filter-mutation:checked')).map(cb => cb.value.toLowerCase());
        const precioMin = parseFloat(document.getElementById('precio-min').value) || 0;
        const precioMax = parseFloat(document.getElementById('precio-max').value) || Infinity;

        const switchReserva = document.getElementById('switch-reserva').checked;

        let totalVisibles = 0;

        document.querySelectorAll('.card-item').forEach(card => {
            const cardCat = card.getAttribute('data-categoria');
            const cardEspecie = (card.getAttribute('data-especie') || '').toLowerCase();
            const cardSexo = card.getAttribute('data-sexo');
            const cardMutaciones = (card.getAttribute('data-mutaciones') || '').toLowerCase();
            const cardPrecio = parseFloat(card.getAttribute('data-precio') || 0);

            let visible = true;

            // Filtro por categoría de burbujas circulares
            if (categoriaActual !== 'todos' && cardCat !== categoriaActual) {
                visible = false;
            }

            // Filtro por checkboxes de especies/insumos
            if (visible && especiesSeleccionadas.length > 0) {
                const matchEspecie = especiesSeleccionadas.some(esp => cardEspecie.includes(esp) || cardCat.includes(esp));
                if (!matchEspecie) visible = false;
            }

            // Filtro por sexo
            if (visible && sexosSeleccionados.length > 0) {
                if (!cardSexo || !sexosSeleccionados.includes(cardSexo)) {
                    visible = false;
                }
            }

            // Filtro por mutaciones
            if (visible && mutacionesSeleccionadas.length > 0) {
                const matchMut = mutacionesSeleccionadas.some(m => cardMutaciones.includes(m));
                if (!matchMut) visible = false;
            }

            // Filtro por rango de precio
            if (visible) {
                if (cardPrecio < precioMin || cardPrecio > precioMax) {
                    visible = false;
                }
            }

            // Filtro rápido de reserva
            if (visible && (switchReserva || filtroRapidoActivo === 'reserva')) {
                if (cardCat !== 'aves') visible = false;
            }

            if (visible) {
                card.classList.remove('hidden');
                totalVisibles++;
            } else {
                card.classList.add('hidden');
            }
        });

        // Actualizar contador
        const counter = document.getElementById('catalogo-total-count');
        if (counter) counter.innerText = totalVisibles;

        // Mostrar u ocultar mensaje vacío
        const noResults = document.getElementById('no-results-msg');
        if (noResults) {
            if (totalVisibles === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
            }
        }
    }

    function ordenarProductos(criterio) {
        const grid = document.getElementById('product-grid');
        const cards = Array.from(grid.querySelectorAll('.card-item'));

        cards.sort((a, b) => {
            const precioA = parseFloat(a.getAttribute('data-precio') || 0);
            const precioB = parseFloat(b.getAttribute('data-precio') || 0);

            if (criterio === 'precio-asc') return precioA - precioB;
            if (criterio === 'precio-desc') return precioB - precioA;
            return 0; // Recomendados / default
        });

        cards.forEach(card => grid.appendChild(card));
    }

    function limpiarTodosFiltros() {
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        document.getElementById('precio-min').value = '';
        document.getElementById('precio-max').value = '';
        document.getElementById('buscar-mutacion').value = '';
        filtrarListaMutaciones();
        filtroRapidoActivo = null;
        document.querySelectorAll('.quick-badge').forEach(b => b.classList.remove('bg-cyan-500/20', 'border-cyan-400'));
        filtrarCategoria('todos');
    }

    function agregarItemCarrito(nombreProducto) {
        const toast = document.getElementById('toast-cart');
        const nameSpan = document.getElementById('toast-product-name');
        nameSpan.innerText = nombreProducto + ' se añadió al carrito.';
        toast.classList.remove('translate-y-24', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-24', 'opacity-0');
        }, 3000);
    }

    // Al cargar la página, revisar parámetro URL
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const cat = urlParams.get('categoria');
        if (cat) {
            filtrarCategoria(cat);
        } else {
            filtrarCategoria('todos');
        }
    });
</script>

