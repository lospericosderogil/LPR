<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8 space-y-8">

    <!-- 1. CARRUSEL SUPERIOR DE CATEGORÍAS CIRCULARES (ESTILO RETAIL MODERNO) -->
    <div class="relative bg-[#0C152E]/70 p-4 sm:p-6 rounded-3xl border border-cyan-500/20 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center justify-between gap-2 sm:gap-4">
            <!-- Botón Izquierdo Carrusel -->
            <button type="button" onclick="desplazarCarrusel(-200)" class="w-9 h-9 rounded-full bg-[#080E1E] border border-cyan-500/30 text-cyan-300 hover:text-white hover:border-cyan-400 flex items-center justify-center shrink-0 transition shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            </button>

            <!-- Contenedor Deslizable de Círculos -->
            <div id="carrusel-categorias" class="flex items-center gap-6 sm:gap-8 overflow-x-auto no-scrollbar py-2 px-1 scroll-smooth">
                
                <% if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) { %>
                    <% categorias.forEach(c => { %>
                        <button type="button" onclick="filtrarCategoria('<%= c.slug %>')" data-circle="<%= c.slug %>" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                            <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-cyan-500/40 p-0.5 shadow-md group-hover:border-cyan-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                                <% if (c.imagen) { %>
                                    <img src="<%= c.imagen %>" alt="<%= c.nombre %>" class="w-full h-full object-cover rounded-full">
                                <% } else { %>
                                    <div class="w-full h-full rounded-full bg-[#080E1E] flex items-center justify-center text-3xl">
                                        <%= c.icono || '📦' %>
                                    </div>
                                <% } %>
                            </div>
                            <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition"><%= c.nombre %></span>
                        </button>
                    <% }) %>
                <% } else { %>
                    <!-- Burbuja 1: Todas las Categorías -->
                    <button type="button" onclick="filtrarCategoria('todos')" data-circle="todos" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-gradient-to-tr from-cyan-600 via-teal-500 to-cyan-300 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-200">
                            <div class="w-full h-full rounded-full bg-[#080E1E] flex items-center justify-center text-3xl">
                                🌐
                            </div>
                        </div>
                        <span class="text-xs font-bold text-slate-200 group-hover:text-cyan-300 transition">Todos</span>
                    </button>

                    <!-- Burbuja 2: Aves de Postura -->
                    <button type="button" onclick="filtrarCategoria('aves')" data-circle="aves" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-cyan-500/40 p-0.5 shadow-md group-hover:border-cyan-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                            <img src="/img/cuidado_parental/voladera_vuelo.jpg" alt="Aves de Postura" class="w-full h-full object-cover rounded-full">
                        </div>
                        <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition">Aves de Postura</span>
                    </button>

                    <!-- Burbuja 3: Kits de Bienvenida -->
                    <button type="button" onclick="filtrarCategoria('kits')" data-circle="kits" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-teal-500/40 p-0.5 shadow-md group-hover:border-teal-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                            <img src="/img/cuidado_parental/nido_parental.jpg" alt="Kits de Bienvenida" class="w-full h-full object-cover rounded-full">
                        </div>
                        <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition">Kits de Bienvenida</span>
                    </button>

                    <!-- Burbuja 4: Semillas & Alimentos -->
                    <button type="button" onclick="filtrarCategoria('alimentos')" data-circle="alimentos" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-amber-500/40 p-0.5 shadow-md group-hover:border-amber-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                            <img src="/img/cuidado_parental/nutricion_reproductiva.jpg" alt="Semillas & Alimentos" class="w-full h-full object-cover rounded-full">
                        </div>
                        <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition">Semillas & Alimento</span>
                    </button>

                    <!-- Burbuja 5: Vitaminas & Salud -->
                    <button type="button" onclick="filtrarCategoria('suplementos')" data-circle="suplementos" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-rose-500/40 p-0.5 shadow-md group-hover:border-rose-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                            <img src="/img/salud_preventiva/suplementos_preventivos.jpg" alt="Vitaminas & Suplementos" class="w-full h-full object-cover rounded-full">
                        </div>
                        <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition">Vitaminas & Salud</span>
                    </button>

                    <!-- Burbuja 6: Nidos & Accesorios -->
                    <button type="button" onclick="filtrarCategoria('accesorios')" data-circle="accesorios" class="circle-cat-btn group flex flex-col items-center gap-2.5 shrink-0 focus:outline-none">
                        <div class="w-18 h-18 sm:w-20 sm:h-20 rounded-full bg-[#070D1E] border-2 border-blue-500/40 p-0.5 shadow-md group-hover:border-blue-400 group-hover:scale-105 transition-transform duration-200 overflow-hidden">
                            <img src="/img/anillado/anatomia_anilla.jpg" alt="Accesorios & Forrajeo" class="w-full h-full object-cover rounded-full">
                        </div>
                        <span class="text-xs font-bold text-slate-300 group-hover:text-cyan-300 transition">Nidos & Accesorios</span>
                    </button>
                <% } %>

            </div>

            <!-- Botón Derecho Carrusel -->
            <button type="button" onclick="desplazarCarrusel(200)" class="w-9 h-9 rounded-full bg-[#080E1E] border border-cyan-500/30 text-cyan-300 hover:text-white hover:border-cyan-400 flex items-center justify-center shrink-0 transition shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
            </button>
        </div>
    </div>

    <!-- 2. SUB-CABECERA: RESULTADOS + TOGGLES DE ENTREGA RÁPIDA + ORDENAMIENTO -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <!-- Contador de Resultados -->
        <div class="flex items-center gap-2 text-sm text-slate-300 font-medium">
            <span id="catalogo-total-count" class="font-extrabold text-white text-base"><%= aves.length + 12 %></span>
            <span>Resultados en Catálogo Aviar</span>
        </div>

        <!-- Badges / Toggles de Entrega Rápida (Idéntico a la referencia) -->
        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Toggle 1: Reserva 10 min -->
            <button type="button" onclick="toggleFiltroRapido('reserva')" id="badge-reserva" class="quick-badge px-3 py-1.5 rounded-full bg-[#0C152E] border border-pink-500/40 text-pink-300 text-xs font-bold flex items-center gap-1.5 hover:border-pink-400 transition">
                <span>⚡</span>
                <span>Reserva 10 min</span>
            </button>

            <!-- Toggle 2: Despacho a Domicilio -->
            <button type="button" onclick="toggleFiltroRapido('despacho')" id="badge-despacho" class="quick-badge px-3 py-1.5 rounded-full bg-[#0C152E] border border-cyan-500/40 text-cyan-300 text-xs font-bold flex items-center gap-1.5 hover:border-cyan-400 transition">
                <span>🚚</span>
                <span>Despacho a Domicilio</span>
            </button>

            <!-- Toggle 3: Punto de Retiro -->
            <button type="button" onclick="toggleFiltroRapido('retiro')" id="badge-retiro" class="quick-badge px-3 py-1.5 rounded-full bg-[#0C152E] border border-slate-700 text-slate-300 text-xs font-bold flex items-center gap-1.5 hover:border-cyan-400 transition">
                <span>🏢</span>
                <span>Punto de Retiro</span>
            </button>

            <!-- Selector de Ordenamiento -->
            <div class="relative ml-2">
                <select id="ordenar-select" onchange="ordenarProductos(this.value)" class="bg-[#0C152E] border border-slate-700 text-xs font-bold text-slate-200 px-3 py-1.5 rounded-xl focus:outline-none focus:border-cyan-400 cursor-pointer">
                    <option value="recomendados">Recomendados</option>
                    <option value="precio-asc">Menor precio</option>
                    <option value="precio-desc">Mayor precio</option>
                    <option value="recientes">Más recientes</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 3. ESTRUCTURA PRINCIPAL DE 2 COLUMNAS (SIDEBAR FILTROS + GRID DE PRODUCTOS) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- ================= COLUMNA IZQUIERDA: BARRA DE FILTROS ================= -->
        <aside class="lg:col-span-3 space-y-6">
            <div class="bg-[#0C152E]/90 rounded-3xl p-6 border border-cyan-500/20 shadow-2xl space-y-6 sticky top-24">
                
                <!-- Encabezado de Filtros -->
                <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                    <div>
                        <span class="text-[10px] font-black text-cyan-400 uppercase tracking-widest block">Catálogo Oficial</span>
                        <h3 class="text-base font-extrabold text-white flex items-center gap-2">
                            <span>⚙️</span>
                            <span>FILTROS</span>
                        </h3>
                    </div>
                    <button type="button" onclick="limpiarTodosFiltros()" class="text-[11px] font-bold text-cyan-400 hover:text-cyan-300 underline">
                        Limpiar
                    </button>
                </div>

                <!-- SECCIÓN 1: MODALIDAD DE ENTREGA (CON TOGGLES/SWITCHES) -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-extrabold text-white">Modalidad de Entrega</span>
                        <span class="px-1.5 py-0.5 text-[9px] font-black uppercase bg-pink-500/20 text-pink-300 border border-pink-500/40 rounded">Nuevo</span>
                    </div>

                    <!-- Toggle 1 -->
                    <label class="flex items-center justify-between p-2.5 rounded-xl bg-[#070D1E] border border-slate-800 hover:border-cyan-500/30 cursor-pointer transition">
                        <span class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                            <span class="text-pink-400">⚡</span> Reserva 10 min
                        </span>
                        <input type="checkbox" id="switch-reserva" onchange="aplicarFiltros()" class="w-4 h-4 rounded text-cyan-500 focus:ring-0 bg-[#0C152E] border-slate-700">
                    </label>

                    <!-- Toggle 2 -->
                    <label class="flex items-center justify-between p-2.5 rounded-xl bg-[#070D1E] border border-slate-800 hover:border-cyan-500/30 cursor-pointer transition">
                        <span class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                            <span class="text-cyan-400">🚚</span> Despacho a domicilio
                        </span>
                        <input type="checkbox" id="switch-despacho" onchange="aplicarFiltros()" class="w-4 h-4 rounded text-cyan-500 focus:ring-0 bg-[#0C152E] border-slate-700">
                    </label>

                    <!-- Toggle 3 -->
                    <label class="flex items-center justify-between p-2.5 rounded-xl bg-[#070D1E] border border-slate-800 hover:border-cyan-500/30 cursor-pointer transition">
                        <span class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                            <span class="text-teal-400">🏢</span> Punto de retiro
                        </span>
                        <input type="checkbox" id="switch-retiro" onchange="aplicarFiltros()" class="w-4 h-4 rounded text-cyan-500 focus:ring-0 bg-[#0C152E] border-slate-700">
                    </label>
                </div>

                <!-- SECCIÓN 2: ESPECIES & CATEGORÍAS -->
                <div class="space-y-3 pt-3 border-t border-slate-800">
                    <span class="text-xs font-extrabold text-white block">Especies & Insumos</span>
                    <div class="space-y-2 text-xs text-slate-300">
                        <label class="flex items-center justify-between cursor-pointer hover:text-white transition">
                            <span class="flex items-center gap-2">
                                <input type="checkbox" value="australiano" onchange="aplicarFiltros()" class="filter-especie w-3.5 h-3.5 rounded text-cyan-500 bg-[#070D1E] border-slate-700">
                                <span>Perico Australiano</span>
                            </span>
                            <span class="text-[10px] text-slate-500 font-mono">12</span>
                        </label>
                        <label class="flex items-center justify-between cursor-pointer hover:text-white transition">
                            <span class="flex items-center gap-2">
                                <input type="checkbox" value="ingles" onchange="aplicarFiltros()" class="filter-especie w-3.5 h-3.5 rounded text-cyan-500 bg-[#070D1E] border-slate-700">
                                <span>Perico Inglés</span>
                            </span>
                            <span class="text-[10px] text-slate-500 font-mono">6</span>
                        </label>
                        <label class="flex items-center justify-between cursor-pointer hover:text-white transition">
                            <span class="flex items-center gap-2">
                                <input type="checkbox" value="kits" onchange="aplicarFiltros()" class="filter-especie w-3.5 h-3.5 rounded text-teal-500 bg-[#070D1E] border-slate-700">
                                <span>Kits de Bienvenida</span>
                            </span>
                            <span class="text-[10px] text-slate-500 font-mono">3</span>
                        </label>
                        <label class="flex items-center justify-between cursor-pointer hover:text-white transition">
                            <span class="flex items-center gap-2">
                                <input type="checkbox" value="insumos" onchange="aplicarFiltros()" class="filter-especie w-3.5 h-3.5 rounded text-cyan-500 bg-[#070D1E] border-slate-700">
                                <span>Alimentos & Accesorios</span>
                            </span>
                            <span class="text-[10px] text-slate-500 font-mono">9</span>
                        </label>
                    </div>
                </div>

                <!-- SECCIÓN 3: SEXO (PCR MOLECULAR) -->
                <div class="space-y-3 pt-3 border-t border-slate-800">
                    <span class="text-xs font-extrabold text-white block">Sexo Certificado (ADN)</span>
                    <div class="grid grid-cols-2 gap-2 text-xs text-slate-300">
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-[#070D1E] border border-slate-800 cursor-pointer hover:border-cyan-500/30">
                            <input type="checkbox" value="M" onchange="aplicarFiltros()" class="filter-sexo w-3.5 h-3.5 rounded text-cyan-500 bg-[#0C152E] border-slate-700">
                            <span>♂ Macho</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 rounded-xl bg-[#070D1E] border border-slate-800 cursor-pointer hover:border-fuchsia-500/30">
                            <input type="checkbox" value="F" onchange="aplicarFiltros()" class="filter-sexo w-3.5 h-3.5 rounded text-fuchsia-500 bg-[#0C152E] border-slate-700">
                            <span>♀ Hembra</span>
                        </label>
                    </div>
                </div>

                <!-- SECCIÓN 4: MUTACIONES (CON BUSCADOR COMO EN LA REFERENCIA) -->
                <div class="space-y-3 pt-3 border-t border-slate-800">
                    <span class="text-xs font-extrabold text-white block">Mutación / Variedad</span>
                    <!-- Buscador interno de mutaciones -->
                    <div class="relative">
                        <input type="text" id="buscar-mutacion" onkeyup="filtrarListaMutaciones()" placeholder="Buscar mutación..." class="w-full px-3 py-1.5 bg-[#070D1E] border border-slate-800 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400">
                    </div>
                    <!-- Lista de Checkboxes con contadores -->
                    <div id="lista-mutaciones" class="space-y-2 max-h-36 overflow-y-auto pr-1 text-xs text-slate-300">
                        <% if (locals.mutaciones && mutaciones.length > 0) { %>
                            <% mutaciones.forEach(m => { %>
                                <label class="mutation-item flex items-center justify-between cursor-pointer hover:text-white transition">
                                    <span class="flex items-center gap-2">
                                        <input type="checkbox" value="<%= m.nombre %>" onchange="aplicarFiltros()" class="filter-mutation w-3.5 h-3.5 rounded text-cyan-500 bg-[#070D1E] border-slate-700">
                                        <span><%= m.nombre %></span>
                                    </span>
                                    <span class="text-[10px] text-slate-500 font-mono">1</span>
                                </label>
                            <% }) %>
                        <% } else { %>
                            <label class="mutation-item flex items-center justify-between cursor-pointer hover:text-white transition">
                                <span class="flex items-center gap-2"><input type="checkbox" value="Azul Cobalto" onchange="aplicarFiltros()" class="filter-mutation w-3.5 h-3.5 rounded text-cyan-500"> <span>Azul Cobalto</span></span>
                                <span class="text-[10px] text-slate-500">4</span>
                            </label>
                            <label class="mutation-item flex items-center justify-between cursor-pointer hover:text-white transition">
                                <span class="flex items-center gap-2"><input type="checkbox" value="Flavo" onchange="aplicarFiltros()" class="filter-mutation w-3.5 h-3.5 rounded text-cyan-500"> <span>Flavo</span></span>
                                <span class="text-[10px] text-slate-500">2</span>
                            </label>
                            <label class="mutation-item flex items-center justify-between cursor-pointer hover:text-white transition">
                                <span class="flex items-center gap-2"><input type="checkbox" value="Arcoíris" onchange="aplicarFiltros()" class="filter-mutation w-3.5 h-3.5 rounded text-cyan-500"> <span>Arcoíris</span></span>
                                <span class="text-[10px] text-slate-500">3</span>
                            </label>
                        <% } %>
                    </div>
                </div>

                <!-- SECCIÓN 5: RANGO DE PRECIO -->
                <div class="space-y-3 pt-3 border-t border-slate-800">
                    <span class="text-xs font-extrabold text-white block">Rango de Inversión (S/.)</span>
                    <div class="flex items-center gap-2">
                        <input type="number" id="precio-min" onchange="aplicarFiltros()" placeholder="Min" class="w-full px-2.5 py-1.5 bg-[#070D1E] border border-slate-800 rounded-xl text-xs text-white text-center focus:outline-none focus:border-cyan-400">
                        <span class="text-slate-500">-</span>
                        <input type="number" id="precio-max" onchange="aplicarFiltros()" placeholder="Max" class="w-full px-2.5 py-1.5 bg-[#070D1E] border border-slate-800 rounded-xl text-xs text-white text-center focus:outline-none focus:border-cyan-400">
                    </div>
                </div>

            </div>
        </aside>

        <!-- ================= COLUMNA DERECHA: CUADRÍCULA DE PRODUCTOS ================= -->
        <main class="lg:col-span-9 space-y-6">

            <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

                <!-- 1. PRODUCTOS TIPO AVES (PROVENIENTES DE BD) -->
                <% if (aves && aves.length > 0) { %>
                    <% aves.forEach((a, index) => { %>
                        <div class="card-item bg-[#0C152E]/90 border border-slate-800 hover:border-cyan-500/50 rounded-3xl overflow-hidden flex flex-col justify-between shadow-xl transition-all duration-300 transform hover:-translate-y-1 relative group"
                             data-categoria="aves"
                             data-especie="<%= (a.especie_nombre || '').toLowerCase() %>"
                             data-sexo="<%= a.sexo %>"
                             data-mutaciones="<%= (a.mutaciones || []).map(m => m.nombre).join(' ') %>"
                             data-precio="<%= parseFloat(a.precio_venta || 0) %>">
                            
                            <!-- BADGE SUPERIOR ESTILO HOT PRICE (IDÉNTICO A LA REFERENCIA) -->
                            <div class="absolute top-3 left-3 z-20">
                                <span class="px-2.5 py-1 rounded text-[10px] font-black uppercase tracking-wider bg-rose-600 text-white shadow-md">
                                    <%= index % 2 === 0 ? 'GENÉTICA A+' : 'HOT PRICE' %>
                                </span>
                            </div>

                            <!-- FOTOGRAFÍA / VISUAL DEL PRODUCTO -->
                            <div class="relative w-full h-64 bg-[#070D1E] overflow-hidden flex items-center justify-center border-b border-slate-800">
                                <% if (a.imagenes && a.imagenes.length > 0) { %>
                                    <img src="<%= a.imagenes[0].url %>" alt="Ave <%= a.anilla || a.id %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                <% } else { %>
                                    <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 bg-[#070D1E] space-y-2">
                                        <span class="text-6xl group-hover:scale-110 transition duration-300">🦜</span>
                                        <span class="text-[10px] text-slate-500 font-bold uppercase tracking-widest font-mono">AVIPERÚ • ID #<%= a.id %></span>
                                    </div>
                                <% } %>

                                <!-- BADGE FLOTANTE DE ENTREGA EN LA IMAGEN (IGUAL QUE "Recíbelo en 90 min" EN LA REFERENCIA) -->
                                <div class="absolute bottom-3 left-3 bg-[#080E1E]/95 backdrop-blur-md px-3 py-1 rounded-lg border border-cyan-500/30 text-[11px] font-bold text-cyan-300 shadow-md">
                                    <%= a.estado_biologico === 'EN_VENTA' ? 'Reserva 10 min.' : 'Llega en 24-48h' %>
                                </div>
                            </div>

                            <!-- CUERPO DE LA TARJETA (DATOS, PRECIO, BOTÓN CIRCULAR CARRITO) -->
                            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
                                <div>
                                    <!-- Criador / Marca -->
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-[11px] font-extrabold text-cyan-400 tracking-wider uppercase font-mono">
                                            <%= a.anilla ? 'ANILLA: ' + a.anilla : 'AVIPERÚ • LPR' %>
                                        </span>
                                        <span class="text-xs font-bold <%= a.sexo === 'M' ? 'text-cyan-300' : 'text-pink-300' %>">
                                            <%= a.sexo === 'M' ? '♂ Macho' : '♀ Hembra' %>
                                        </span>
                                    </div>

                                    <!-- Título del Ejemplar -->
                                    <h4 class="text-sm font-extrabold text-white font-display line-clamp-2">
                                        <a href="/catalogo/<%= a.id %>" class="hover:text-cyan-300 transition">
                                            <%= a.especie_nombre || 'Perico Australiano' %> 
                                            <% if (a.mutaciones && a.mutaciones.length > 0) { %>
