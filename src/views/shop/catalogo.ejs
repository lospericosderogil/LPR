<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h2 class="text-3xl font-extrabold tracking-tight text-gray-900">Catálogo</h2>
        <p class="text-sm text-gray-500 mt-1">Explora nuestras aves disponibles para venta y exhibición</p>
    </div>

    <!-- Filtros -->
    <div class="bg-white shadow rounded-lg border border-gray-150 p-6 mb-8">
        <form method="GET" action="/catalogo" class="grid grid-cols-1 gap-4 sm:grid-cols-4">
            <div>
                <label for="search" class="block text-xs font-semibold text-gray-500 capitalize">Buscar</label>
                <input type="text" name="search" id="search" value="<%= query.search || '' %>" placeholder="Anilla o Código" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
            </div>
            <div>
                <label for="sexo" class="block text-xs font-semibold text-gray-500 capitalize">Sexo</label>
                <select name="sexo" id="sexo" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                    <option value="">Todos</option>
                    <option value="M" <%= query.sexo === 'M' ? 'selected' : '' %>>Macho</option>
                    <option value="F" <%= query.sexo === 'F' ? 'selected' : '' %>>Hembra</option>
                </select>
            </div>
            <div>
                <label for="especie_id" class="block text-xs font-semibold text-gray-500 capitalize">Especie</label>
                <select name="especie_id" id="especie_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                    <option value="">Todas</option>
                    <% especies.forEach(e => { %>
                        <option value="<%= e.id %>" <%= parseInt(query.especie_id) === e.id ? 'selected' : '' %>><%= e.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="flex items-end space-x-2">
                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold text-sm hover:bg-blue-700">Filtrar</button>
                <a href="/catalogo" class="w-full bg-gray-200 text-center text-gray-700 py-2 rounded-md font-semibold text-sm hover:bg-gray-300">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Catálogo Grid -->
    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
        <% if (aves.length === 0) { %>
            <div class="col-span-full bg-white shadow rounded-lg p-12 text-center text-gray-500 border">
                No se encontraron ejemplares en el catálogo con los filtros seleccionados.
            </div>
        <% } else { %>
            <% aves.forEach(a => { %>
                <div class="group relative bg-white border border-gray-200 rounded-lg overflow-hidden flex flex-col justify-between shadow-sm hover:shadow-md transition">
                    <div class="relative w-full h-56 bg-gray-100 aspect-w-1 aspect-h-1 group-hover:opacity-90">
                        <% if (a.imagenes && a.imagenes.length > 0) { %>
                            <img src="<%= a.imagenes[0].url %>" alt="Ave" class="w-full h-full object-center object-cover">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center text-gray-400 bg-gray-100 text-5xl">🦜</div>
                        <% } %>

                        <!-- Ícono del sexo en la esquina superior derecha -->
                        <% if (a.sexo === 'M' || a.sexo === 'F') { %>
                            <div class="absolute top-2.5 right-2.5 z-10 pointer-events-none">
                                <img src="<%= a.sexo === 'M' ? '/img/sexo-macho.png' : '/img/sexo-hembra.png' %>" 
                                     alt="<%= a.sexo === 'M' ? 'Macho' : 'Hembra' %>" 
                                     title="<%= a.sexo === 'M' ? 'Macho' : 'Hembra' %>" 
                                     class="w-7 h-auto drop-shadow-md">
                            </div>
                        <% } %>
                    </div>
                    <div class="p-4 flex-1 flex flex-col justify-between">
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700">
                                <a href="/catalogo/<%= a.id %>">
                                    <span aria-hidden="true" class="absolute inset-0"></span>
                                    <%= a.anilla || ('Ave #' + a.id) %>
                                </a>
                            </h3>
                            
                            <!-- Especie -->
                            <div class="mt-2">
                                <span class="px-2 py-0.5 rounded-full text-3xs font-semibold bg-gray-150 text-gray-700 capitalize">
                                    <%= a.especie_nombre %>
                                </span>
                            </div>

                            <!-- Mutaciones -->
                            <% if (a.mutaciones && a.mutaciones.length > 0) { %>
                                <div class="mt-3 flex flex-wrap gap-1">
                                    <% a.mutaciones.forEach(m => { %>
                                        <span class="px-1 py-0.5 rounded bg-gray-100 text-3xs text-gray-600 capitalize"><%= m.nombre %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>

                        <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                            <% if (a.estado_biologico === 'EN_VENTA' && a.estado_comercial !== 'RESERVADA') { %>
                                <span class="text-lg font-bold text-blue-600">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                <span class="text-xs font-semibold text-green-700 bg-green-50 border border-green-200 px-2 py-1 rounded">En Venta</span>
                            <% } else if (a.estado_comercial === 'RESERVADA') { %>
                                <span class="text-sm font-bold text-gray-400">S/. <%= parseFloat(a.precio_venta || 0).toFixed(2) %></span>
                                <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded">Reservado</span>
                            <% } else if (a.estado_biologico === 'VENDIDO') { %>
                                <span class="text-xs font-bold text-gray-400 line-through"><%= a.precio_venta ? 'S/. ' + parseFloat(a.precio_venta).toFixed(2) : 'Vendido' %></span>
                                <span class="text-xs font-bold text-purple-700 bg-purple-50 border border-purple-200 px-2 py-1 rounded">✓ Vendido</span>
                            <% } else if (a.estado_biologico === 'INTERCAMBIADO') { %>
                                <span class="text-xs text-gray-500 italic">Intercambiado</span>
                                <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded">Intercambiado</span>
                            <% } else { %>
                                <span class="text-xs text-gray-500 italic">Aviario LPR</span>
                                <span class="text-xs font-semibold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-1 rounded">Solo Exhibición</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
<%- include('../partials/footer') %>
