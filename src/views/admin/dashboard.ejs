<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">Panel de Administración</h2>
            <p class="text-sm text-gray-500 mt-1">Resumen general del criadero</p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <a href="/admin/aves/nuevo" class="ml-3 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                Registrar Ave
            </a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-150 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-blue-500 rounded-md p-3 text-white">🦜</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Total Aves</dt>
                        <dd class="text-2xl font-semibold text-gray-900"><%= stats.total %></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-150 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-green-500 rounded-md p-3 text-white">✔</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Disponibles</dt>
                        <dd class="text-2xl font-semibold text-gray-900"><%= stats.disponibles %></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-150 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-yellow-500 rounded-md p-3 text-white">🛒</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">En Venta</dt>
                        <dd class="text-2xl font-semibold text-gray-900"><%= stats.en_venta %></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-150 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-purple-500 rounded-md p-3 text-white">💰</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Vendidos</dt>
                        <dd class="text-2xl font-semibold text-gray-900"><%= stats.vendidos %></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Shortcuts -->
    <div class="bg-white shadow rounded-lg border border-gray-150 p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Accesos Rápidos</h3>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <a href="/admin/aves" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50">
                <div class="text-2xl mr-4">🗂</div>
                <div>
                    <h4 class="font-semibold text-gray-900">Listado de Aves</h4>
                    <p class="text-xs text-gray-500">Ver, filtrar y editar ejemplares</p>
                </div>
            </a>
            <a href="/admin/parejas" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50">
                <div class="text-2xl mr-4">👩‍❤️‍👨</div>
                <div>
                    <h4 class="font-semibold text-gray-900">Parejas Reproductivas</h4>
                    <p class="text-xs text-gray-500">Gestionar uniones y jaulas</p>
                </div>
            </a>
            <a href="/admin/ventas" class="flex items-center p-4 border border-gray-200 rounded-lg hover:bg-gray-50">
                <div class="text-2xl mr-4">📑</div>
                <div>
                    <h4 class="font-semibold text-gray-900">Pedidos y Clientes</h4>
                    <p class="text-xs text-gray-500">Historial comercial y facturas</p>
                </div>
            </a>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
