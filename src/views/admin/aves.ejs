<%- include('../partials/header') %>
<%- include('./partials/admin_nav', { activeTab: 'aves' }) %>
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 mb-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span>REGISTRO GENERAL DE EJEMPLARES</span>
            </span>
            <h2 class="text-3xl font-extrabold text-white tracking-tight">Inventario de Aves</h2>
            <p class="text-sm text-slate-400 mt-1">Gestión de anillas, mutaciones, pedigrí y disponibilidad en el catálogo</p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <a href="/admin/aves/nuevo" class="inline-flex items-center px-5 py-2.5 rounded-xl shadow-lg text-sm font-bold text-navy-950 bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 transition-all shadow-[0_0_20px_rgba(6,182,212,0.3)]">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Registrar Ave
            </a>
        </div>
    </div>

    <!-- Filters Block -->
    <div class="bg-[#0C152E]/90 backdrop-blur-md rounded-2xl border border-cyan-500/20 p-6 mb-8 shadow-xl">
        <form method="GET" action="/admin/aves" class="grid grid-cols-1 gap-4 sm:grid-cols-5">
            <div>
                <label for="search" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Buscar</label>
                <input type="text" name="search" id="search" value="<%= filters.search || '' %>" placeholder="Número de Anilla" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
            </div>
            <div>
                <label for="sexo" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Sexo</label>
                <select name="sexo" id="sexo" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                    <option value="">Todos</option>
                    <option value="M" <%= filters.sexo === 'M' ? 'selected' : '' %>>Macho</option>
                    <option value="F" <%= filters.sexo === 'F' ? 'selected' : '' %>>Hembra</option>
                    <option value="D" <%= filters.sexo === 'D' ? 'selected' : '' %>>Desconocido</option>
                </select>
            </div>
            <div>
                <label for="especie_id" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Especie</label>
                <select name="especie_id" id="especie_id" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                    <option value="">Todas</option>
                    <% especies.forEach(e => { %>
                        <option value="<%= e.id %>" <%= parseInt(filters.especie_id) === e.id ? 'selected' : '' %>><%= e.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label for="estado_biologico" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Estado</label>
                <select name="estado_biologico" id="estado_biologico" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                    <option value="">Todos</option>
                    <option value="DISPONIBLE" <%= filters.estado_biologico === 'DISPONIBLE' ? 'selected' : '' %>>Disponible</option>
                    <option value="EN_VENTA" <%= filters.estado_biologico === 'EN_VENTA' ? 'selected' : '' %>>En Venta</option>
                    <option value="VENDIDO" <%= filters.estado_biologico === 'VENDIDO' ? 'selected' : '' %>>Vendido</option>
                    <option value="MUERTO" <%= filters.estado_biologico === 'MUERTO' ? 'selected' : '' %>>Muerto</option>
                    <option value="INTERCAMBIADO" <%= filters.estado_biologico === 'INTERCAMBIADO' ? 'selected' : '' %>>Intercambiado</option>
                    <option value="PERDIDO" <%= filters.estado_biologico === 'PERDIDO' ? 'selected' : '' %>>Perdido</option>
                    <option value="DONADO" <%= filters.estado_biologico === 'DONADO' ? 'selected' : '' %>>Donado</option>
                    <option value="OTRO" <%= filters.estado_biologico === 'OTRO' ? 'selected' : '' %>>Otro</option>
                </select>
            </div>
            <div class="flex items-end space-x-2">
                <button type="submit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-navy-950 font-bold py-2.5 rounded-xl text-sm transition shadow-[0_0_15px_rgba(6,182,212,0.3)]">Filtrar</button>
                <a href="/admin/aves" class="w-full bg-[#070D1E] hover:bg-[#0F1D3D] text-center text-slate-300 py-2.5 rounded-xl font-semibold text-sm border border-cyan-900/50 transition">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-[#0C152E]/90 backdrop-blur-md rounded-2xl border border-cyan-500/20 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-cyan-900/30">
                <thead class="bg-[#070D1E]">
                    <tr>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Anilla</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Foto</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Sexo</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Especie</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Mutaciones</th>
                        <th scope="col" class="px-6 py-4 text-left text-xs font-semibold text-cyan-300 uppercase tracking-wider">Estado / Publicación</th>
                        <th scope="col" class="relative px-6 py-4 text-right"><span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Acciones</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-cyan-900/20 text-slate-300">
                    <% if (aves.length === 0) { %>
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-sm text-slate-400">
                                <div class="w-12 h-12 mx-auto rounded-full bg-cyan-950/40 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-xl mb-3">🦜</div>
                                No se encontraron ejemplares registrados con los filtros aplicados.
                            </td>
                        </tr>
                    <% } else { %>
                        <% aves.forEach(a => { %>
                            <tr class="hover:bg-cyan-950/20 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-bold text-white"><%= a.anilla || 'Sin anilla' %></div>
                                    <div class="text-xs text-slate-400 font-mono">ID: #<%= a.id %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (a.imagenes && a.imagenes.length > 0) { %>
                                        <img class="h-11 w-11 rounded-xl object-cover border border-cyan-500/30 shadow-sm" src="<%= a.imagenes[0].url %>" alt="Ave">
                                    <% } else { %>
                                        <div class="h-11 w-11 rounded-xl bg-[#070D1E] border border-cyan-900/50 flex items-center justify-center text-base">🦜</div>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (a.sexo === 'M') { %>
                                        <span class="px-2.5 py-1 inline-flex text-xs font-bold rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                                            ♂ Macho
                                        </span>
                                    <% } else if (a.sexo === 'F') { %>
                                        <span class="px-2.5 py-1 inline-flex text-xs font-bold rounded-full bg-fuchsia-500/15 text-fuchsia-300 border border-fuchsia-500/30">
                                            ♀ Hembra
                                        </span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 inline-flex text-xs font-medium rounded-full bg-slate-800 text-slate-400 border border-slate-700">
                                            ? Desconocido
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300"><%= a.especie_nombre %></td>
                                <td class="px-6 py-4 text-sm">
                                    <% if (a.mutaciones && a.mutaciones.length > 0) { %>
                                        <div class="flex flex-wrap gap-1">
                                            <% a.mutaciones.forEach(m => { %>
                                                <span class="px-2 py-0.5 rounded-md bg-[#070D1E] border border-cyan-900/50 text-2xs font-semibold text-cyan-300 uppercase" title="<%= m.tipo %>">
                                                    <%= m.nombre %> (<%= m.tipo[0] %>)
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <span class="text-xs text-slate-500 italic">Sin mutación</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs space-y-1.5">
                                    <div>
                                        <% 
                                            let estadoBadge = 'bg-slate-800/80 text-slate-300 border-slate-700';
                                            if (a.estado_biologico === 'DISPONIBLE') estadoBadge = 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
                                            else if (a.estado_biologico === 'EN_VENTA') estadoBadge = 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30';
                                            else if (a.estado_biologico === 'VENDIDO') estadoBadge = 'bg-purple-500/15 text-purple-300 border-purple-500/30';
                                            else if (a.estado_biologico === 'MUERTO') estadoBadge = 'bg-red-500/15 text-red-300 border-red-500/30';
                                            else if (a.estado_biologico === 'INTERCAMBIADO') estadoBadge = 'bg-amber-500/15 text-amber-300 border-amber-500/30';
                                            else if (a.estado_biologico === 'PERDIDO') estadoBadge = 'bg-orange-500/15 text-orange-300 border-orange-500/30';
                                            else if (a.estado_biologico === 'DONADO') estadoBadge = 'bg-teal-500/15 text-teal-300 border-teal-500/30';
                                        %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border <%= estadoBadge %>">
                                            <%= a.estado_biologico ? a.estado_biologico.replace('_', ' ') : 'DISPONIBLE' %>
                                        </span>
                                        <% if (a.estado_biologico === 'EN_VENTA' && a.precio_venta) { %>
                                            <span class="ml-1.5 text-xs font-extrabold text-cyan-400 font-mono">S/. <%= parseFloat(a.precio_venta).toFixed(2) %></span>
                                        <% } %>
                                    </div>
                                    <div>
                                        <% if (a.estado_publicacion === 'EXHIBICION') { %>
                                            <span class="inline-flex items-center text-3xs font-semibold text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1 animate-pulse"></span> Publicado en Catálogo
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center text-3xs font-medium text-slate-400 bg-slate-800/60 px-2 py-0.5 rounded-full border border-slate-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-500 mr-1"></span> Privado / No Publicado
                                            </span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                                    <a href="/admin/aves/<%= a.id %>/editar" class="text-cyan-400 hover:text-cyan-300 font-bold transition">Editar</a>
                                    <a href="/admin/aves/<%= a.id %>/genealogia" class="text-teal-400 hover:text-teal-300 font-bold transition">Genealogía</a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
