<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 mb-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span>GESTIÓN DE CRÍA Y LINAJE</span>
            </span>
            <h2 class="text-3xl font-extrabold text-white tracking-tight">Parejas Reproductivas</h2>
            <p class="text-sm text-slate-400 mt-1">Historial genético, jaulas de anidación y uniones activas</p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <a href="/admin/parejas/nuevo" class="inline-flex items-center px-5 py-2.5 rounded-xl shadow-lg text-sm font-bold text-navy-950 bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 transition-all shadow-[0_0_20px_rgba(6,182,212,0.3)]">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Crear Pareja
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-[#0C152E]/90 backdrop-blur-md rounded-2xl border border-cyan-500/20 p-4 mb-8 shadow-xl">
        <div class="flex space-x-3">
            <a href="/admin/parejas" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition <%= !query.activo ? 'bg-cyan-500 text-navy-950 shadow-[0_0_10px_rgba(6,182,212,0.3)]' : 'text-slate-300 hover:bg-cyan-950/40' %>">Todas</a>
            <a href="/admin/parejas?activo=true" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition <%= query.activo === 'true' ? 'bg-cyan-500 text-navy-950 shadow-[0_0_10px_rgba(6,182,212,0.3)]' : 'text-slate-300 hover:bg-cyan-950/40' %>">Activas</a>
            <a href="/admin/parejas?activo=false" class="px-4 py-2 text-xs sm:text-sm font-bold rounded-xl transition <%= query.activo === 'false' ? 'bg-cyan-500 text-navy-950 shadow-[0_0_10px_rgba(6,182,212,0.3)]' : 'text-slate-300 hover:bg-cyan-950/40' %>">Históricas</a>
        </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% if (parejas.length === 0) { %>
            <div class="col-span-full bg-[#0C152E]/90 border border-cyan-500/20 rounded-2xl p-12 text-center text-slate-400">
                <div class="w-12 h-12 mx-auto rounded-full bg-cyan-950/40 border border-cyan-500/20 flex items-center justify-center text-cyan-400 text-xl mb-3">🧬</div>
                No hay parejas reproductivas registradas con el filtro seleccionado.
            </div>
        <% } else { %>
            <% parejas.forEach(p => { %>
                <div class="bg-[#0C152E]/90 rounded-2xl border border-cyan-500/20 overflow-hidden flex flex-col justify-between hover:border-cyan-400/50 transition shadow-xl group">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold border <%= p.activo ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-slate-800 text-slate-400 border-slate-700' %>">
                                <%= p.activo ? '● Activa en Cría' : '○ Desunida' %>
                            </span>
                            <span class="text-xs text-slate-400 font-mono">Unida: <%= new Date(p.fecha_inicio).toLocaleDateString('es') %></span>
                        </div>
                        
                        <div class="flex items-center justify-around bg-[#070D1E] p-4 rounded-xl mb-4 border border-cyan-900/40">
                            <div class="text-center">
                                <span class="text-2xl text-cyan-400">♂</span>
                                <h4 class="font-bold text-white text-sm mt-1"><%= p.macho_anilla ? 'Anilla ' + p.macho_anilla : 'Macho #' + p.macho_id %></h4>
                            </div>
                            <div class="text-cyan-500/60 text-xl font-bold font-mono">✕</div>
                            <div class="text-center">
                                <span class="text-2xl text-fuchsia-400">♀</span>
                                <h4 class="font-bold text-white text-sm mt-1"><%= p.hembra_anilla ? 'Anilla ' + p.hembra_anilla : 'Hembra #' + p.hembra_id %></h4>
                            </div>
                        </div>

                        <div class="space-y-2 text-sm text-slate-300">
                            <% if (p.jaula) { %>
                                <div class="flex items-center justify-between text-xs py-1 border-b border-cyan-950/60">
                                    <span class="text-slate-400">Jaula / Ubicación:</span>
                                    <span class="text-cyan-300 font-semibold"><%= p.jaula %></span>
                                </div>
                            <% } %>
                            <% if (p.nido) { %>
                                <div class="flex items-center justify-between text-xs py-1 border-b border-cyan-950/60">
                                    <span class="text-slate-400">Nido Asignado:</span>
                                    <span class="text-cyan-300 font-semibold"><%= p.nido %></span>
                                </div>
                            <% } %>
                            <% if (p.fecha_fin) { %>
                                <div class="flex items-center justify-between text-xs py-1 border-b border-cyan-950/60">
                                    <span class="text-slate-400">Separada:</span>
                                    <span class="text-slate-300"><%= new Date(p.fecha_fin).toLocaleDateString('es') %></span>
                                </div>
                            <% } %>
                            <% if (p.comentario) { %>
                                <div class="mt-2 text-xs bg-[#070D1E] p-3 rounded-xl text-slate-400 border border-cyan-900/40 italic">
                                    "<%= p.comentario %>"
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <% if (p.activo) { %>
                        <div class="bg-[#070D1E]/80 px-6 py-4 border-t border-cyan-900/40">
                            <button type="button" onclick="openDesunirModal(<%= p.id %>)" class="w-full bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 py-2 rounded-xl font-bold text-sm transition">
                                Separar Pareja
                            </button>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<!-- Modal para Registrar Desunión -->
<div id="desunirModal" class="fixed z-50 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="closeDesunirModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        
        <div class="inline-block align-bottom bg-[#0C152E] rounded-2xl px-6 pt-6 pb-6 text-left overflow-hidden shadow-2xl border border-cyan-500/30 transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <form id="desunirForm" method="POST">
                <h3 class="text-xl font-extrabold text-white mb-2">Separar Pareja</h3>
                <p class="text-xs text-slate-400 mb-5">El registro pasará al historial de cría y los ejemplares quedarán libres para nuevas uniones.</p>
                
                <div class="space-y-4">
                    <div>
                        <label for="fecha_fin" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Fecha de Fin / Separación</label>
                        <input type="date" name="fecha_fin" id="fecha_fin" required class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                    </div>
                    <div>
                        <label for="comentario_fin" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Motivo / Observaciones</label>
                        <textarea name="comentario_fin" id="comentario_fin" rows="3" placeholder="Ej. Fin de temporada, descanso biológico, cambio de pareja" class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"></textarea>
                    </div>
                </div>

                <div class="mt-6 flex justify-end space-x-3">
                    <button type="button" onclick="closeDesunirModal()" class="px-4 py-2.5 border border-slate-700 rounded-xl text-sm font-semibold text-slate-300 bg-[#070D1E] hover:bg-[#0F1D3D] transition">Cancelar</button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-red-600 hover:bg-red-500 shadow-lg shadow-red-600/30 transition">Confirmar Separación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openDesunirModal(id) {
        const form = document.getElementById('desunirForm');
        const input = document.getElementById('fecha_fin');
        const modal = document.getElementById('desunirModal');
        
        if (form && input && modal) {
            form.action = '/admin/parejas/' + id + '/desunir';
            input.value = new Date().toISOString().split('T')[0];
            modal.classList.remove('hidden');
        } else {
            alert('Error interno: Elementos del modal no encontrados en el DOM.');
        }
    }

    function closeDesunirModal() {
        const modal = document.getElementById('desunirModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }
</script>
<%- include('../partials/footer') %>
