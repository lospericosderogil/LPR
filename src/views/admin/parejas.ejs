<%- include('../partials/header') %>
<div class="max-w-7xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="md:flex md:items-center md:justify-between mb-8">
        <div class="flex-1 min-w-0">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl">Parejas Reproductivas</h2>
            <p class="text-sm text-gray-500 mt-1">Historial y uniones activas para cría</p>
        </div>
        <div class="mt-4 flex md:mt-0 md:ml-4">
            <a href="/admin/parejas/nuevo" class="ml-3 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                Crear Pareja
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white shadow rounded-lg border border-gray-150 p-4 mb-8">
        <div class="flex space-x-4">
            <a href="/admin/parejas" class="px-3 py-2 text-sm font-semibold rounded-md <%= !query.activo ? 'bg-blue-100 text-blue-800' : 'text-gray-600 hover:bg-gray-100' %>">Todas</a>
            <a href="/admin/parejas?activo=true" class="px-3 py-2 text-sm font-semibold rounded-md <%= query.activo === 'true' ? 'bg-blue-100 text-blue-800' : 'text-gray-600 hover:bg-gray-100' %>">Activas</a>
            <a href="/admin/parejas?activo=false" class="px-3 py-2 text-sm font-semibold rounded-md <%= query.activo === 'false' ? 'bg-blue-100 text-blue-800' : 'text-gray-600 hover:bg-gray-100' %>">Históricas</a>
        </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% if (parejas.length === 0) { %>
            <div class="col-span-full bg-white shadow rounded-lg p-12 text-center text-gray-500 border">
                No hay parejas reproductivas registradas.
            </div>
        <% } else { %>
            <% parejas.forEach(p => { %>
                <div class="bg-white shadow rounded-lg border border-gray-200 overflow-hidden flex flex-col justify-between">
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-4">
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= p.activo ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                                <%= p.activo ? 'Activa' : 'Desunida' %>
                            </span>
                            <span class="text-xs text-gray-500">Unida el: <%= new Date(p.fecha_inicio).toLocaleDateString('es') %></span>
                        </div>
                        
                        <div class="flex items-center justify-around bg-gray-50 p-4 rounded-lg mb-4">
                            <div class="text-center">
                                <span class="text-2xl">♂</span>
                                <h4 class="font-bold text-gray-900"><%= p.macho_anilla ? 'Anilla ' + p.macho_anilla : 'Macho #' + p.macho_id %></h4>
                            </div>
                            <div class="text-gray-300 text-xl font-bold">X</div>
                            <div class="text-center">
                                <span class="text-2xl text-pink-500">♀</span>
                                <h4 class="font-bold text-gray-900"><%= p.hembra_anilla ? 'Anilla ' + p.hembra_anilla : 'Hembra #' + p.hembra_id %></h4>
                            </div>
                        </div>

                        <div class="space-y-1.5 text-sm">
                            <% if (p.jaula) { %>
                                <div><strong class="text-gray-500">Jaula:</strong> <span class="text-gray-800"><%= p.jaula %></span></div>
                            <% } %>
                            <% if (p.nido) { %>
                                <div><strong class="text-gray-500">Nido:</strong> <span class="text-gray-800"><%= p.nido %></span></div>
                            <% } %>
                            <% if (p.fecha_fin) { %>
                                <div><strong class="text-gray-500">Separada:</strong> <span class="text-gray-800"><%= new Date(p.fecha_fin).toLocaleDateString('es') %></span></div>
                            <% } %>
                            <% if (p.comentario) { %>
                                <div class="mt-2 text-xs bg-yellow-50 p-2 rounded text-gray-600 border border-yellow-100">
                                    <%= p.comentario %>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <% if (p.activo) { %>
                        <div class="bg-gray-50 px-6 py-4 border-t border-gray-100">
                            <button type="button" onclick="openDesunirModal(<%= p.id %>)" class="w-full bg-red-600 text-white py-2 rounded-md font-semibold text-sm hover:bg-red-700">
                                Separar Pareja
                            </button>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<!-- Modal para Registrar Desunión -->
<div id="desunirModal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeDesunirModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        
        <div class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
            <form id="desunirForm" method="POST">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Separar Pareja</h3>
                
                <div class="space-y-4">
                    <div>
                        <label for="fecha_fin" class="block text-sm font-semibold text-gray-700">Fecha de Fin / Separación</label>
                        <input type="date" name="fecha_fin" id="fecha_fin" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                    </div>
                    <div>
                        <label for="comentario_fin" class="block text-sm font-semibold text-gray-700">Motivo / Observaciones</label>
                        <textarea name="comentario_fin" id="comentario_fin" rows="3" placeholder="e.g. Cambio de planes, deceso de ejemplar, descanso" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm"></textarea>
                    </div>
                </div>

                <div class="mt-6 flex justify-end space-x-3">
                    <button type="button" onclick="closeDesunirModal()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancelar</button>
                    <button type="submit" class="px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700">Confirmar Separación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openDesunirModal(id) {
        console.log('openDesunirModal iniciada para ID:', id);
        const form = document.getElementById('desunirForm');
        const input = document.getElementById('fecha_fin');
        const modal = document.getElementById('desunirModal');
        
        console.log('Elementos DOM detectados:', { form: !!form, input: !!input, modal: !!modal });
        
        if (form && input && modal) {
            form.action = '/admin/parejas/' + id + '/desunir';
            input.value = new Date().toISOString().split('T')[0];
            modal.classList.remove('hidden');
            console.log('Clase hidden removida del modal.');
        } else {
            alert('Error interno: Elementos del modal no encontrados en el DOM.');
        }
    }

    function closeDesunirModal() {
        const modal = document.getElementById('desunirModal');
        if (modal) {
            modal.classList.add('hidden');
        }
    }
</script>
<%- include('../partials/footer') %>
