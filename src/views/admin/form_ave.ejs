<%- include('../partials/header') %>
<div class="max-w-4xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-8">
        <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl"><%= ave ? 'Editar Ave: ' + ave.identificador_interno : 'Registrar Nueva Ave' %></h2>
    </div>

    <% if (error) { %>
        <div class="bg-red-50 border-l-4 border-red-400 p-4 text-sm text-red-700 mb-6"><%= error %></div>
    <% } %>

    <form class="space-y-8 bg-white p-8 rounded-lg shadow-md border border-gray-150" method="POST" enctype="multipart/form-data">
        
        <!-- Ficha Básica -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Información Básica</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                <div>
                    <label for="identificador_interno" class="block text-sm font-semibold text-gray-700">Código Interno *</label>
                    <input type="text" name="identificador_interno" id="identificador_interno" value="<%= ave ? ave.identificador_interno : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div>
                    <label for="anilla" class="block text-sm font-semibold text-gray-700">Número de Anilla</label>
                    <input type="text" name="anilla" id="anilla" value="<%= ave ? ave.anilla : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div>
                    <label for="sexo" class="block text-sm font-semibold text-gray-700">Sexo *</label>
                    <select name="sexo" id="sexo" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                        <option value="D" <%= ave && ave.sexo === 'D' ? 'selected' : '' %>>Desconocido</option>
                        <option value="M" <%= ave && ave.sexo === 'M' ? 'selected' : '' %>>Macho</option>
                        <option value="F" <%= ave && ave.sexo === 'F' ? 'selected' : '' %>>Hembra</option>
                    </select>
                </div>
                <div>
                    <label for="especie_id" class="block text-sm font-semibold text-gray-700">Especie *</label>
                    <select name="especie_id" id="especie_id" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                        <% especies.forEach(e => { %>
                            <option value="<%= e.id %>" <%= ave && ave.especie_id === e.id ? 'selected' : '' %>><%= e.nombre %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label for="fecha_nacimiento" class="block text-sm font-semibold text-gray-700">Fecha Nacimiento *</label>
                    <input type="date" name="fecha_nacimiento" id="fecha_nacimiento" value="<%= ave && ave.fecha_nacimiento ? ave.fecha_nacimiento.toISOString().split('T')[0] : '' %>" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div>
                    <label for="fecha_anillado" class="block text-sm font-semibold text-gray-700">Fecha Anillado</label>
                    <input type="date" name="fecha_anillado" id="fecha_anillado" value="<%= ave && ave.fecha_anillado ? ave.fecha_anillado.toISOString().split('T')[0] : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
            </div>
        </div>

        <!-- Genealogía -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Genealogía</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div>
                    <label for="padre_id" class="block text-sm font-semibold text-gray-700">Padre</label>
                    <select name="padre_id" id="padre_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                        <option value="">Ninguno</option>
                        <% machos.forEach(m => { %>
                            <option value="<%= m.id %>" <%= ave && ave.padre_id === m.id ? 'selected' : '' %>><%= m.identificador_interno %> (<%= m.anilla || 'Sin anilla' %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label for="madre_id" class="block text-sm font-semibold text-gray-700">Madre</label>
                    <select name="madre_id" id="madre_id" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                        <option value="">Ninguna</option>
                        <% hembras.forEach(f => { %>
                            <option value="<%= f.id %>" <%= ave && ave.madre_id === f.id ? 'selected' : '' %>><%= f.identificador_interno %> (<%= f.anilla || 'Sin anilla' %>)</option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>

        <!-- Procedencia -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Procedencia</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-4">
                <div class="sm:col-span-1">
                    <label for="procedencia" class="block text-sm font-semibold text-gray-700">Origen *</label>
                    <select name="procedencia" id="procedencia" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm" onchange="toggleProcedenciaFields()">
                        <option value="YO" <%= ave && ave.procedencia === 'YO' ? 'selected' : '' %>>Criado internamente</option>
                        <option value="COMPRA" <%= ave && ave.procedencia === 'COMPRA' ? 'selected' : '' %>>Comprado a tercero</option>
                        <option value="OTRO" <%= ave && ave.procedencia === 'OTRO' ? 'selected' : '' %>>Otro</option>
                    </select>
                </div>
                
                <div class="procedencia-compra hidden sm:col-span-1">
                    <label for="criador_origen" class="block text-sm font-semibold text-gray-700">Criador/Proveedor</label>
                    <input type="text" name="criador_origen" id="criador_origen" value="<%= ave && ave.procedencia_detalles ? ave.procedencia_detalles.criador : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div class="procedencia-compra hidden sm:col-span-1">
                    <label for="costo_compra" class="block text-sm font-semibold text-gray-700">Precio Compra</label>
                    <input type="number" step="0.01" name="costo_compra" id="costo_compra" value="<%= ave && ave.procedencia_detalles ? ave.procedencia_detalles.costo : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div class="procedencia-compra hidden sm:col-span-1">
                    <label for="fecha_compra" class="block text-sm font-semibold text-gray-700">Fecha Compra</label>
                    <input type="date" name="fecha_compra" id="fecha_compra" value="<%= ave && ave.procedencia_detalles ? ave.procedencia_detalles.fecha_compra : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
            </div>
        </div>

        <!-- Genética / Mutaciones -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Genética y Mutaciones</h3>
            <p class="text-xs text-gray-500 mb-4">Marque las mutaciones asociadas e indique si corresponden al Fenotipo (se expresa físicamente) o Genotipo (es portador).</p>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <% mutaciones.forEach(m => { 
                    const assoc = ave && ave.mutaciones ? ave.mutaciones.find(am => am.id === m.id) : null;
                %>
                    <div class="flex items-center justify-between p-3 border rounded-md hover:bg-gray-50">
                        <div class="flex items-center">
                            <input type="checkbox" name="mutaciones[]" value="<%= m.id %>" id="m-<%= m.id %>" <%= assoc ? 'checked' : '' %> class="h-4 w-4 text-blue-600 border-gray-300 rounded" onchange="toggleMutacionTipo(<%= m.id %>)">
                            <label for="m-<%= m.id %>" class="ml-2 text-sm text-gray-900 font-medium"><%= m.nombre %></label>
                        </div>
                        <div class="mut-tipo-container <%= assoc ? '' : 'hidden' %>" id="mut-tipo-<%= m.id %>">
                            <select name="mutaciones_tipo[<%= m.id %>]" class="text-xs border rounded p-1">
                                <option value="FENOTIPO" <%= assoc && assoc.tipo === 'FENOTIPO' ? 'selected' : '' %>>Fenotipo</option>
                                <option value="GENOTIPO" <%= assoc && assoc.tipo === 'GENOTIPO' ? 'selected' : '' %>>Genotipo</option>
                            </select>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Multimedia -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Fotografías (Máximo 2)</h3>
            <div class="space-y-4">
                <input type="file" name="fotos" id="fotos" multiple class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                <p class="text-xs text-gray-400">Tamaño máximo de 2MB por imagen. Formatos: JPG, JPEG, PNG, WEBP.</p>
                
                <% if (ave && ave.imagenes && ave.imagenes.length > 0) { %>
                    <div class="grid grid-cols-2 gap-4 mt-4">
                        <% ave.imagenes.forEach(img => { %>
                            <div class="relative border rounded p-2 bg-gray-50">
                                <img src="<%= img.url %>" class="h-40 w-full object-cover rounded">
                                <div class="mt-2 text-xs flex justify-between items-center">
                                    <span class="font-semibold <%= img.es_principal ? 'text-green-600' : 'text-gray-500' %>">
                                        <%= img.es_principal ? 'Imagen Principal' : 'Secundaria' %>
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Estados y Comercialización -->
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Estados y Comercialización</h3>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-4">
                <div>
                    <label for="estado_biologico" class="block text-sm font-semibold text-gray-700">Estado Biológico *</label>
                    <select name="estado_biologico" id="estado_biologico" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm" onchange="toggleFallecimientoFields()">
                        <option value="DISPONIBLE" <%= ave && ave.estado_biologico === 'DISPONIBLE' ? 'selected' : '' %>>Disponible</option>
                        <option value="VENDIDO" <%= ave && ave.estado_biologico === 'VENDIDO' ? 'selected' : '' %>>Vendido</option>
                        <option value="MUERTO" <%= ave && ave.estado_biologico === 'MUERTO' ? 'selected' : '' %>>Muerto</option>
                        <option value="PERDIDO" <%= ave && ave.estado_biologico === 'PERDIDO' ? 'selected' : '' %>>Perdido</option>
                        <option value="DONADO" <%= ave && ave.estado_biologico === 'DONADO' ? 'selected' : '' %>>Donado</option>
                        <option value="INTERCAMBIADO" <%= ave && ave.estado_biologico === 'INTERCAMBIADO' ? 'selected' : '' %>>Intercambiado</option>
                    </select>
                </div>
                <div>
                    <label for="estado_publicacion" class="block text-sm font-semibold text-gray-700">Publicación Web *</label>
                    <select name="estado_publicacion" id="estado_publicacion" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                        <option value="NO_PUBLICADA" <%= ave && ave.estado_publicacion === 'NO_PUBLICADA' ? 'selected' : '' %>>No Publicada (Oculta)</option>
                        <option value="EXHIBICION" <%= ave && ave.estado_publicacion === 'EXHIBICION' ? 'selected' : '' %>>En Exhibición / Catálogo</option>
                    </select>
                </div>
                <div>
                    <label for="estado_comercial" class="block text-sm font-semibold text-gray-700">Estado Comercial *</label>
                    <select name="estado_comercial" id="estado_comercial" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm" onchange="toggleComercialFields()">
                        <option value="NO_VENTA" <%= ave && ave.estado_comercial === 'NO_VENTA' ? 'selected' : '' %>>No disponible para venta</option>
                        <option value="EN_VENTA" <%= ave && ave.estado_comercial === 'EN_VENTA' ? 'selected' : '' %>>En Venta</option>
                        <option value="RESERVADA" <%= ave && ave.estado_comercial === 'RESERVADA' ? 'selected' : '' %>>Reservada</option>
                    </select>
                </div>
                <div class="comercial-precio hidden">
                    <label for="precio_venta" class="block text-sm font-semibold text-gray-700">Precio de Venta (S/.) *</label>
                    <input type="number" step="0.01" name="precio_venta" id="precio_venta" value="<%= ave ? ave.precio_venta : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
            </div>

            <!-- Fallecimiento fields -->
            <div class="fallecimiento-fields hidden grid grid-cols-1 gap-6 sm:grid-cols-2 mt-6">
                <div>
                    <label for="fecha_fallecimiento" class="block text-sm font-semibold text-gray-700">Fecha de Fallecimiento</label>
                    <input type="date" name="fecha_fallecimiento" id="fecha_fallecimiento" value="<%= ave && ave.fecha_fallecimiento ? ave.fecha_fallecimiento.toISOString().split('T')[0] : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm">
                </div>
                <div>
                    <label for="motivo_fallecimiento" class="block text-sm font-semibold text-gray-700">Causa / Diagnóstico</label>
                    <input type="text" name="motivo_fallecimiento" id="motivo_fallecimiento" value="<%= ave ? ave.motivo_fallecimiento : '' %>" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm" placeholder="e.g. Infección intestinal, vejez">
                </div>
            </div>

            <div class="mt-6">
                <label for="observaciones_comerciales" class="block text-sm font-semibold text-gray-700">Notas y Descripción Comercial (E-Commerce)</label>
                <textarea name="observaciones_comerciales" id="observaciones_comerciales" rows="4" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md text-sm"><%= ave ? ave.observaciones_comerciales : '' %></textarea>
            </div>
        </div>

        <div class="pt-5 border-t border-gray-200 flex justify-end space-x-3">
            <a href="/admin/aves" class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancelar</a>
            <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">Guardar Ave</button>
        </div>
    </form>
</div>

<script>
    function toggleProcedenciaFields() {
        const val = document.getElementById('procedencia').value;
        const fields = document.querySelectorAll('.procedencia-compra');
        fields.forEach(el => {
            if (val === 'COMPRA') {
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        });
    }

    function toggleComercialFields() {
        const val = document.getElementById('estado_comercial').value;
        const field = document.querySelector('.comercial-precio');
        if (val === 'EN_VENTA') {
            field.classList.remove('hidden');
            document.getElementById('precio_venta').setAttribute('required', 'required');
        } else {
            field.classList.add('hidden');
            document.getElementById('precio_venta').removeAttribute('required');
        }
    }

    function toggleFallecimientoFields() {
        const val = document.getElementById('estado_biologico').value;
        const fields = document.querySelector('.fallecimiento-fields');
        if (val === 'MUERTO') {
            fields.classList.remove('hidden');
        } else {
            fields.classList.add('hidden');
        }
    }

    function toggleMutacionTipo(id) {
        const checked = document.getElementById('m-' + id).checked;
        const container = document.getElementById('mut-tipo-' + id);
        if (checked) {
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
        }
    }

    // Inicializar visualización en carga
    document.addEventListener('DOMContentLoaded', () => {
        toggleProcedenciaFields();
        toggleComercialFields();
        toggleFallecimientoFields();
    });
</script>
<%- include('../partials/footer') %>
