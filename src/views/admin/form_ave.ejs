<%- include('../partials/header') %>

<style>
    /* Estilos dinámicos para los botones de selección de Sexo */
    .sexo-btn {
        background-color: #070D1E;
        border: 1.5px solid rgba(6, 182, 212, 0.2);
        color: #94A3B8;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        user-select: none;
    }
    .sexo-label:hover .sexo-btn {
        background-color: #0C152E;
        border-color: rgba(6, 182, 212, 0.4);
        color: #E2E8F0;
    }
    /* Macho: Azul/Cian brillante */
    .radio-sexo[value="M"]:checked + .sexo-btn {
        background-color: #06B6D4 !important;
        border-color: #22D3EE !important;
        color: #080E1E !important;
        font-weight: 800 !important;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.4) !important;
    }
    /* Hembra: Magenta/Fucsia brillante */
    .radio-sexo[value="F"]:checked + .sexo-btn {
        background-color: #D946EF !important;
        border-color: #F0ABFC !important;
        color: #080E1E !important;
        font-weight: 800 !important;
        box-shadow: 0 0 15px rgba(217, 70, 239, 0.4) !important;
    }
    /* Desconocido: Slate */
    .radio-sexo[value="D"]:checked + .sexo-btn {
        background-color: #334155 !important;
        border-color: #64748B !important;
        color: #FFFFFF !important;
        font-weight: 800 !important;
    }
</style>

<div class="max-w-6xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <!-- Encabezado de Página -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-cyan-900/40 pb-5">
        <div>
            <div class="flex items-center space-x-3">
                <span class="inline-flex items-center justify-center p-2.5 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded-xl">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                </span>
                <h1 class="text-2xl font-extrabold text-white sm:text-3xl tracking-tight">
                    <%= ave ? 'Editar Ave: ' + (ave.anilla ? 'Anilla ' + ave.anilla : ('ID #' + ave.id)) : 'Registro de Nueva Ave' %>
                </h1>
            </div>
            <p class="mt-1 text-sm text-slate-400 ml-12">Navegue por las pestañas para completar cada bloque de información del ejemplar.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a href="/admin/aves" class="inline-flex items-center px-4 py-2 border border-slate-700 rounded-xl text-sm font-semibold text-slate-300 bg-[#070D1E] hover:bg-[#0F1D3D] transition">
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Volver a la lista
            </a>
        </div>
    </div>

    <% if (error) { %>
        <div class="bg-red-500/15 border-l-4 border-red-500 p-4 rounded-xl shadow-sm mb-6 flex items-start text-red-300">
            <svg class="h-5 w-5 text-red-400 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
            <span class="text-sm font-medium"><%= error %></span>
        </div>
    <% } %>

    <!-- ================================================================= -->
    <!-- BARRA DE NAVEGACIÓN POR PESTAÑAS (TABS) -->
    <!-- ================================================================= -->
    <div class="mb-6 bg-[#0C152E]/90 p-1.5 rounded-2xl shadow-xl border border-cyan-500/20 overflow-x-auto">
        <nav class="flex space-x-1.5 min-w-max" aria-label="Tabs" id="tabs-nav">
            <button type="button" onclick="cambiarPestana(0)" id="tab-btn-0"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all bg-gradient-to-r from-cyan-400 to-teal-400 text-navy-950 shadow-[0_0_15px_rgba(6,182,212,0.35)]">
                <span id="tab-num-0" class="w-5 h-5 rounded-full flex items-center justify-center bg-navy-950 text-cyan-300 mr-2 text-xs font-black">1</span>
                <span>DATOS DE AVE</span>
            </button>
            <button type="button" onclick="cambiarPestana(1)" id="tab-btn-1"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all">
                <span id="tab-num-1" class="w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold">2</span>
                <span>ORIGEN</span>
            </button>
            <button type="button" onclick="cambiarPestana(2)" id="tab-btn-2"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all">
                <span id="tab-num-2" class="w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold">3</span>
                <span>GENÉTICA</span>
            </button>
            <button type="button" onclick="cambiarPestana(3)" id="tab-btn-3"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all">
                <span id="tab-num-3" class="w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold">4</span>
                <span>IMÁGENES</span>
            </button>
            <button type="button" onclick="cambiarPestana(4)" id="tab-btn-4"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all">
                <span id="tab-num-4" class="w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold">5</span>
                <span>APUNTES</span>
            </button>
            <button type="button" onclick="cambiarPestana(5)" id="tab-btn-5"
                class="tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all">
                <span id="tab-num-5" class="w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold">6</span>
                <span>CONCURSOS</span>
            </button>
        </nav>
    </div>

    <form id="form-ave" action="<%= ave ? '/admin/aves/' + ave.id + '/editar' : '/admin/aves/nuevo' %>" class="space-y-6" method="POST" enctype="multipart/form-data">
        
        <!-- ================================================================= -->
        <!-- PESTAÑA 1: BLOQUE 1 - DATOS DE AVE -->
        <!-- ================================================================= -->
        <div id="tab-pane-0" class="tab-pane">
            <div class="bg-[#0C152E]/90 rounded-2xl shadow-xl border border-cyan-500/20 overflow-hidden">
                <div class="bg-[#070D1E] px-6 py-4 border-b border-cyan-500/20 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-cyan-500 text-navy-950 font-black text-sm shadow-sm">1</span>
                        <h2 class="text-lg font-extrabold text-white tracking-wide">DATOS DE AVE</h2>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">Ficha Principal</span>
                </div>
                
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <!-- Número de Anilla / Identificador del Ave -->
                        <div>
                            <label for="anilla" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                Número de Anilla
                            </label>
                            <div class="mt-1 relative rounded-xl shadow-sm">
                                <input type="text" name="anilla" id="anilla" 
                                    value="<%= ave ? ave.anilla || '' : '' %>" 
                                    placeholder="Ej. FOA-24-9842"
                                    class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                            </div>
                            <p class="mt-1 text-xs text-slate-400">Identificador principal del ave. Si no posee, se generará un ID automáticamente.</p>
                        </div>

                        <!-- Especie -->
                        <div>
                            <label for="especie_id" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                Especie <span class="text-red-400">*</span>
                            </label>
                            <select name="especie_id" id="especie_id" required 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                                <% especies.forEach(e => { %>
                                    <option value="<%= e.id %>" <%= ave && ave.especie_id === e.id ? 'selected' : '' %>><%= e.nombre %></option>
                                <% }) %>
                            </select>
                        </div>

                        <!-- Sexo -->
                        <div>
                            <label class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                Sexo <span class="text-red-400">*</span>
                            </label>
                            <div class="grid grid-cols-3 gap-2">
                                <label class="sexo-label cursor-pointer">
                                    <input type="radio" name="sexo" value="M" <%= ave && ave.sexo === 'M' ? 'checked' : '' %> class="sr-only radio-sexo" required>
                                    <div class="sexo-btn flex items-center justify-center p-2.5 rounded-xl text-xs font-bold text-center">
                                        ♂ Macho
                                    </div>
                                </label>
                                <label class="sexo-label cursor-pointer">
                                    <input type="radio" name="sexo" value="F" <%= ave && ave.sexo === 'F' ? 'checked' : '' %> class="sr-only radio-sexo">
                                    <div class="sexo-btn flex items-center justify-center p-2.5 rounded-xl text-xs font-bold text-center">
                                        ♀ Hembra
                                    </div>
                                </label>
                                <label class="sexo-label cursor-pointer">
                                    <input type="radio" name="sexo" value="D" <%= !ave || ave.sexo === 'D' ? 'checked' : '' %> class="sr-only radio-sexo">
                                    <div class="sexo-btn flex items-center justify-center p-2.5 rounded-xl text-xs font-bold text-center">
                                        ? Desc.
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Fecha de Nacimiento -->
                        <div>
                            <label for="fecha_nacimiento" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                Fecha de Nacimiento <span class="text-red-400">*</span>
                            </label>
                            <input type="date" name="fecha_nacimiento" id="fecha_nacimiento" 
                                value="<%= ave && ave.fecha_nacimiento ? (new Date(ave.fecha_nacimiento)).toISOString().split('T')[0] : '' %>" required 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                        </div>

                        <!-- Fecha de Anillado -->
                        <div>
                            <label for="fecha_anillado" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                Fecha de Anillado
                            </label>
                            <input type="date" name="fecha_anillado" id="fecha_anillado" 
                                value="<%= ave && ave.fecha_anillado ? (new Date(ave.fecha_anillado)).toISOString().split('T')[0] : '' %>" 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                        </div>
                    </div>

                    <!-- Subsección Estado con Campos Condicionales -->
                    <div class="pt-4 border-t border-cyan-900/40">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div class="sm:col-span-1">
                                <label for="estado_biologico" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                    Estado del Ejemplar <span class="text-red-400">*</span>
                                </label>
                                <% 
                                    const estadoActual = ave ? ave.estado_biologico : 'DISPONIBLE';
                                    const estadoDet = (ave && ave.estado_detalles) ? ave.estado_detalles : {};
                                %>
                                <select name="estado_biologico" id="estado_biologico" onchange="toggleEstadoCampos()" 
                                    class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-500/40 rounded-xl text-slate-200 text-sm font-semibold focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                                    <option value="DISPONIBLE" <%= estadoActual === 'DISPONIBLE' ? 'selected' : '' %>>1. Disponible</option>
                                    <option value="EN_VENTA" <%= estadoActual === 'EN_VENTA' ? 'selected' : '' %>>2. En Venta</option>
                                    <option value="VENDIDO" <%= estadoActual === 'VENDIDO' ? 'selected' : '' %>>3. Vendido</option>
                                    <option value="MUERTO" <%= estadoActual === 'MUERTO' ? 'selected' : '' %>>4. Muerto</option>
                                    <option value="INTERCAMBIADO" <%= estadoActual === 'INTERCAMBIADO' ? 'selected' : '' %>>5. Intercambiado</option>
                                    <option value="PERDIDO" <%= estadoActual === 'PERDIDO' ? 'selected' : '' %>>6. Perdido</option>
                                    <option value="DONADO" <%= estadoActual === 'DONADO' ? 'selected' : '' %>>7. Donado</option>
                                    <option value="OTRO" <%= estadoActual === 'OTRO' ? 'selected' : '' %>>8. Otro</option>
                                </select>
                            </div>

                            <!-- Contenedor dinámico según estado -->
                            <div class="sm:col-span-2 bg-[#070D1E] p-4 rounded-2xl border border-cyan-900/50">
                                <!-- 1. DISPONIBLE -->
                                <div id="campo-estado-disponible" class="estado-dinamico">
                                    <p class="text-sm text-slate-400 italic">El ejemplar está activo y disponible en el aviario.</p>
                                </div>

                                <!-- 2. EN VENTA -->
                                <div id="campo-estado-en_venta" class="estado-dinamico hidden">
                                    <label for="precio_venta_en_venta" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Precio de Venta (S/.) *</label>
                                    <input type="number" step="0.01" name="precio_venta" id="precio_venta_en_venta" 
                                        value="<%= ave && (estadoActual === 'EN_VENTA' || estadoActual === 'VENDIDO') ? ave.precio_venta || '' : '' %>" 
                                        placeholder="0.00" class="block w-full sm:w-1/2 px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-cyan-300 font-mono text-sm focus:outline-none focus:border-cyan-400 transition">
                                </div>

                                <!-- 3. VENDIDO -->
                                <div id="campo-estado-vendido" class="estado-dinamico hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label for="precio_venta_vendido" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Precio de Venta (S/.) *</label>
                                        <input type="number" step="0.01" id="precio_venta_vendido" 
                                            value="<%= ave && estadoActual === 'VENDIDO' ? ave.precio_venta || '' : '' %>" 
                                            oninput="syncPrecioVendido(this.value)"
                                            placeholder="0.00" class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-cyan-300 font-mono text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="fecha_venta" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Fecha de Venta *</label>
                                        <input type="date" name="fecha_venta" id="fecha_venta" 
                                            value="<%= estadoDet.fecha_venta || '' %>" 
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- 4. MUERTO -->
                                <div id="campo-estado-muerto" class="estado-dinamico hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label for="fecha_fallecimiento" class="block text-xs font-semibold text-red-400 uppercase tracking-wider mb-1.5">Fecha de Muerte *</label>
                                        <input type="date" name="fecha_fallecimiento" id="fecha_fallecimiento" 
                                            value="<%= ave && ave.fecha_fallecimiento ? (new Date(ave.fecha_fallecimiento)).toISOString().split('T')[0] : '' %>" 
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="motivo_fallecimiento" class="block text-xs font-semibold text-red-400 uppercase tracking-wider mb-1.5">Motivo de Muerte *</label>
                                        <input type="text" name="motivo_fallecimiento" id="motivo_fallecimiento" 
                                            value="<%= ave ? ave.motivo_fallecimiento || '' : '' %>" 
                                            placeholder="Ej. Infección respiratoria, edad avanzada"
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- 5. INTERCAMBIADO -->
                                <div id="campo-estado-intercambiado" class="estado-dinamico hidden grid grid-cols-1 sm:grid-cols-3 gap-3">
                                    <div>
                                        <label for="fecha_cambio" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Fecha de Cambio</label>
                                        <input type="date" name="fecha_cambio" id="fecha_cambio" 
                                            value="<%= estadoDet.fecha_cambio || '' %>" 
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="motivo_cambio" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Motivo de Cambio</label>
                                        <input type="text" name="motivo_cambio" id="motivo_cambio" 
                                            value="<%= estadoDet.motivo_cambio || '' %>" 
                                            placeholder="Ej. Renovación de sangre"
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="cambiado_con" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Cambiado Con</label>
                                        <input type="text" name="cambiado_con" id="cambiado_con" 
                                            value="<%= estadoDet.cambiado_con || '' %>" 
                                            placeholder="Ej. Aviario Los Andes"
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- 6. PERDIDO -->
                                <div id="campo-estado-perdido" class="estado-dinamico hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label for="fecha_perdida" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Fecha de Pérdida</label>
                                        <input type="date" name="fecha_perdida" id="fecha_perdida" 
                                            value="<%= estadoDet.fecha_perdida || '' %>" 
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="detalles_perdida" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Detalles de Pérdida</label>
                                        <input type="text" name="detalles_perdida" id="detalles_perdida" 
                                            value="<%= estadoDet.detalles_perdida || '' %>" 
                                            placeholder="Ej. Escape en jaula exterior"
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- 7. DONADO -->
                                <div id="campo-estado-donado" class="estado-dinamico hidden grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label for="fecha_donacion" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Fecha de Donación</label>
                                        <input type="date" name="fecha_donacion" id="fecha_donacion" 
                                            value="<%= estadoDet.fecha_donacion || '' %>" 
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="donado_a" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Donado a</label>
                                        <input type="text" name="donado_a" id="donado_a" 
                                            value="<%= estadoDet.donado_a || '' %>" 
                                            placeholder="Ej. Juan Pérez"
                                            class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- 8. OTRO -->
                                <div id="campo-estado-otro" class="estado-dinamico hidden">
                                    <label for="comentario_otro" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Comentarios sobre el Estado</label>
                                    <textarea name="comentario_otro" id="comentario_otro" rows="2" 
                                        placeholder="Especifique cualquier detalle..."
                                        class="block w-full px-3.5 py-2.5 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition"><%= estadoDet.comentario || '' %></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Subsección Publicación en Catálogo Web / Tienda -->
                    <div class="pt-5 border-t border-cyan-900/40">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-4 bg-gradient-to-r from-cyan-950/40 to-blue-950/40 rounded-2xl border border-cyan-500/30 gap-3">
                            <div class="flex items-start sm:items-center space-x-3">
                                <span class="p-2.5 bg-cyan-500/15 text-cyan-400 rounded-xl shrink-0 mt-0.5 sm:mt-0 border border-cyan-500/20">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </span>
                                <div>
                                    <label for="publicado_web" class="text-sm font-bold text-white cursor-pointer block">Exhibición / Publicación en Catálogo Web</label>
                                    <p id="publicado-help-text" class="text-xs text-slate-400">
                                        <% if (!ave || estadoActual === 'DISPONIBLE') { %>
                                            Solo disponible en registros internos del criadero. Si activa esta opción, se exhibirá en el catálogo como <strong>"Solo Exhibición"</strong>.
                                        <% } else if (estadoActual === 'EN_VENTA') { %>
                                            Habilita el ejemplar para <strong>venta directa</strong> en el catálogo web con su precio.
                                        <% } else if (estadoActual === 'VENDIDO') { %>
                                            Se muestra en el catálogo web como <strong>"Vendido"</strong> durante <strong>10 días</strong> posteriores a la fecha de venta.
                                        <% } else if (estadoActual === 'INTERCAMBIADO') { %>
                                            Se muestra en el catálogo durante <strong>10 días</strong> posteriores a la fecha de intercambio solo si la exhibición está habilitada.
                                        <% } else { %>
                                            No se muestra en el catálogo a menos que habilite explícitamente la opción de exhibición.
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-3 self-end sm:self-auto shrink-0">
                                <% const estaPublicado = ave ? (ave.estado_publicacion === 'EXHIBICION') : false; %>
                                <span id="publicado-status-badge" class="text-xs font-bold px-3 py-1 rounded-full border <%= estaPublicado ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-slate-800 text-slate-400 border-slate-700' %>">
                                    <%= estaPublicado ? '✓ Exhibición Activa' : '🔒 No Publicado' %>
                                </span>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="publicado_web" id="publicado_web" value="1" <%= estaPublicado ? 'checked' : '' %> onchange="actualizarBadgePublicacion(this.checked)" class="sr-only peer">
                                    <div class="w-11 h-6 bg-[#070D1E] border border-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-500 peer-checked:after:bg-navy-950"></div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Botón de navegación al siguiente bloque -->
                    <div class="pt-4 flex justify-end">
                        <button type="button" onclick="cambiarPestana(1)" 
                            class="inline-flex items-center px-5 py-2.5 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold rounded-xl transition text-sm">
                            <span>Siguiente: 2. Origen</span>
                            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================= -->
        <!-- PESTAÑA 2: BLOQUE 2 - ORIGEN -->
        <!-- ================================================================= -->
        <div id="tab-pane-1" class="tab-pane hidden">
            <div class="bg-[#0C152E]/90 rounded-2xl shadow-xl border border-cyan-500/20 overflow-hidden">
                <div class="bg-[#070D1E] px-6 py-4 border-b border-cyan-500/20 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-teal-400 text-navy-950 font-black text-sm shadow-sm">2</span>
                        <h2 class="text-lg font-extrabold text-white tracking-wide">ORIGEN Y GENEALOGÍA</h2>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-teal-500/15 text-teal-300 border border-teal-500/30">Ascendencia</span>
                </div>

                <div class="p-6 space-y-6">
                    <!-- Padres -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <label for="padre_id" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">Padre (Macho)</label>
                            <select name="padre_id" id="padre_id" 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                                <option value="">-- Sin padre registrado / Externo --</option>
                                <% machos.forEach(m => { %>
                                    <option value="<%= m.id %>" <%= ave && ave.padre_id === m.id ? 'selected' : '' %>>
                                        ♂ <%= m.anilla ? 'Anilla: ' + m.anilla : ('Ave #' + m.id) %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div>
                            <label for="madre_id" class="block text-xs font-semibold text-fuchsia-300 uppercase tracking-wider mb-1.5">Madre (Hembra)</label>
                            <select name="madre_id" id="madre_id" 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-fuchsia-400 focus:ring-1 focus:ring-fuchsia-400 transition">
                                <option value="">-- Sin madre registrada / Externa --</option>
                                <% hembras.forEach(f => { %>
                                    <option value="<%= f.id %>" <%= ave && ave.madre_id === f.id ? 'selected' : '' %>>
                                        ♀ <%= f.anilla ? 'Anilla: ' + f.anilla : ('Ave #' + f.id) %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <!-- Procedencia Reactiva -->
                    <div class="pt-4 border-t border-cyan-900/40">
                        <label for="procedencia" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-2">Procedencia del Ave *</label>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <select name="procedencia" id="procedencia" onchange="toggleProcedenciaCampos()" required
                                    class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                                    <option value="YO" <%= !ave || ave.procedencia === 'YO' ? 'selected' : '' %>>1. Yo (Criado internamente)</option>
                                    <option value="COMPRA" <%= ave && ave.procedencia === 'COMPRA' ? 'selected' : '' %>>2. Compra a Tercero</option>
                                    <option value="OTRO" <%= ave && ave.procedencia === 'OTRO' ? 'selected' : '' %>>3. Otro</option>
                                </select>
                            </div>

                            <% 
                                const procDet = (ave && ave.procedencia_detalles) ? ave.procedencia_detalles : {};
                            %>
                            <div class="sm:col-span-2">
                                <!-- Procedencia: COMPRA -->
                                <div id="campo-proc-compra" class="hidden grid grid-cols-1 sm:grid-cols-3 gap-3 bg-[#070D1E] p-4 rounded-xl border border-cyan-900/50">
                                    <div>
                                        <label for="criador_origen_compra" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1">Criador / Proveedor</label>
                                        <input type="text" name="criador_origen" id="criador_origen_compra" 
                                            value="<%= procDet.criador || '' %>" 
                                            placeholder="Ej. Criadero San José"
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="costo_compra" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1">Precio Compra (S/.)</label>
                                        <input type="number" step="0.01" name="costo_compra" id="costo_compra" 
                                            value="<%= procDet.costo || '' %>" 
                                            placeholder="0.00"
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-cyan-300 font-mono text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                    <div>
                                        <label for="fecha_compra" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1">Fecha de Compra</label>
                                        <input type="date" name="fecha_compra" id="fecha_compra" 
                                            value="<%= procDet.fecha_compra || '' %>" 
                                            class="block w-full px-3 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-cyan-400 transition">
                                    </div>
                                </div>

                                <!-- Procedencia: OTRO -->
                                <div id="campo-proc-otro" class="hidden bg-[#070D1E] p-4 rounded-xl border border-cyan-900/50">
                                    <label for="criador_origen_otro" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1">Criador / Contacto</label>
                                    <input type="text" id="criador_origen_otro" 
                                        value="<%= procDet.criador || '' %>" 
                                        oninput="syncCriadorOtro(this.value)"
                                        placeholder="Nombre del criador o procedencia específica"
                                        class="block w-full px-3.5 py-2 bg-[#0C152E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition">
                                </div>

                                <!-- Procedencia: YO -->
                                <div id="campo-proc-yo" class="text-sm text-slate-400 italic p-3">
                                    Ejemplar nacido y criado en nuestras instalaciones.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de navegación -->
                    <div class="pt-4 flex justify-between">
                        <button type="button" onclick="cambiarPestana(0)" 
                            class="inline-flex items-center px-4 py-2.5 border border-slate-700 text-slate-300 font-semibold rounded-xl bg-[#070D1E] hover:bg-[#0F1D3D] transition text-sm">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            <span>Anterior: 1. Datos</span>
                        </button>
                        <button type="button" onclick="cambiarPestana(2)" 
                            class="inline-flex items-center px-5 py-2.5 bg-teal-500/10 hover:bg-teal-500/20 text-teal-300 border border-teal-500/30 font-bold rounded-xl transition text-sm">
                            <span>Siguiente: 3. Genética</span>
                            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================= -->
        <!-- PESTAÑA 3: BLOQUE 3 - GENÉTICA -->
        <!-- ================================================================= -->
        <div id="tab-pane-2" class="tab-pane hidden">
            <div class="bg-[#0C152E]/90 rounded-2xl shadow-xl border border-cyan-500/20 overflow-hidden">
                <div class="bg-[#070D1E] px-6 py-4 border-b border-cyan-500/20 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-purple-500 text-navy-950 font-black text-sm shadow-sm">3</span>
                        <h2 class="text-lg font-extrabold text-white tracking-wide">GENÉTICA Y MUTACIONES</h2>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30">Variedades</span>
                </div>

                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <!-- Genotipo -->
                        <div>
                            <label for="genotipo" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                1. Genotipo (Genes portados / Composición genética)
                            </label>
                            <input type="text" name="genotipo" id="genotipo" 
                                value="<%= ave ? ave.genotipo || '' : '' %>" 
                                placeholder="Ej. Verde / Azul, Ino, Alas Claras" 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                            <p class="mt-1 text-xs text-slate-400">Factores recesivos portados que no se expresan visualmente.</p>
                        </div>

                        <!-- Fenotipo -->
                        <div>
                            <label for="fenotipo" class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider mb-1.5">
                                2. Fenotipo (Color y apariencia física visible)
                            </label>
                            <input type="text" name="fenotipo" id="fenotipo" 
                                value="<%= ave ? ave.fenotipo || '' : '' %>" 
                                placeholder="Ej. Azul Cobalto Cara Amarilla Tipo II" 
                                class="block w-full px-3.5 py-2.5 bg-[#070D1E] border border-cyan-900/60 rounded-xl text-slate-200 text-sm placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition">
                            <p class="mt-1 text-xs text-slate-400">Aspecto fenotípico directo del ejemplar.</p>
                        </div>
                    </div>

                    <!-- Mutaciones registradas -->
                    <div class="pt-4 border-t border-cyan-900/40">
                        <div class="flex items-center justify-between mb-3">
                            <label class="block text-xs font-semibold text-cyan-300 uppercase tracking-wider">
                                3. Lista de Mutaciones Registradas
                            </label>
                            <span class="text-xs text-slate-400">Marque las que correspondan e indique su tipo</span>
                        </div>

                        <% 
                            // Agrupar mutaciones por categoría
                            const mutPorCat = {};
                            mutaciones.forEach(m => {
                                const cat = m.categoria || 'Otras';
                                if (!mutPorCat[cat]) mutPorCat[cat] = [];
                                mutPorCat[cat].push(m);
                            });
                        %>

                        <div class="space-y-5">
                            <% Object.keys(mutPorCat).forEach(cat => { %>
                                <div class="bg-[#070D1E]/70 p-4 rounded-2xl border border-cyan-900/40">
                                    <div class="flex items-center space-x-2 mb-3 pb-1 border-b border-cyan-950/60">
                                        <span class="text-xs font-extrabold uppercase tracking-wider text-purple-300 bg-purple-500/20 px-2.5 py-0.5 rounded-md border border-purple-500/30">
                                            <%= cat %>
                                        </span>
                                        <span class="text-xs text-slate-400 font-medium">(<%= mutPorCat[cat].length %> <%= mutPorCat[cat].length === 1 ? 'variedad' : 'variedades' %>)</span>
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
                                        <% mutPorCat[cat].forEach(m => { 
                                            const assoc = ave && ave.mutaciones ? ave.mutaciones.find(am => am.id === m.id) : null;
                                        %>
                                            <div class="flex items-start justify-between p-3 border border-cyan-900/60 rounded-xl hover:border-cyan-500/40 transition-colors bg-[#0A1227]">
                                                <div class="flex items-start space-x-2 mr-1">
                                                    <input type="checkbox" name="mutaciones[]" value="<%= m.id %>" id="m-<%= m.id %>" 
                                                        <%= assoc ? 'checked' : '' %> 
                                                        onchange="toggleMutacionItem(<%= m.id %>)"
                                                        class="mt-0.5 h-4 w-4 text-cyan-400 bg-[#070D1E] border-cyan-900/60 rounded focus:ring-cyan-400">
                                                    <div>
                                                        <label for="m-<%= m.id %>" class="text-xs font-bold text-white cursor-pointer block leading-tight">
                                                            <%= m.nombre %>
                                                        </label>
                                                        <% if (m.herencia) { %>
                                                            <span class="inline-block mt-1 text-3xs px-1.5 py-0.5 rounded font-bold
                                                                <%= m.herencia.includes('Ligada al Sexo') ? 'bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/30' : 
                                                                   (m.herencia.includes('Recesiva') ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 
                                                                   (m.herencia.includes('Dominante') ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-slate-800 text-slate-400 border border-slate-700')) %>">
                                                                <%= m.herencia %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                <div id="mut-tipo-<%= m.id %>" class="<%= assoc ? '' : 'hidden' %> flex-shrink-0">
                                                    <select name="mutaciones_tipo[<%= m.id %>]" class="text-3xs border border-purple-500/40 rounded-lg px-2 py-1 bg-[#070D1E] text-purple-300 font-bold focus:outline-none">
                                                        <option value="FENOTIPO" <%= assoc && assoc.tipo === 'FENOTIPO' ? 'selected' : '' %>>Fenotipo</option>
                                                        <option value="GENOTIPO" <%= assoc && assoc.tipo === 'GENOTIPO' ? 'selected' : '' %>>Genotipo</option>
                                                    </select>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Botones de navegación -->
                    <div class="pt-4 flex justify-between">
                        <button type="button" onclick="cambiarPestana(1)" 
                            class="inline-flex items-center px-4 py-2.5 border border-slate-700 text-slate-300 font-semibold rounded-xl bg-[#070D1E] hover:bg-[#0F1D3D] transition text-sm">
                            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            <span>Anterior: 2. Origen</span>
                        </button>
                        <button type="button" onclick="cambiarPestana(3)" 
                            class="inline-flex items-center px-5 py-2.5 bg-purple-500/15 hover:bg-purple-500/25 text-purple-300 border border-purple-500/30 font-bold rounded-xl transition text-sm">
                            <span>Siguiente: 4. Imágenes</span>
                            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================================= -->
        <!-- PESTAÑA 4: BLOQUE 4 - IMÁGENES -->
        <!-- ================================================================= -->
        <div id="tab-pane-3" class="tab-pane hidden">
            <div class="bg-[#0C152E]/90 rounded-2xl shadow-xl border border-cyan-500/20 overflow-hidden">
                <div class="bg-[#070D1E] px-6 py-4 border-b border-cyan-500/20 flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-amber-400 text-navy-950 font-black text-sm shadow-sm">4</span>
                        <h2 class="text-lg font-extrabold text-white tracking-wide">FOTOGRAFÍAS (MÁXIMO 2)</h2>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30">Galería</span>
                </div>

                <div class="p-6">
                    <p class="text-xs text-slate-400 mb-5">
                        Permite adjuntar hasta 2 fotos del ejemplar. Puede cambiar cada foto y elegir cuál será la <strong>predeterminada</strong> (portada del catálogo). Formatos: JPG, PNG, WEBP (Máx 2MB c/u).
                    </p>

                    <% 
                        const imgs = (ave && ave.imagenes) ? ave.imagenes : [];
                        const img1 = imgs[0] || null;
                        const img2 = imgs[1] || null;
                    %>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <!-- SLOT FOTO 1 -->
                        <div class="border-2 border-dashed border-cyan-900/60 rounded-2xl p-5 bg-[#070D1E] text-center relative flex flex-col justify-between" id="slot-container-0">
                            <div>
                                <div class="flex justify-between items-center mb-3">
                                    <span class="text-xs font-bold uppercase tracking-wider text-cyan-300">Foto 1</span>
                                    <label class="inline-flex items-center text-xs font-bold text-amber-300 cursor-pointer">
                                        <input type="radio" name="foto_predeterminada" value="<%= img1 ? img1.url : 'nueva_0' %>" 
                                            <%= (img1 && img1.es_principal) || (!img1 && !img2) ? 'checked' : '' %> 
                                            id="radio-pred-0" class="h-4 w-4 text-amber-400 bg-[#0C152E] border-cyan-900/60 focus:ring-amber-400 mr-1.5">
                                        ⭐ Predeterminada
                                    </label>
                                </div>

                                <!-- Preview Área -->
