<!-- SCRIPTS DE PESTAÑAS, ENVÍO AJAX Y DINAMISMO -->
<!-- ================================================================= -->
<script>
    // Control de Pestañas (Tabs)
    function cambiarPestana(index) {
        const panes = document.querySelectorAll('.tab-pane');
        panes.forEach((pane, i) => {
            if (i === index) {
                pane.classList.remove('hidden');
            } else {
                pane.classList.add('hidden');
            }
        });

        const totalTabs = 6;
        for (let i = 0; i < totalTabs; i++) {
            const btn = document.getElementById('tab-btn-' + i);
            const num = document.getElementById('tab-num-' + i);
            if (i === index) {
                btn.className = 'tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-bold rounded-xl transition-all bg-gradient-to-r from-cyan-400 to-teal-400 text-navy-950 shadow-[0_0_15px_rgba(6,182,212,0.35)]';
                num.className = 'w-5 h-5 rounded-full flex items-center justify-center bg-navy-950 text-cyan-300 mr-2 text-xs font-black';
            } else {
                btn.className = 'tab-btn flex items-center px-4 py-2.5 text-xs sm:text-sm font-medium rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-950/30 transition-all';
                num.className = 'w-5 h-5 rounded-full flex items-center justify-center bg-[#070D1E] text-slate-400 border border-cyan-900/40 mr-2 text-xs font-bold';
            }
        }

        const formTop = document.getElementById('tabs-nav');
        if (formTop) {
            formTop.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    }

    // Enviar formulario vía Fetch con Modal de Confirmación
    const form = document.getElementById('form-ave');
    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Validación de campos requeridos a través de pestañas
        if (!this.checkValidity()) {
            const invalidElement = this.querySelector(':invalid');
            if (invalidElement) {
                const pane = invalidElement.closest('.tab-pane');
                if (pane) {
                    const paneId = pane.id;
                    const tabIdx = parseInt(paneId.replace('tab-pane-', ''));
                    cambiarPestana(tabIdx);
                    setTimeout(() => {
                        invalidElement.focus();
                        invalidElement.reportValidity();
                    }, 150);
                }
            }
            return;
        }

        const submitBtn = document.getElementById('btn-submit-form');
        const submitText = document.getElementById('btn-submit-text');
        const originalContent = submitBtn.innerHTML;

        submitBtn.disabled = true;
        submitBtn.innerHTML = `
            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            Guardando...
        `;

        try {
            const formData = new FormData(form);
            const targetUrl = form.getAttribute('action') || window.location.pathname;

            const response = await fetch(targetUrl, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: formData
            });

            const data = await response.json().catch(() => ({}));

            if (response.ok && data.success) {
                mostrarModalGuardado(data.isEdit, data.anilla || data.aveId);
            } else {
                alert('Error al guardar: ' + (data.message || 'Ocurrió un error inesperado al procesar la solicitud.'));
            }
        } catch (err) {
            console.error('Error de envío:', err);
            if (confirm('Hubo una incidencia de conexión con el envío asíncrono.\n\n¿Desea guardar enviando la información directamente?')) {
                form.submit();
                return;
            }
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalContent;
        }
    });

    // Control del Modal de Éxito
    function mostrarModalGuardado(isEdit, referencia) {
        const modal = document.getElementById('modal-guardado');
        const titulo = document.getElementById('modal-titulo');
        const mensaje = document.getElementById('modal-mensaje');
        const btnSecundario = document.getElementById('modal-btn-secundario');

        if (isEdit) {
            titulo.textContent = '¡Ave Actualizada con Éxito!';
            mensaje.textContent = `Los datos del ejemplar (${referencia ? 'Anilla/ID: ' + referencia : ''}) han sido actualizados correctamente.`;
            btnSecundario.textContent = 'Continuar Editando';
        } else {
            titulo.textContent = '¡Ave Registrada con Éxito!';
            mensaje.textContent = `El nuevo ejemplar (${referencia ? 'Anilla/ID: ' + referencia : ''}) fue registrado exitosamente en el sistema.`;
            btnSecundario.textContent = 'Registrar Otra Ave';
        }

        modal.classList.remove('hidden');
    }

    function cerrarModalGuardado() {
        const modal = document.getElementById('modal-guardado');
        modal.classList.add('hidden');
        
        // Si estábamos en modo registro nuevo, refrescamos a un formulario limpio
        if (!window.location.pathname.includes('/editar')) {
            window.location.href = '/admin/aves/nuevo';
        }
    }

    // 1. Dinamismo de Estado
    function toggleEstadoCampos() {
        const estado = document.getElementById('estado_biologico').value;
        const dinamicos = document.querySelectorAll('.estado-dinamico');
        dinamicos.forEach(el => el.classList.add('hidden'));

        const mapa = {
            'DISPONIBLE': 'campo-estado-disponible',
            'EN_VENTA': 'campo-estado-en_venta',
            'VENDIDO': 'campo-estado-vendido',
            'MUERTO': 'campo-estado-muerto',
            'INTERCAMBIADO': 'campo-estado-intercambiado',
            'PERDIDO': 'campo-estado-perdido',
            'DONADO': 'campo-estado-donado',
            'OTRO': 'campo-estado-otro'
        };

        const targetId = mapa[estado] || 'campo-estado-disponible';
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
            targetEl.classList.remove('hidden');
        }

        const inputPrecioEnVenta = document.getElementById('precio_venta_en_venta');
        if (estado === 'EN_VENTA') {
            inputPrecioEnVenta.setAttribute('required', 'required');
        } else {
            inputPrecioEnVenta.removeAttribute('required');
        }

        const helpText = document.getElementById('publicado-help-text');
        if (helpText) {
            const mensajesAyuda = {
                'DISPONIBLE': 'Solo disponible en registros internos del criadero. Si activa esta opción, se exhibirá en el catálogo como <strong>"Solo Exhibición"</strong>.',
                'EN_VENTA': 'Habilita el ejemplar para <strong>venta directa</strong> en el catálogo web con su precio.',
                'VENDIDO': 'Se muestra en el catálogo web como <strong>"Vendido"</strong> durante <strong>10 días</strong> posteriores a la fecha de venta.',
                'MUERTO': 'No se muestra en catálogo a menos que active explícitamente la opción de exhibición (memorial/pedigrí).',
                'INTERCAMBIADO': 'Se muestra en el catálogo durante <strong>10 días</strong> posteriores a la fecha de intercambio solo si la exhibición está habilitada.',
                'PERDIDO': 'No se muestra en el catálogo a menos que habilite explícitamente la opción de exhibición.',
                'DONADO': 'No se muestra en el catálogo a menos que habilite explícitamente la opción de exhibición.',
                'OTRO': 'No se muestra en el catálogo a menos que habilite explícitamente la opción de exhibición.'
            };
            helpText.innerHTML = mensajesAyuda[estado] || 'Permite controlar la exhibición en el catálogo web.';
        }

        const checkboxPub = document.getElementById('publicado_web');
        if (estado === 'EN_VENTA' && checkboxPub && !checkboxPub.checked) {
            checkboxPub.checked = true;
            actualizarBadgePublicacion(true);
        }
    }

    function syncPrecioVendido(val) {
        document.getElementById('precio_venta_en_venta').value = val;
    }

    function actualizarBadgePublicacion(checked) {
        const badge = document.getElementById('publicado-status-badge');
        if (badge) {
            if (checked) {
                badge.className = 'text-xs font-bold px-3 py-1 rounded-full border bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
                badge.innerHTML = '✓ Exhibición Activa';
            } else {
                badge.className = 'text-xs font-bold px-3 py-1 rounded-full border bg-slate-800 text-slate-400 border-slate-700';
                badge.innerHTML = '🔒 No Publicado';
            }
        }
    }

    // 2. Dinamismo de Procedencia
    function toggleProcedenciaCampos() {
        const val = document.getElementById('procedencia').value;
        document.getElementById('campo-proc-yo').classList.add('hidden');
        document.getElementById('campo-proc-compra').classList.add('hidden');
        document.getElementById('campo-proc-otro').classList.add('hidden');

        if (val === 'COMPRA') {
            document.getElementById('campo-proc-compra').classList.remove('hidden');
        } else if (val === 'OTRO') {
            document.getElementById('campo-proc-otro').classList.remove('hidden');
        } else {
            document.getElementById('campo-proc-yo').classList.remove('hidden');
        }
    }

    function syncCriadorOtro(val) {
        document.getElementById('criador_origen_compra').value = val;
    }

    // 3. Mutaciones: toggle select fenotipo/genotipo
    function toggleMutacionItem(id) {
        const chk = document.getElementById('m-' + id);
        const cont = document.getElementById('mut-tipo-' + id);
        if (chk.checked) {
            cont.classList.remove('hidden');
        } else {
            cont.classList.add('hidden');
        }
    }

    // 4. Gestión de Imágenes y previsualización
    function handleFileSelect(index, event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('preview-' + index);
            const placeholder = document.getElementById('placeholder-' + index);
            const btnQuitar = document.getElementById('btn-quitar-' + index);
            const radio = document.getElementById('radio-pred-' + index);

            preview.src = e.target.result;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
            btnQuitar.classList.remove('hidden');

            radio.value = 'nueva_' + index;

            const otherIndex = index === 0 ? 1 : 0;
            const otherRadio = document.getElementById('radio-pred-' + otherIndex);
            if (!otherRadio.checked) {
                radio.checked = true;
            }
        };
        reader.readAsDataURL(file);
    }

    function quitarFoto(index) {
        const input = document.getElementById('input-foto-' + index);
        const preview = document.getElementById('preview-' + index);
        const placeholder = document.getElementById('placeholder-' + index);
        const btnQuitar = document.getElementById('btn-quitar-' + index);
        const conservar = document.getElementById('conservar-' + index);

        input.value = '';
        preview.src = '';
        preview.classList.add('hidden');
        placeholder.classList.remove('hidden');
        btnQuitar.classList.add('hidden');

        if (conservar) {
            conservar.remove();
        }

        const radioThis = document.getElementById('radio-pred-' + index);
        const otherIndex = index === 0 ? 1 : 0;
        const radioOther = document.getElementById('radio-pred-' + otherIndex);
        if (radioThis.checked) {
            radioOther.checked = true;
        }
    }

    // Inicialización al cargar la página
    document.addEventListener('DOMContentLoaded', () => {
        toggleEstadoCampos();
        toggleProcedenciaCampos();
    });
</script>

