<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - AviPeru</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            background-color: #080E1E !important;
            color: #F8FAFC !important;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
        }
    </style>
</head>
<body class="bg-[#080E1E] min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden" style="background-color: #080E1E !important;">
    <!-- Resplandor ambiental de fondo -->
    <div class="absolute w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none -top-20 -left-20"></div>
    <div class="absolute w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none -bottom-20 -right-20"></div>

    <div class="max-w-md w-full space-y-8 bg-[#0C152E]/95 p-8 sm:p-10 rounded-3xl shadow-2xl border border-cyan-500/30 backdrop-blur-xl relative z-10 glow-cyan">
        <div class="text-center space-y-2">
            <a href="/" class="inline-flex items-center gap-2 mb-2">
                <span class="text-3xl">🦜</span>
                <span class="text-2xl font-black text-white font-display tracking-tight">AVIPERU</span>
            </a>
            <h2 class="text-xl font-bold text-white font-display">Acceso a la Plataforma</h2>
            <p class="text-xs text-slate-400">Inicia sesión para gestionar tus reservas y acceder a genealogías</p>
        </div>

        <% if (error) { %>
            <div class="bg-rose-950/60 border border-rose-500/40 p-3.5 rounded-2xl text-xs text-rose-300">
                <%= error %>
            </div>
        <% } %>

        <form class="mt-8 space-y-5" action="/login" method="POST">
            <div class="space-y-4">
                <div>
                    <label for="email" class="block text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-1.5">Correo Electrónico</label>
                    <input id="email" name="email" type="email" required class="block w-full px-4 py-3 bg-[#070D1E] border border-slate-800 rounded-2xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition" placeholder="tu-email@ejemplo.com">
                </div>
                <div>
                    <label for="password" class="block text-[11px] font-bold text-cyan-400 uppercase tracking-wider mb-1.5">Contraseña</label>
                    <input id="password" name="password" type="password" required class="block w-full px-4 py-3 bg-[#070D1E] border border-slate-800 rounded-2xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-400 transition" placeholder="••••••••">
                </div>
            </div>

            <div>
                <button type="submit" class="w-full py-3.5 px-4 rounded-2xl bg-gradient-to-r from-cyan-400 via-teal-400 to-cyan-500 hover:from-cyan-300 hover:to-teal-300 text-slate-950 font-extrabold text-sm uppercase tracking-wider shadow-lg shadow-cyan-500/30 transition transform hover:scale-[1.02]">
                    Iniciar Sesión
                </button>
            </div>
        </form>

        <div class="text-center pt-4 border-t border-slate-800/80 space-y-2">
            <div class="p-3 bg-[#070D1E] rounded-xl border border-slate-800">
                <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Acceso Rápido Administrador:</div>
                <button type="button" onclick="document.getElementById('email').value='admin@lpr.com'; document.getElementById('password').value='admin123';" class="text-xs font-mono font-bold text-cyan-300 hover:text-cyan-200 underline">
                    admin@lpr.com / admin123
                </button>
            </div>
            <p class="text-xs text-slate-400">
                ¿No tienes cuenta? <a href="/register" class="font-bold text-cyan-400 hover:underline">Regístrate gratis</a>
            </p>
            <a href="/" class="inline-block mt-1 text-xs text-slate-500 hover:text-slate-400 transition">&larr; Volver al inicio</a>
        </div>
    </div>
</body>
</html>
