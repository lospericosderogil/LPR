<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Prompt Maestro' %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <nav class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <a href="/" class="text-xl font-bold text-blue-600 tracking-tight">🦜 PROMPT MAESTRO</a>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/catalogo" class="text-sm font-semibold text-gray-700 hover:text-blue-600">Catálogo</a>
                    <% if (user) { %>
                        <a href="/checkout" class="text-sm font-semibold text-gray-700 hover:text-blue-600 flex items-center">
                            <span>🛒 Carrito</span>
                        </a>
                        <span class="text-sm text-gray-500">| Hola, <strong class="text-gray-700"><%= user.nombre %></strong></span>
                        <% if (user.rol === 'ADMIN') { %>
                            <a href="/admin" class="text-sm font-semibold text-gray-700 hover:text-blue-600">Dashboard</a>
                            <a href="/admin/aves" class="text-sm font-semibold text-gray-700 hover:text-blue-600">Aves</a>
                            <a href="/admin/parejas" class="text-sm font-semibold text-gray-700 hover:text-blue-600">Parejas</a>
                        <% } %>
                        <a href="/logout" class="text-sm font-semibold text-red-600 hover:text-red-500">Cerrar Sesión</a>
                    <% } else { %>
                        <a href="/login" class="text-sm font-semibold text-gray-700 hover:text-blue-600">Iniciar Sesión</a>
                        <a href="/register" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-semibold hover:bg-blue-700">Registrarse</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-grow">
