<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'AviPeru' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            950: '#040813',
                            900: '#080E1E',
                            850: '#0B132B',
                            800: '#0C152E',
                            750: '#0E1838',
                            700: '#111C38',
                            600: '#19284F'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            background-color: #080E1E !important;
            color: #F8FAFC !important;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #080E1E !important;
        }
        .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.3) !important;
        }
        .glow-cyan-sm {
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.35) !important;
        }
        .border-glow {
            border-color: rgba(6, 182, 212, 0.4) !important;
        }
        /* Clases CSS nativas para asegurar siempre fondos Deep Navy */
        .bg-navy-main { background-color: #080E1E !important; }
        .bg-navy-card { background-color: #0C152E !important; }
        .bg-navy-nav { background-color: #0B132B !important; }
        .bg-navy-sub { background-color: #070D1E !important; }
    </style>
</head>
<body class="bg-[#080E1E] bg-navy-main text-slate-100 min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-slate-950" style="background-color: #080E1E !important;">
    <nav class="bg-[#0B132B]/95 backdrop-filter backdrop-blur-md border-b border-cyan-900/40 sticky top-0 z-50 transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <!-- Logo & Brand -->
                <div class="flex items-center space-x-3 shrink-0">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-600 via-cyan-500 to-teal-400 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-200">
                            <div class="w-full h-full bg-[#080E1E] rounded-[14px] flex items-center justify-center text-xl">
                                🦜
                            </div>
                        </div>
                        <div>
                            <span class="text-xl font-extrabold tracking-tight text-white font-display flex items-center gap-1.5">
                                AVIPERU
                                <span class="px-1.5 py-0.5 text-[10px] font-black uppercase tracking-widest bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 rounded-md">2026</span>
                            </span>
                            <span class="block text-[11px] text-cyan-400 font-medium tracking-wide">Genética & Crianza de Élite</span>
                        </div>
                    </a>
                </div>

                <!-- Menú Principal Desktop -->
                <div class="hidden lg:flex items-center space-x-1 xl:space-x-2 bg-[#070D1E]/80 px-3 py-1.5 rounded-full border border-slate-800">
                    <!-- 1. Inicio -->
                    <a href="/" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/40 transition flex items-center gap-1.5">
                        <span>🏠</span>
                        <span>Inicio</span>
                    </a>

                    <!-- 2. Catálogo Multi-Rubro -->
                    <a href="/catalogo" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/40 transition flex items-center gap-1.5">
                        <span>🛍️</span>
                        <span>Catálogo</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">Multi-Rubro</span>
                    </a>

                    <!-- 3. Ecosistema Genético -->
                    <a href="/ecosistema-genetico" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/40 transition flex items-center gap-1.5">
                        <span>🧬</span>
                        <span>Ecosistema Genético</span>
                    </a>

                    <!-- 4. Dropdown Bienestar Aviar -->
                    <div class="relative group/dropdown">
                        <button type="button" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/40 transition flex items-center gap-1.5 focus:outline-none">
                            <span>🛡️</span>
                            <span>Bienestar Aviar</span>
                            <svg class="w-3.5 h-3.5 text-slate-400 group-hover/dropdown:text-cyan-300 transition-transform group-hover/dropdown:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        
                        <!-- Panel Desplegable Flotante -->
                        <div class="absolute left-0 mt-2 w-72 rounded-2xl bg-[#0C152E] border border-cyan-500/30 shadow-2xl shadow-black/80 py-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 z-50 backdrop-blur-xl">
                            <div class="px-3.5 py-1.5 text-[10px] font-black tracking-widest text-cyan-400 uppercase border-b border-slate-800/80 mb-1">
                                Pilares de Crianza Responsable
                            </div>
                            <!-- Submenú 1: Introducción & Principios -->
                            <a href="/bienestar" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-cyan-950/50 text-slate-200 hover:text-cyan-300 transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-[#070D1E] border border-slate-800 group-hover/item:border-cyan-500/40">✨</span>
                                <div>
                                    <span class="text-xs font-bold block">Introducción & Principios</span>
                                    <span class="text-[10px] text-slate-400 block">Compromiso ético y guía de adopción</span>
                                </div>
                            </a>
                            <!-- Submenú 2: Salud Preventiva & ADN -->
                            <a href="/salud-preventiva" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-cyan-950/50 text-slate-200 hover:text-cyan-300 transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-[#070D1E] border border-slate-800 group-hover/item:border-cyan-500/40">🧬</span>
                                <div>
                                    <span class="text-xs font-bold block">1. Salud Preventiva & ADN</span>
                                    <span class="text-[10px] text-slate-400 block">PCR, cuarentena y desparasitación</span>
                                </div>
                            </a>
                            <!-- Submenú 3: Cuidado Parental & Respeto -->
                            <a href="/cuidado-parental" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-cyan-950/50 text-slate-200 hover:text-cyan-300 transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-[#070D1E] border border-slate-800 group-hover/item:border-cyan-500/40">🐣</span>
                                <div>
                                    <span class="text-xs font-bold block">2. Cuidado Parental & Respeto</span>
                                    <span class="text-[10px] text-slate-400 block">Destete biológico y voladeras</span>
                                </div>
                            </a>
                            <!-- Submenú 4: Anillado Oficial & Linaje -->
                            <a href="/anillado" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-cyan-950/50 text-slate-200 hover:text-cyan-300 transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-[#070D1E] border border-slate-800 group-hover/item:border-cyan-500/40">🏷️</span>
                                <div>
                                    <span class="text-xs font-bold block">3. Anillado Oficial & Trazabilidad</span>
                                    <span class="text-[10px] text-slate-400 block">Anillado COM (7 a 13 días)</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- 5. Comunidad & Experiencias -->
                    <a href="/experiencias" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-slate-300 hover:text-cyan-300 hover:bg-cyan-950/40 transition flex items-center gap-1.5">
                        <span>💬</span>
                        <span>Comunidad</span>
                    </a>
                </div>
                
                <!-- Acciones Derecha (Carrito / Auth / Admin / Menú Móvil) -->
                <div class="flex items-center space-x-2 sm:space-x-4">
                    <% if (user) { %>
                        <a href="/checkout" class="relative text-xs font-bold text-slate-300 hover:text-cyan-300 transition-colors flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-950/40 border border-cyan-800/40 hover:border-cyan-500/50">
                            <span>🛒</span>
                            <span class="hidden sm:inline">Carrito</span>
                        </a>
                        <span class="text-xs text-slate-400 hidden xl:inline">| Hola, <strong class="text-cyan-300"><%= user.nombre %></strong></span>
                        <% if (user.rol === 'ADMIN') { %>
                            <a href="/admin" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-blue-600/20 text-blue-300 border border-blue-500/30 hover:bg-blue-600/30 transition">Panel Admin</a>
                        <% } %>
                        <a href="/logout" class="text-xs font-semibold text-rose-400 hover:text-rose-300 transition">Salir</a>
                    <% } else { %>
                        <a href="/login" class="text-xs sm:text-sm font-semibold text-slate-300 hover:text-cyan-400 transition-colors px-2 py-1">Ingresar</a>
                        <a href="/register" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-extrabold text-slate-950 bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 shadow-md shadow-cyan-500/20 transition duration-200">
                            Registrarse
                        </a>
                    <% } %>

                    <!-- Botón Hamburguesa Móvil -->
                    <button type="button" onclick="document.getElementById('mobile-nav').classList.toggle('hidden')" class="lg:hidden p-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Menú Móvil Desplegable -->
            <div id="mobile-nav" class="hidden lg:hidden border-t border-slate-800/80 py-4 space-y-2">
                <a href="/" class="block px-3 py-2 rounded-xl text-sm font-bold text-slate-200 hover:bg-cyan-950/40 hover:text-cyan-300 transition">
                    🏠 Inicio
                </a>
                <a href="/catalogo" class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-bold text-slate-200 hover:bg-cyan-950/40 hover:text-cyan-300 transition">
                    <span>🛍️ Catálogo Comercial</span>
                    <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-cyan-500/20 text-cyan-300 border border-cyan-400/30">Multi-Rubro</span>
                </a>
                <a href="/ecosistema-genetico" class="block px-3 py-2 rounded-xl text-sm font-bold text-slate-200 hover:bg-cyan-950/40 hover:text-cyan-300 transition">
                    🧬 Ecosistema Genético 2026
                </a>
                
                <div class="pt-2 pb-1 border-t border-slate-800/60">
                    <span class="block px-3 text-[10px] font-black tracking-widest text-cyan-400 uppercase mb-1">Bienestar Aviar</span>
                    <a href="/bienestar" class="block px-4 py-1.5 text-xs text-slate-300 hover:text-cyan-300">✨ Introducción & Principios</a>
                    <a href="/salud-preventiva" class="block px-4 py-1.5 text-xs text-slate-300 hover:text-cyan-300">🧬 1. Salud Preventiva & ADN</a>
                    <a href="/cuidado-parental" class="block px-4 py-1.5 text-xs text-slate-300 hover:text-cyan-300">🐣 2. Cuidado Parental & Respeto</a>
                    <a href="/anillado" class="block px-4 py-1.5 text-xs text-slate-300 hover:text-cyan-300">🏷️ 3. Anillado Oficial & Trazabilidad</a>
                </div>

                <a href="/experiencias" class="block px-3 py-2 rounded-xl text-sm font-bold text-slate-200 hover:bg-cyan-950/40 hover:text-cyan-300 transition border-t border-slate-800/60">
                    💬 Comunidad & Experiencias Reales
                </a>
            </div>
        </div>
    </nav>
    <main class="flex-grow">
