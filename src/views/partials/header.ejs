<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'AviPeru' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        royal: {
                            50: '#EEF2FF',
                            100: '#E0E7FF',
                            200: '#C7D2FE',
                            300: '#A5B4FC',
                            400: '#818CF8',
                            500: '#3B82F6',
                            600: '#0B43E0',
                            700: '#0630B8', // Base seleccionada
                            800: '#042387',
                            900: '#031759',
                            950: '#020D38'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            background-color: #F8FAFC !important;
            color: #0F172A !important;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F8FAFC !important;
        }
        .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }
        .bg-royal-main { background-color: #0630B8 !important; }
        .text-royal-main { color: #0630B8 !important; }
        .border-royal-main { border-color: #0630B8 !important; }
        .bg-royal-gradient {
            background: linear-gradient(135deg, #0B43E0 0%, #0630B8 50%, #042387 100%) !important;
        }
        .bg-royal-light { background-color: #EEF2FF !important; }
        .shadow-royal {
            box-shadow: 0 4px 14px 0 rgba(6, 48, 184, 0.25) !important;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] text-slate-900 min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white" style="background-color: #F8FAFC !important;">
    <!-- Barra Superior Corporativa Ripley Retail en Azul Rey #0630B8 -->
    <nav class="bg-[#0630B8] text-white shadow-md sticky top-0 z-50 transition-all duration-200" style="background-color: #0630B8 !important;">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center gap-4">
                <!-- Logo & Brand -->
                <div class="flex items-center space-x-3 shrink-0">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-11 h-11 rounded-2xl bg-white/15 p-0.5 shadow-md group-hover:scale-105 transition-transform duration-200 border border-white/20">
                            <div class="w-full h-full bg-[#042387] rounded-[14px] flex items-center justify-center text-xl">
                                🦜
                            </div>
                        </div>
                        <div>
                            <span class="text-xl font-extrabold tracking-tight text-white font-display flex items-center gap-1.5">
                                AVIPERU
                                <span class="px-1.5 py-0.5 text-[10px] font-black uppercase tracking-widest bg-white/20 text-white border border-white/30 rounded-md">2026</span>
                            </span>
                            <span class="block text-[11px] text-blue-100 font-medium tracking-wide">Genética & Crianza de Élite</span>
                        </div>
                    </a>
                </div>

                <!-- Menú Principal Desktop -->
                <div class="hidden lg:flex items-center space-x-1 xl:space-x-1.5 bg-[#042387]/60 px-3 py-1.5 rounded-full border border-white/10">
                    <!-- 1. Inicio -->
                    <a href="/" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-white/90 hover:text-white hover:bg-white/15 transition flex items-center gap-1.5">
                        <span>🏠</span>
                        <span>Inicio</span>
                    </a>

                    <!-- 2. Catálogo Multi-Rubro -->
                    <a href="/catalogo" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-white/90 hover:text-white hover:bg-white/15 transition flex items-center gap-1.5">
                        <span>🛍️</span>
                        <span>Catálogo</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-white/20 text-white border border-white/30">Multi-Rubro</span>
                    </a>

                    <!-- 3. Ecosistema Genético -->
                    <a href="/ecosistema-genetico" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-white/90 hover:text-white hover:bg-white/15 transition flex items-center gap-1.5">
                        <span>🧬</span>
                        <span>Ecosistema Genético</span>
                    </a>

                    <!-- 4. Dropdown Bienestar Aviar -->
                    <div class="relative group/dropdown">
                        <button type="button" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-white/90 hover:text-white hover:bg-white/15 transition flex items-center gap-1.5 focus:outline-none">
                            <span>🛡️</span>
                            <span>Bienestar Aviar</span>
                            <svg class="w-3.5 h-3.5 text-blue-200 group-hover/dropdown:text-white transition-transform group-hover/dropdown:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        
                        <!-- Panel Desplegable Flotante (Light Retail Card) -->
                        <div class="absolute left-0 mt-2 w-72 rounded-2xl bg-white border border-slate-200 shadow-2xl py-2.5 opacity-0 invisible group-hover/dropdown:opacity-100 group-hover/dropdown:visible transition-all duration-200 z-50 text-slate-800">
                            <div class="px-3.5 py-1.5 text-[10px] font-black tracking-widest text-[#0630B8] uppercase border-b border-slate-100 mb-1">
                                Pilares de Crianza Responsable
                            </div>
                            <!-- Submenú 1: Introducción & Principios -->
                            <a href="/bienestar" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-blue-50 text-slate-700 hover:text-[#0630B8] transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-slate-50 border border-slate-200 group-hover/item:border-blue-300">✨</span>
                                <div>
                                    <span class="text-xs font-bold block text-slate-800">Introducción & Principios</span>
                                    <span class="text-[10px] text-slate-500 block">Compromiso ético y guía de adopción</span>
                                </div>
                            </a>
                            <!-- Submenú 2: Salud Preventiva & ADN -->
                            <a href="/salud-preventiva" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-blue-50 text-slate-700 hover:text-[#0630B8] transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-slate-50 border border-slate-200 group-hover/item:border-blue-300">🧬</span>
                                <div>
                                    <span class="text-xs font-bold block text-slate-800">1. Salud Preventiva & ADN</span>
                                    <span class="text-[10px] text-slate-500 block">PCR, cuarentena y desparasitación</span>
                                </div>
                            </a>
                            <!-- Submenú 3: Cuidado Parental & Respeto -->
                            <a href="/cuidado-parental" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-blue-50 text-slate-700 hover:text-[#0630B8] transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-slate-50 border border-slate-200 group-hover/item:border-blue-300">🐣</span>
                                <div>
                                    <span class="text-xs font-bold block text-slate-800">2. Cuidado Parental & Respeto</span>
                                    <span class="text-[10px] text-slate-500 block">Destete biológico y voladeras</span>
                                </div>
                            </a>
                            <!-- Submenú 4: Anillado Oficial & Linaje -->
                            <a href="/anillado" class="flex items-center gap-3 px-3.5 py-2.5 hover:bg-blue-50 text-slate-700 hover:text-[#0630B8] transition group/item">
                                <span class="text-base p-1.5 rounded-lg bg-slate-50 border border-slate-200 group-hover/item:border-blue-300">🏷️</span>
                                <div>
                                    <span class="text-xs font-bold block text-slate-800">3. Anillado Oficial & Trazabilidad</span>
                                    <span class="text-[10px] text-slate-500 block">Anillado COM (7 a 13 días)</span>
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- 5. Comunidad & Experiencias -->
                    <a href="/experiencias" class="px-3.5 py-1.5 rounded-full text-xs font-bold text-white/90 hover:text-white hover:bg-white/15 transition flex items-center gap-1.5">
                        <span>💬</span>
                        <span>Comunidad</span>
                    </a>
                </div>
                
                <!-- Acciones Derecha (Carrito / Auth / Admin / Menú Móvil) -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <% if (user) { %>
                        <a href="/carrito" class="relative text-xs font-bold text-white hover:bg-white/20 transition-colors flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/15 border border-white/20">
                            <span>🛒</span>
                            <span class="hidden sm:inline">Carrito</span>
                        </a>
                        <span class="text-xs text-blue-100 hidden xl:inline">| Hola, <strong class="text-white"><%= user.nombre %></strong></span>
                        <% if (user.rol === 'ADMIN') { %>
                            <a href="/admin" class="text-xs font-bold px-2.5 py-1 rounded-lg bg-amber-400 text-slate-950 hover:bg-amber-300 transition shadow-sm">Panel Admin</a>
                        <% } %>
                        <a href="/logout" class="text-xs font-semibold text-rose-200 hover:text-white transition">Salir</a>
                    <% } else { %>
                        <a href="/carrito" class="relative text-xs font-bold text-white hover:bg-white/20 transition-colors flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/15 border border-white/20">
                            <span>🛒</span>
                            <span class="hidden sm:inline">Carrito</span>
                        </a>
                        <a href="/login" class="text-xs sm:text-sm font-semibold text-white/90 hover:text-white transition-colors px-2 py-1">Ingresar</a>
                        <a href="/register" class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-extrabold text-[#0630B8] bg-white hover:bg-blue-50 shadow-md transition duration-200">
                            Registrarse
                        </a>
                    <% } %>

                    <!-- Botón Hamburguesa Móvil -->
                    <button type="button" onclick="document.getElementById('mobile-nav').classList.toggle('hidden')" class="lg:hidden p-2 rounded-xl bg-white/15 border border-white/20 text-white hover:bg-white/25 focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Menú Móvil Desplegable -->
            <div id="mobile-nav" class="hidden lg:hidden border-t border-white/20 py-4 space-y-2 bg-[#042387] px-4 rounded-b-2xl">
                <a href="/" class="block px-3 py-2 rounded-xl text-sm font-bold text-white hover:bg-white/15 transition">
                    🏠 Inicio
                </a>
                <a href="/catalogo" class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-bold text-white hover:bg-white/15 transition">
                    <span>🛍️ Catálogo Comercial</span>
                    <span class="px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-white/20 text-white border border-white/30">Multi-Rubro</span>
                </a>
                <a href="/ecosistema-genetico" class="block px-3 py-2 rounded-xl text-sm font-bold text-white hover:bg-white/15 transition">
                    🧬 Ecosistema Genético 2026
                </a>
                
                <div class="pt-2 pb-1 border-t border-white/20">
                    <span class="block px-3 text-[10px] font-black tracking-widest text-blue-200 uppercase mb-1">Bienestar Aviar</span>
                    <a href="/bienestar" class="block px-4 py-1.5 text-xs text-white/90 hover:text-white">✨ Introducción & Principios</a>
                    <a href="/salud-preventiva" class="block px-4 py-1.5 text-xs text-white/90 hover:text-white">🧬 1. Salud Preventiva & ADN</a>
                    <a href="/cuidado-parental" class="block px-4 py-1.5 text-xs text-white/90 hover:text-white">🐣 2. Cuidado Parental & Respeto</a>
                    <a href="/anillado" class="block px-4 py-1.5 text-xs text-white/90 hover:text-white">🏷️ 3. Anillado Oficial & Trazabilidad</a>
                </div>

                <a href="/experiencias" class="block px-3 py-2 rounded-xl text-sm font-bold text-white hover:bg-white/15 transition border-t border-white/20">
                    💬 Comunidad & Experiencias Reales
                </a>
            </div>
        </div>
    </nav>
    <main class="flex-grow">

