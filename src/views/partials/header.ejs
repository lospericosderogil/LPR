<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'AviPeru' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            950: '#040813',
                            900: '#080E1E',
                            850: '#0B132B',
                            800: '#0C152E',
                            750: '#0E1838',
                            700: '#111C38',
                            600: '#19284F'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body {
            background-color: #080E1E !important;
            color: #F8FAFC !important;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #080E1E !important;
        }
        .font-display {
            font-family: 'Space Grotesk', sans-serif;
        }
        .glow-cyan {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.3) !important;
        }
        .glow-cyan-sm {
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.35) !important;
        }
        .border-glow {
            border-color: rgba(6, 182, 212, 0.4) !important;
        }
        /* Clases CSS nativas para asegurar siempre fondos Deep Navy */
        .bg-navy-main { background-color: #080E1E !important; }
        .bg-navy-card { background-color: #0C152E !important; }
        .bg-navy-nav { background-color: #0B132B !important; }
        .bg-navy-sub { background-color: #070D1E !important; }
    </style>
</head>
<body class="bg-[#080E1E] bg-navy-main text-slate-100 min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-slate-950" style="background-color: #080E1E !important;">
    <nav class="bg-[#0B132B]/95 backdrop-filter backdrop-blur-md border-b border-cyan-900/40 sticky top-0 z-50 transition-all duration-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex items-center space-x-3">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-600 via-cyan-500 to-teal-400 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform duration-200">
                            <div class="w-full h-full bg-[#080E1E] rounded-[14px] flex items-center justify-center text-xl">
                                🦜
                            </div>
                        </div>
                        <div>
                            <span class="text-xl font-extrabold tracking-tight text-white font-display flex items-center gap-1.5">
                                AVIPERU
                                <span class="px-1.5 py-0.5 text-[10px] font-black uppercase tracking-widest bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 rounded-md">2026</span>
                            </span>
                            <span class="block text-[11px] text-cyan-400 font-medium tracking-wide">Genética & Crianza de Élite</span>
                        </div>
                    </a>
                </div>
                
                <div class="flex items-center space-x-3 sm:space-x-6">
                    <a href="/catalogo" class="text-sm font-semibold text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                        Catálogo
                    </a>
                    
                    <% if (user) { %>
                        <a href="/checkout" class="relative text-sm font-semibold text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-2 px-3 py-1.5 rounded-xl bg-cyan-950/40 border border-cyan-800/40 hover:border-cyan-500/50">
                            <span>🛒 Carrito</span>
                        </a>
                        <span class="text-xs text-slate-400 hidden md:inline">| Hola, <strong class="text-cyan-300"><%= user.nombre %></strong></span>
                        <% if (user.rol === 'ADMIN') { %>
                            <a href="/admin" class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-blue-600/20 text-blue-300 border border-blue-500/30 hover:bg-blue-600/30 transition">Panel Admin</a>
                        <% } %>
                        <a href="/logout" class="text-xs font-semibold text-rose-400 hover:text-rose-300 transition">Salir</a>
                    <% } else { %>
                        <a href="/login" class="text-sm font-semibold text-slate-300 hover:text-cyan-400 transition-colors">Ingresar</a>
                        <a href="/register" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-950 bg-gradient-to-r from-cyan-400 to-teal-400 hover:from-cyan-300 hover:to-teal-300 shadow-md shadow-cyan-500/20 transition duration-200 transform hover:-translate-y-0.5">
                            Registrarse
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
    <main class="flex-grow">
